---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const entry = await getEntry("pages", "error404");
if (!entry) throw new Error("Missing 404 copy");
const { Content } = await render(entry);
---

<Base title="Page not found | DoGood Founders" description={entry.data.description}>
  <article class="page">
    <div class="page-wrap page-body">
      <Content />
    </div>
  </article>
</Base>
