---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const entry = await getEntry("pages", "error404");
if (!entry) throw new Error("Missing 404 copy");
const { Content } = await render(entry);
---

<Base title="Page not found | DoGood Agency" description="That page is not here. Head home, or send us a note.">
  <article class="page page-art page-404">
    <div class="page-wrap page-body">
      <Content />
    </div>
  </article>
</Base>
