<script>
  // Count-up for the track record, same as the homepage.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const group = document.querySelector("[data-count-group]");
    const counters = Array.from(document.querySelectorAll<HTMLElement>("[data-count]")).filter((el) => el.dataset.count);
    const format = (el: HTMLElement, value: number) => {
      const decimals = Number(el.dataset.decimals ?? "0");
      const shown = decimals ? value.toFixed(decimals) : Math.round(value).toLocaleString("en-US");
      el.textContent = `${el.dataset.prefix ?? ""}${shown}${el.dataset.suffix ?? ""}`;
    };
    if (group && counters.length) {
      let started = false;
      const observer = new IntersectionObserver(
        (entries) => {
          if (started || !entries.some((e) => e.isIntersecting)) return;
          started = true;
          observer.disconnect();
          counters.forEach((el) => {
            const target = Number(el.dataset.count);
            const begin = performance.now();
            const tick = (now: number) => {
              const p = Math.min(1, (now - begin) / 1800);
              format(el, target * (1 - (1 - p) ** 3));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.35 },
      );
      observer.observe(group);
    }
  }
</script>
