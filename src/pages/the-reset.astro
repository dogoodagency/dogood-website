---
import "../styles/how-it-works.css";
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
import { edgeAbove } from "../data/edge-line";
import { stats, reviews } from "../data/homepage";
import { wayfinders } from "../data/wayfinders";
import {
  houses,
  arrowSrc,
  stage1Includes,
  stage2Includes,
  supports,
  fitSignals,
  notFor,
  hubs,
  steps,
  reviewFiles,
} from "../data/how-it-works";

const wfFor = (name: string) => {
  const found = wayfinders.find((w) => w.name === name);
  if (!found) throw new Error(`No Wayfinder named ${name}`);
  return found;
};

const tint = "#F5F2FF";
const white = "#ffffff";
const heroEdge = edgeAbove("#2A0B4F");
const bandEdge = edgeAbove(tint);
const footerEdge = edgeAbove(tint);

/** Wavy join between two bands: `from` is the band above, `to` the band below. */
function wave(from: string, to: string) {
  const above = from === tint ? "tint" : "white";
  return `<div class="hw-divider hw-divider--${above}" aria-hidden="true"><svg style="--wave-edge:${bandEdge}" viewBox="0 0 1440 80" preserveAspectRatio="none"><path fill="${to}" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16v48H0Z"></path><path class="wave-edge" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16"></path></svg></div>`;
}
const toTint = wave(white, tint);
const toWhite = wave(tint, white);

function clipQuote(quote: string) {
  const clean = quote.replace(/\s+/g, " ").trim();
  const limit = 260;
  if (clean.length <= limit) return clean;
  const cut = clean.slice(0, limit).replace(/\s+\S*$/, "").replace(/[.…,\s]+$/, "");
  return `${cut}…`;
}

const shown = reviewFiles
  .map((file) => reviews.find((review) => review.file === file))
  .filter((review): review is (typeof reviews)[number] => Boolean(review));

const familiar = [
  "Nowhere, because there is no clarity.",
  "This company and this lifestyle is all I've ever known.",
];

const [houseBefore, houseStage1, houseStage2] = houses;
---

<Base
  title="The Reset + The Build | Founder Reclamation Partnership, start with Stage 1 (30 days)"
  description="A private 2-stage partnership for founders after exit. Start with Stage 1: The Reset (30 days). Stage 2 is invite-only. Limited to 5 new founders a month."
  canonical="https://www.dogoodagency.co/the-reset"
  footerStrip={tint}
  footerEdge={footerEdge}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: "Founder Reclamation Partnership: Stage 1 The Reset",
      url: "https://www.dogoodagency.co/the-reset",
      description: "A private 1:1 engagement for founders after exit. Stage 1, The Reset, runs for 30 days; Stage 2, The Build, is by invitation.",
      serviceType: "1:1 founder coaching",
      provider: { "@id": "https://www.dogoodagency.co/#organization" },
      audience: { "@type": "Audience", audienceType: "Founders before or after an exit" },
      areaServed: "Worldwide",
      additionalProperty: { "@type": "PropertyValue", name: "Duration", value: "30 days (Stage 1); 12 weeks (Stage 2, by invitation)" },
    })} />
  <article class="hw-page">
    <!-- 1. Hero -->
    <header class="hw-hero">
      <div class="hw-hero-inner">
        <p class="hw-eyebrow">The Reset + The Build</p>
        <h1>Founder Reclamation Partnership</h1>
        <p class="hw-kicker">The FRP is a 2-stage process</p>
        <p class="hw-hero-lede">A private, staged partnership for founders after exit who want to decide what this next chapter is actually for.</p>
        <p class="hw-hero-sub">You apply for Stage 1 only. Stage 2 is invite-only.</p>

        <div class="hw-stages">
          <div class="hw-stage-card">
            <p class="hw-stage-n">Stage 1</p>
            <h2>The Reset (30 days)</h2>
            <p class="hw-stage-line">get clear · set new values · shift patterns</p>
            <p class="hw-stage-via">via ClarityValue Shift™</p>
          </div>
          <span class="hw-stage-arrow" aria-hidden="true">→</span>
          <div class="hw-stage-card">
            <p class="hw-stage-n">Stage 2</p>
            <h2>The Build (12 weeks)</h2>
            <p class="hw-stage-line">rework life · go deeper · realign what matters</p>
            <p class="hw-stage-via">via NextLife Passage™</p>
          </div>
        </div>

        <p class="hw-flow"><strong>How it works:</strong> Apply → Conversation → Start Stage 1</p>

        <div class="hw-actions">
          <a class="btn-teal" href="/the-reset#anchor-1">See the full process</a>
          <a class="btn-apply" href="/apply-stage-1">Apply for Stage 1</a>
        </div>
        <p class="hw-limited">Limited to five new founders a month</p>
        <p class="hw-expedite">We protect our delivery quality: Ask about Expedited Start if urgent (FRP can begin within 7 days)</p>
      </div>
      <Wave fill={tint} edge={heroEdge} />
    </header>

    <!-- 1b. Sound familiar? (Seb, Nov 17) -->
    <section class="hw-band hw-band-tint" aria-labelledby="hw-familiar">
      <div class="hw-well hw-well-slim">
        <h2 id="hw-familiar">Sound familiar?</h2>
        <div class="hw-quotes">
          {
            familiar.map((quote) => (
              <figure class="hw-qcard">
                <blockquote>
                  <p>{quote}</p>
                </blockquote>
                <figcaption>Founder</figcaption>
              </figure>
            ))
          }
        </div>
        <p class="hw-notyet">Not there yet? <a href="/exit-prep">Exit-Prep</a> is for founders before the sale.</p>
      </div>
    </section>

    <Fragment set:html={toWhite} />

    <!-- 2. Cost + What is FRP -->
    <section class="hw-band" aria-labelledby="hw-cost">
      <div class="hw-well hw-prose">
        <h2 id="hw-cost">The success is real. But so is the cost.</h2>
        <p>You thought stepping away would feel like arrival. Instead, you have more freedom but feel less settled than expected.</p>
        <p>The company gave your days structure, urgency, and a place to put your energy. Without it, the question is how you want to live now, and what you do not want to recreate.</p>
        <p>Your sleep. Your health. Your family. The parts of life that were easier to put off while the company needed you.</p>
        <p>You may have tried routines, travel, or the next project. But before you fill the space with another version of the life you left behind, it is worth getting clear on what genuinely belongs next.</p>

        <h2 id="hw-what" class="hw-h2-spaced">What is FRP?</h2>
        <p>It is a structured two-stage partnership designed for one outcome:</p>
        <p class="hw-pull">Helping you make life after exit a deliberate choice, not another version of the life you left behind.</p>
        <p>The work happens in stages because you do not need to rebuild everything at once.</p>
        <p>First, we reset what has become misaligned: the patterns, values, and daily structure that no longer support the life you want to live. Then, once the essential parts are working again, we build the larger life around what genuinely comes next for you. Think of it like a house.</p>
      </div>
    </section>

    <Fragment set:html={toTint} />

    <!-- 4. House 1 + Stage 1 -->
    <section class="hw-band hw-band-tint" aria-labelledby="hw-stage1">
      <div class="hw-well">
        <div class="hw-house-wrap">
          <p class="hw-eyebrow">{houseBefore.eyebrow}</p>
          <h3 class="hw-house-title">{houseBefore.title}</h3>
          <figure class={`hw-house hw-house--${houseBefore.id}`}>
            <div class="hw-house-box" style={`--ar:${houseBefore.width}/${houseBefore.height}`}>
              <img
                class="hw-house-img"
                src={houseBefore.src1100}
                srcset={`${houseBefore.src640} 640w, ${houseBefore.src1100} 1100w`}
                sizes="(max-width: 759px) min(100vw, 420px), 560px"
                width={houseBefore.width}
                height={houseBefore.height}
                alt={houseBefore.alt}
                loading="lazy"
                decoding="async"
              />
              {houseBefore.arrows.map((a) => (
                <img class="hw-arrow" src={arrowSrc} width="400" height="179" alt="" aria-hidden="true" loading="lazy" decoding="async" style={`--cx:${a.cx}%;--cy:${a.cy}%;--w:${a.w}%;--rot:${a.rot}deg;--flip:${a.flip}`} />
              ))}
              {houseBefore.labels.map((l) => (
                <p class="hw-label" style={`--x:${l.x}%;--y:${l.y}%;--lw:${l.w}%`}>{l.text}</p>
              ))}
            </div>
          </figure>
        </div>

        <div class="hw-prose hw-stage-block">
          <h2 id="hw-stage1"><span class="hw-pink">Stage 1</span> The Reset <span class="hw-days">(30 days)</span></h2>
          <p class="hw-tagline">Get Clear · Set New Values · Shift Patterns</p>
          <p class="hw-via">via ClarityValue Shift™</p>
          <p class="hw-flow"><strong>How it works:</strong> See → Interrupt → Choose → Reset</p>
          <p>
            <a class="btn-teal" href="https://drive.google.com/file/d/1g6WwAU8fWcpbNIBKPgNZ382CbirxX4o4/view?usp=drive_link" target="_blank" rel="noopener">ClarityValue Shift™ (1‑page)</a>
          </p>
          <p>Stage 1 is a focused reset around self, patterns, values, and immediate structure.</p>
          <p>We make space for what often surfaces after exit: restlessness, loss of structure, neglected health or relationships, and the growing sense that the old way of operating no longer fits this chapter.</p>
          <p>We interrupt the patterns shaping this chapter, clarify what is aligned for you now, and help you see what is driving your decisions, energy, and behaviour so you can begin moving toward the version of yourself that actually belongs next.</p>
          <p>By day 30, you are not just clearer. You have started to reset how you live: what you pay attention to, what no longer runs your life, and what needs to change.</p>
          <p>Important: Stage 1 is focused work. We usually address 1-2 major areas, rather than trying to change everything at once.</p>
          <p>By week 3, we will know one of two things:</p>
          <ul class="hw-plain">
            <li>(1) Stage 1 gave you what you needed,</li>
            <li>(2) There is a fit for Stage 2, and we continue.</li>
          </ul>
          <h3 class="hw-list-title">You will leave Stage 1 with:</h3>
          <ul class="hw-includes">
            {stage1Includes.map((item) => (
              <li>
                <strong>{item.title}</strong> (<span set:html={item.detail} />)
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <Fragment set:html={toWhite} />

    <!-- 5. House 2 + Stage 2 -->
    <section class="hw-band" aria-labelledby="hw-stage2">
      <div class="hw-well">
        <div class="hw-house-wrap">
          <p class="hw-eyebrow">{houseStage1.eyebrow}</p>
          <h3 class="hw-house-title">{houseStage1.title}</h3>
          <figure class={`hw-house hw-house--${houseStage1.id}`}>
            <div class="hw-house-box" style={`--ar:${houseStage1.width}/${houseStage1.height}`}>
              <img
                class="hw-house-img"
                src={houseStage1.src1100}
                srcset={`${houseStage1.src640} 640w, ${houseStage1.src1100} 1100w`}
                sizes="(max-width: 759px) min(100vw, 420px), 560px"
                width={houseStage1.width}
                height={houseStage1.height}
                alt={houseStage1.alt}
                loading="lazy"
                decoding="async"
              />
              {houseStage1.arrows.map((a) => (
                <img class="hw-arrow" src={arrowSrc} width="400" height="179" alt="" aria-hidden="true" loading="lazy" decoding="async" style={`--cx:${a.cx}%;--cy:${a.cy}%;--w:${a.w}%;--rot:${a.rot}deg;--flip:${a.flip}`} />
              ))}
              {houseStage1.labels.map((l) => (
                <p class="hw-label" style={`--x:${l.x}%;--y:${l.y}%;--lw:${l.w}%`}>{l.text}</p>
              ))}
            </div>
          </figure>
        </div>

        <div class="hw-prose hw-stage-block">
          <h2 id="hw-stage2"><span class="hw-pink">Stage 2</span> The Build <span class="hw-days">(12 weeks)</span></h2>
          <p class="hw-tagline">Rework Life · Go Deeper · Realign What Matters</p>
          <p class="hw-via">via NextLife Passage™</p>
          <p class="hw-flow"><strong>How it works:</strong> Rework → Navigate → Realign → Integrate</p>
          <p>
            <a class="btn-teal" href="https://drive.google.com/file/d/12qR6tjfv196rJ0Q32ltmUiHbGLVctyhh/view?usp=sharing" target="_blank" rel="noopener">NextLife Passage™ (1‑page)</a>
          </p>
          <p>Stage 1 resets what is misaligned. Stage 2 then naturally builds on what truly belongs next.</p>
          <p>This is a wider build around real life, deeper decisions, and long-term alignment. We take the shift from Stage 1 and reorganise life around it, so the work becomes part of how you live practically.</p>
          <p>That means looking more closely at the foundations of your life and rebuilding them in a way that fits who you are now.</p>
          <p>We work through the deeper aspects to make practical changes to the areas that are the heaviest:</p>
          <p>how your time is structured, how your health is being supported, how you show up in key relationships, what your next chapter is really for, and what no longer belongs in your way of living.</p>
          <p>This is where new decisions start integrating visibly in your daily life, long-term. What mattered in the company stops dictating what matters now.</p>
          <p>Stage 2 is where identity, relationships, health, and direction start moving in sync. The founder’s new version is not just fully understood, but properly integrated into how you live your life.</p>
          <h3 class="hw-list-title">You will leave Stage 2 with:</h3>
          <ul class="hw-includes">
            {stage2Includes.map((item) => (
              <li>
                <strong>{item.title}</strong> ({item.detail})
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <Fragment set:html={toTint} />

    <!-- 6. House 3 + supports + retreat -->
    <section class="hw-band hw-band-tint" aria-labelledby="hw-supports">
      <div class="hw-well">
        <div class="hw-house-wrap">
          <p class="hw-eyebrow">{houseStage2.eyebrow}</p>
          <h3 class="hw-house-title">{houseStage2.title}</h3>
          <p class="hw-badge">{houseStage2.badge}</p>
          <figure class={`hw-house hw-house--${houseStage2.id}`}>
            <div class="hw-house-box" style={`--ar:${houseStage2.width}/${houseStage2.height}`}>
              <img
                class="hw-house-img"
                src={houseStage2.src1100}
                srcset={`${houseStage2.src640} 640w, ${houseStage2.src1100} 1100w`}
                sizes="(max-width: 759px) min(100vw, 420px), 560px"
                width={houseStage2.width}
                height={houseStage2.height}
                alt={houseStage2.alt}
                loading="lazy"
                decoding="async"
              />
              {houseStage2.arrows.map((a) => (
                <img class="hw-arrow" src={arrowSrc} width="400" height="179" alt="" aria-hidden="true" loading="lazy" decoding="async" style={`--cx:${a.cx}%;--cy:${a.cy}%;--w:${a.w}%;--rot:${a.rot}deg;--flip:${a.flip}`} />
              ))}
              {houseStage2.labels.map((l) => (
                <p class="hw-label" style={`--x:${l.x}%;--y:${l.y}%;--lw:${l.w}%`}>{l.text}</p>
              ))}
            </div>
          </figure>
        </div>

        <div class="hw-prose">
          <h2 id="hw-supports">These supports remain consistent throughout both FRP stages:</h2>
          <ul class="hw-includes">
            {supports.map((item) => (
              <li>
                <strong>{item.title}</strong> ({item.detail})
              </li>
            ))}
          </ul>

          <div class="hw-retreat">
            <h3>FRP Signature Retreat</h3>
            <p class="hw-retreat-note">This is not a service inclusion, and it's not guaranteed</p>
            <p>Our annual, in-person retreat with a small group of founders, built for connection, perspective, and real conversations. For clients who’ve been with us 6+ months and are in excellent standing.</p>
            <p>Each year, we invite up to 10 founders who’ve made the most meaningful progress and applied themselves fully. If invited, hotel, meals, and activities are included (flights are not).</p>
          </div>
        </div>
      </div>
    </section>

    <Fragment set:html={toWhite} />

    <!-- 8. Who this is for -->
    <section class="hw-band" aria-labelledby="hw-who">
      <div class="hw-well">
        <div class="hw-prose">
          <h2 id="hw-who">Who This Is For</h2>
          <p class="hw-eyebrow hw-eyebrow-left">Founders: Post-Exit</p>
          <p>This is for founders who have exited or meaningfully stepped away from the company and are no longer responsible for the day-to-day.</p>
          <p>You may still have a board or advisory role, but you now have more time, more freedom, and more space than you have had in years.</p>
          <p>What you did not expect was how uncomfortable that space might feel. But you do not simply want to fill it with another company or project.</p>
          <p>You want to understand what is driving the next move and deliberately choose how you want to live beyond the business.</p>
        </div>

        <aside class="hw-case" aria-label="Case study">
          <p class="hw-eyebrow hw-eyebrow-left">Case Study</p>
          <h3>From identity void to decisive leadership — how V reclaimed life after success</h3>
          <p class="hw-case-who">V (anonymous), USD 9M+ founder</p>
          <a class="btn-teal" href="/casestudies/v">Read the short case study</a>
          <p class="hw-case-note">We protect our founders’ identities</p>
        </aside>

        <div class="hw-fit">
          <section class="hw-fit-card hw-fit-yes" aria-labelledby="hw-signals">
            <h3 id="hw-signals">Key signals you’re a fit:</h3>
            <ul class="hw-ticks">
              {fitSignals.map((text) => (
                <li>
                  <span class="hw-icon hw-icon-yes" aria-hidden="true">✓</span>
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </section>
          <section class="hw-fit-card hw-fit-no" aria-labelledby="hw-notfor">
            <h3 id="hw-notfor">This is NOT for founders who:</h3>
            <ul class="hw-ticks">
              {notFor.map((text) => (
                <li>
                  <span class="hw-icon hw-icon-no" aria-hidden="true">✗</span>
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </section>

    <Fragment set:html={toTint} />

    <!-- 9. What this partnership is not + case J -->
    <section class="hw-band hw-band-tint" aria-labelledby="hw-not">
      <div class="hw-well">
        <div class="hw-prose">
          <h2 id="hw-not">What This Partnership Is Not</h2>
          <p>This is not executive coaching. Not therapy. Not a mastermind, a retreat, or a course.</p>
          <p>There are no frameworks to memorize, and no random accountability pods.</p>
          <p>FRP is private, direct, intensive work. It requires protected time and brutal honesty.</p>
          <p>In exchange, we remove the confusion, compress the timeline to clarity, and reduce the effort of 'figuring it out alone' — designed for founders who've outgrown surface-level interventions.</p>
          <p class="hw-pull">Private work. Real consequences. Real change.</p>
        </div>

        <aside class="hw-case" aria-label="Case study">
          <p class="hw-eyebrow hw-eyebrow-left">Case Study</p>
          <h3>From exit anxiety to aligned legacy —How J created a clear next life chapter</h3>
          <p class="hw-case-who">J (anonymous), USD 2M founder</p>
          <a class="btn-teal" href="/casestudies/j">Read the short case study</a>
          <p class="hw-case-note">We protect our founders’ identities</p>
        </aside>
      </div>
    </section>

    <Fragment set:html={toWhite} />

    <!-- 10. Testimonials -->
    <section class="hw-band" aria-labelledby="hw-reviews">
      <div class="hw-well">
        <h2 id="hw-reviews" class="hw-center">Leaders who've been through it</h2>
        <ul class="hw-reviews">
          {shown.map((review) => (
            <li class="hw-review">
              <blockquote>{clipQuote(review.quote)}</blockquote>
              <p class="hw-review-name">{review.name}</p>
              <p class="hw-review-role">{review.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Fragment set:html={toTint} />

    <!-- 11. Numbers -->
    <section class="hw-band hw-band-tint" aria-labelledby="hw-track">
      <div class="hw-well">
        <h2 id="hw-track" class="hw-center">Our team’s track record</h2>
        <ul class="hw-stats">
          {stats.map((stat) => (
            <li>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Fragment set:html={toWhite} />

    <!-- 12. Guarantee + apply -->
    <section class="hw-band" aria-labelledby="hw-guarantee">
      <div class="hw-well">
        <div class="hw-guarantee">
          <h2 id="hw-guarantee">Clarity‑First Guarantee (Stage 1)</h2>
          <p>You can’t know whether FRP is right for you from the outside — you only know once you’ve been inside the work.</p>
          <p>Complete onboarding and attend your first two private 1:1 sessions. If you decide the partnership isn’t right for you, email us within 7 days of Session 1, and we’ll refund the remainder of your Stage 1 investment –– no matter the reason (we only retain the portion covering the two sessions delivered).</p>
          <p>You keep all decisions, plans, and tools from our first sessions. We take real delivery risk on purpose, because we only want to continue if it’s genuinely the right fit.</p>
          <a class="btn-teal" href="/clarity-first-guarantee-terms">Read full terms</a>
        </div>
        <div class="hw-apply-block">
          <p class="hw-pull hw-center">Private work. Real consequences. Real change.</p>
          <a class="btn-apply" href="/apply-stage-1">Apply for Stage 1</a>
          <p class="hw-limited hw-limited-dark">Limited to five new founders a month</p>
        </div>
      </div>
    </section>

    <Fragment set:html={toTint} />

    <!-- 13. Wayfinder team -->
    <section class="hw-band hw-band-tint" aria-labelledby="hw-wf">
      <div class="hw-well hw-well-wide">
        <h2 id="hw-wf" class="hw-center">The <span class="hw-pink">Wayfinder</span> Team</h2>
        <p class="hw-wf-intro">
          <span class="hw-wf-access">Access our</span>
          <a class="hw-wf-hub" href="/wayfinders">Wayfinder Hub →</a>
          <span>to meet our Wayfinders up close, geo-travel map, fit-first matching process</span>
        </p>
        <ul class="hw-hubs">
          {hubs.map((hub) => (
            <li class="hw-hub">
              <div class="hw-hub-top">
                <h3>{hub.name} <span class="hw-pink">Hub</span></h3>
                <p class="hw-hub-also">{hub.also}</p>
                <a class="hw-wf-link" href={wfFor(hub.wayfinder).url} style={`--hw-wf-tint:${wfFor(hub.wayfinder).tint}`}>
                  <span class="hw-wf-photo">
                    <picture>
                      <source type="image/webp" srcset={`${wfFor(hub.wayfinder).photo.base}@1x.webp 320w, ${wfFor(hub.wayfinder).photo.base}@2x.webp 640w`} sizes="112px" />
                      <img src={`${wfFor(hub.wayfinder).photo.base}@1x.png`} width={wfFor(hub.wayfinder).photo.width} height={wfFor(hub.wayfinder).photo.height} alt={`Photo of ${hub.wayfinder}, DoGood Wayfinder`} loading="lazy" decoding="async" />
                    </picture>
                  </span>
                  <span class="hw-hub-name">{hub.wayfinder}</span>
                </a>
              </div>
              <div class="hw-hub-bottom">
                <p><strong>Human Side:</strong> {hub.human}</p>
                <ul class="hw-flags">
                  {hub.flags.map((flag) => (
                    <li><img src={flag.src} width="24" height="16" alt={flag.name} loading="lazy" decoding="async" /></li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
        <div class="hw-wf-cta">
          <a class="btn-teal" href="/wayfinders">Meet the Wayfinder Team →</a>
          <p class="hw-wf-note">You don’t pick a Wayfinder · We match for fit first.</p>
        </div>
      </div>
    </section>

    <Fragment set:html={toWhite} />

    <!-- 14. FAQ link -->
    <section class="hw-band" aria-labelledby="hw-faq">
