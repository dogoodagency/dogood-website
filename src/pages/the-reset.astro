---
import "../styles/how-it-works.css";
import WhoopSection from "../components/WhoopSection.astro";
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
import { edgeAbove } from "../data/edge-line";
import { stats, reviews } from "../data/homepage";
import { Image } from "astro:assets";
import TestimonialWall from "../components/TestimonialWall.astro";
import HwHouse from "../components/HwHouse.astro";
import HwSupports from "../components/HwSupports.astro";
import HwWayfinders from "../components/HwWayfinders.astro";
import StageSwitch from "../components/StageSwitch.astro";
import { familiar } from "../data/sound-bites";
import caseJImg from "../assets/cases/case-study-j-founder-life-after-exit.png";
import caseVImg from "../assets/cases/case-study-v-founder-life-after-exit.png";
import { wayfinders } from "../data/wayfinders";
import FoundrLand from "../components/FoundrLand.astro";
import {
  houses,
  arrowSrc,
  stage1Includes,
  stage2Includes,
  supports,
  fitSignals,
  notFor,
  hubs,
  steps,
  reviewFiles,
} from "../data/how-it-works";

const wfFor = (name: string) => {
  const found = wayfinders.find((w) => w.name === name);
  if (!found) throw new Error(`No Wayfinder named ${name}`);
  return found;
};

const tint = "#F3FFFB"; // GRASS 25: Stage 1 colour (Seb, 19 Nov 2026)
const white = "#ffffff";
const heroEdge = edgeAbove("#2A0B4F");
const bandEdge = edgeAbove(tint);
const footerEdge = edgeAbove(tint);

/** Wavy join between two bands: `from` is the band above, `to` the band below. */
function wave(from: string, to: string) {
  const above = from === tint ? "tint" : "white";
  return `<div class="hw-divider hw-divider--${above}" aria-hidden="true"><svg style="--wave-edge:${bandEdge}" viewBox="0 0 1440 80" preserveAspectRatio="none"><path fill="${to}" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16v48H0Z"></path><path class="wave-edge" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16"></path></svg></div>`;
}
const toTint = wave(white, tint);
const toWhite = wave(tint, white);
const dream = "#2A0B4F";
const toDream = `<div class="hw-divider hw-divider--tint" aria-hidden="true"><svg style="--wave-edge:${bandEdge}" viewBox="0 0 1440 80" preserveAspectRatio="none"><path fill="${dream}" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16v48H0Z"></path></svg></div>`;
const fromDream = `<div class="hw-divider" style="background:${dream}" aria-hidden="true"><svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path fill="${tint}" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16v48H0Z"></path></svg></div>`;

function clipQuote(quote: string) {
  const clean = quote.replace(/\s+/g, " ").trim();
  const limit = 260;
  if (clean.length <= limit) return clean;
  const cut = clean.slice(0, limit).replace(/\s+\S*$/, "").replace(/[.…,\s]+$/, "");
  return `${cut}…`;
}

// All reviews with portraits for the moving wall (Seb, 19 Nov 2026: same motion as /stories, with photos).
const portraitFiles = import.meta.glob<ImageMetadata>("../assets/reviews/*", { eager: true, import: "default" });
const portraitFor = (file: string) => Object.entries(portraitFiles).find(([p]) => p.endsWith(`/${file}`))?.[1];
const wallItems = reviews.map((r) => ({ quote: r.quote, name: r.name, role: r.role, image: portraitFor(r.file) }));
void reviewFiles;

// Track record numbers animated like the homepage (count-up when scrolled into view).
const countFor = (value: string) => {
  const m = value.match(/^(\D*)([\d,.]+)(.*)$/);
  if (!m) return { count: "", prefix: "", suffix: "", decimals: "0" };
  const num = m[2].replace(/,/g, "");
  return { count: num, prefix: m[1], suffix: m[3], decimals: num.includes(".") ? String(num.split(".")[1].length) : "0" };
};

// Sound bites from real calls (Call Language Log, non-private rows, lightly cleaned). Names are stand-ins (first name + initial, Seb 19 Nov 2026); the page says they are changed. The first two
// were already here; four added 19 Nov 2026 (Q087, Q102, Q098, Q069).


const [houseBefore, houseStage1, houseStage2] = houses;
---

<Base
  title="Life after selling a business: The Reset | DoGood Agency"
  description="Life after selling a business: a private 2-stage partnership for founders after the sale. Start with The Reset (30 days). Limited to 5 new founders a month."
  canonical="https://www.dogoodagency.co/the-reset"
  footerStrip={tint}
  footerEdge={footerEdge}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: "Founder Reclamation Partnership: Stage 1 The Reset",
      url: "https://www.dogoodagency.co/the-reset",
      description: "A private 1:1 engagement for founders after exit. Stage 1, The Reset, runs for 30 days; Stage 2, The Build, is by invitation.",
      serviceType: "1:1 founder coaching",
      provider: { "@id": "https://www.dogoodagency.co/#organization" },
      audience: { "@type": "Audience", audienceType: "Founders before or after an exit" },
      areaServed: "Worldwide",
      additionalProperty: { "@type": "PropertyValue", name: "Duration", value: "30 days (Stage 1); 12 weeks (Stage 2, by invitation)" },
    })} />
  <article class="hw-page hw-page--s1">
    <!-- 1. Hero -->
    <header class="hw-hero">
      <div class="hw-hero-inner">
        <p class="hw-eyebrow">Stage 1: The Reset™ (30 Days)</p>
        <h1>Life after selling your business, starting with 30 days</h1>
        <p class="hw-hero-lede hw-hero-lede-sm">The Founder Reclamation Partnership is a private 1:1 partnership for founders after the sale. It starts with The Reset: 30 days with a Wayfinder to get clear on who you want to be without the company.</p>
      </div>
      <Wave fill={tint} edge={heroEdge} />
    </header>

    <!-- 1. The two stages as one switch (Seb, 19 Nov 2026 14:55): replaces the progress pills and the two dark
         stage cards, which repeated each other. -->
    <section class="hw-band hw-band-tint hw-path" aria-labelledby="hw-path">
      <div class="hw-well">
        <p class="hw-eyebrow hw-center">The FRP is a 2-stage process</p>
        <h2 id="hw-path" class="hw-center hw-path-title">Reset first. Then build.</h2>
        <StageSwitch current={1} />
        <p class="hw-path-note">You apply for Stage 1 only. Stage 2 is invite-only. <a href="/the-build">What happens in Stage 2 →</a></p>
      </div>
    </section>

    <Fragment set:html={toWhite} />

    <!-- 1a. How to start, and the Exit Prep callout -->
    <section class="hw-band hw-start" aria-label="How to start">
      <div class="hw-well">
        <p class="hw-flow hw-flow-sm hw-center"><a href="#anchor-1"><strong>How it works:</strong></a> Apply → Conversation → Start Stage 1</p>
        <p class="hw-expedite hw-center">We protect our delivery quality: Ask about <a href="/expedited-start">Expedited Start</a> if urgent<br />(FRP can begin within 7 days)</p>

        <aside class="hw-notyet-card" aria-label="Not sold yet?">
          <div>
            <p class="hw-notyet-eyebrow">Not there yet?</p>
            <p class="hw-notyet-text">If you haven't sold yet, <strong>The Exit Prep</strong> is for you: six weekly 1:1 sessions on the personal side of the sale, while the deal is still ahead of you.</p>
          </div>
          <a class="btn-teal" href="/exit-prep">See The Exit Prep</a>
        </aside>
      </div>
    </section>

    <Fragment set:html={toTint} />

    <!-- 1b. Sound bites: 6 quotes from real calls (own tinted band, 19 Nov 2026 14:55) -->
    <section class="hw-band hw-band-tint" aria-labelledby="hw-familiar">
      <div class="hw-well">
        <h2 id="hw-familiar" class="hw-center">Sound bites</h2>
