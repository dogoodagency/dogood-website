---
// Booking page for exit advisors and succession planners (TidyCal "DoGood x Exit Advisor Sync", 45 min).
// Copy drafted by Claude from the TidyCal description and the Advisor Center wording: for Seb to review.
import BookingPage from "../components/BookingPage.astro";
---

<BookingPage
  title="Exit Advisor Sync"
  tidycal="dogoodagency/exit"
  seoTitle="Exit Advisor Sync | DoGood Agency"
  description="A 45-minute call for sell-side M&A advisors, exit advisors and succession planners to coordinate how DoGood supports founders before and after their company exits."
  canonical="https://www.dogoodagency.co/exit"
  robots="noindex"
  ogImage="/media/og/exit-og.jpg"
>
  <p>For <strong>sell-side M&amp;A advisors, exit advisors and succession planners</strong> who work with founders before and after the sale.</p>
  <p>
    A 45-minute call to coordinate and collaborate, so we can better support founders before and after their company
    exits. We work only on the personal side of the exit. You stay the trusted advisor.
  </p>

  <p class="bk-label bk-label--plain">Use this call to:</p>
  <ul>
    <li>Talk through a founder you think could use support (no names needed)</li>
    <li>Agree how and when we work alongside your process</li>
    <li>Agree how we keep you informed, within what the founder allows</li>
  </ul>

  <p class="bk-label">Prep (2 minutes)</p>
  <ul>
    <li>Where the deal stands, and what you are seeing in the founder</li>
    <li>Any questions about how we work with advisors</li>
  </ul>

  <div class="bk-btn-row">
    <a class="btn-apply" href="/advisor-center">See the Advisor Center</a>
  </div>
</BookingPage>
