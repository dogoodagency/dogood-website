---
import { getEntry } from "astro:content";
import "../styles/advisors.css";
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
import AdvisorNav from "../components/AdvisorNav.astro";
import { edgeAbove } from "../data/edge-line";
import TestimonialWall from "../components/TestimonialWall.astro";
import FoundrLand from "../components/FoundrLand.astro";

// Title and description come from the frontmatter of src/content/pages/advisor-center.md.
// The words on this page are that file's copy, set out in sections.
const entry = await getEntry("pages", "for-advisors");
const title = entry?.data.title ?? "Advisor Center | DoGood Agency";
const description =
  entry?.data.description ??
  "The Advisor Center: how DoGood works with exit and succession advisors, and free tools to help your clients with life after the sale.";

const tint = "#F5F2FF";
const heroEdge = edgeAbove("#2A0B4F");
const footerEdge = edgeAbove("#ffffff");

const steps = [
  {
    title: "An intro conversation with Seb",
    text: "A short call to see whether a partnership is a fit, and to walk through how we work together. This is also when we share the details of our Referral Partner Agreement.",
  },
  {
    title: "You introduce the founder, with their permission",
    text: "If your client is open to it, you make the introduction. We never approach a founder without that introduction, and we never ask you to make one without their permission.",
  },
  {
    title: "A private Fit Call",
    text: "We speak with the founder about whether Stage 1 is right for them. You do not need to be on this call. If it is not a fit, we say so clearly, and we tell you.",
  },
  {
    title: "We keep you informed, with the founder's consent",
    text: "If they go ahead, we keep you informed of the broad shape of things. We do not share confidential details from the work itself.",
  },
  {
    title: "Stage 1 starts",
    text: "The founder begins a private 30-day engagement. You stay the trusted advisor.",
  },
];

// What you get (Seb, 19 Nov 2026): fleshed out from what advisors told us on calls (voice-of-customer
// findings, 18 Nov 2026). Patterns, not statistics; no quotes or names.
const benefits = [
  {
    key: "smoother",
    title: "Smoother deals",
    text: "Advisors tell us the same story: founders who are not personally ready get cold feet, nitpick buyers and stall their own deals. A founder who has looked at life after the sale walks into closing calmer, and the deal is more likely to land.",
  },
  {
    key: "leg",
    title: "The personal leg, covered by a specialist",
    text: "Exit planning stands on business, financial and personal readiness. You cover the first two. We are the specialist for the third, so you are never left winging it with a questionnaire.",
  },
  {
    key: "after",
    title: "Fewer regrets after closing",
    text: "The emptiness often arrives weeks or months after the deal, when the calendar is empty. Your client has a place for that, and remembers who made the introduction.",
  },
  {
    key: "trusted",
    title: "You stay the trusted advisor",
    text: "We never contact your client without your introduction. We do not poach, and we do not give financial or legal advice. With the founder's consent, we keep you in the loop on the broad shape of things.",
  },
  {
    key: "family",
    title: "Room for the family too",
    text: "Spouses and partners can be part of the conversation. A family that is aligned on what comes next makes the transition easier for everyone, including you.",
  },
  {
    key: "tools",
    title: "Free tools with your name on the link",
    text: "Every tool in the toolkit is free to share, with no sign-up. The readiness check comes with your own personal link, so you see who it helped.",
  },
  {
    key: "fee",
    title: "A referral fee, or a credit for your client",
    text: "There is a referral fee under a written Referral Partner Agreement. If you do not accept referral fees, we can credit it to the founder or donate it instead. We share the details on the intro call.",
  },
];

const audiences = [
  { title: "Exit planners", text: "You prepare the business for the sale. We prepare the founder for life after it." },
  { title: "Succession advisors", text: "Handing over the company is one transition. Handing over a sense of who you are is another." },
  { title: "Wealth advisors and family offices", text: "The money is planned. What the founder does with their time, energy and identity often is not." },
  { title: "Sell-side M&A advisors", text: "A founder who is personally ready is less likely to stall the deal at the last minute." },
];

// [SEB] Quotes are Seb's words, verbatim. Stand-in first names + initial added 19 Nov 2026 (Seb); real names stay private, the page says so.
const quotes = [
  {
    text: "Most people are talking with that founder around just the business side of the equation. They're not asking questions about the personal side.",
    name: "Robert H",
    role: "Wealth advisor",
  },
  {
    text: "Remember that founder has probably not built a business and sold one before. So they have no idea what's coming.",
    name: "Julia M",
    role: "Wealth advisor",
  },
  {
    text: "I can do my best work if I get someone before an LOI.",
    name: "Kevin S",
    role: "Wealth advisor",
  },
  {
    text: "That's a conversation that I think is important to have, but I don't have the resource to support them.",
    name: "Nathan C",
    role: "Exit advisor",
  },
  {
    text: "They don't actually internally… aren't ready to let go even though their company is for sale… and they blow up their own deals.",
    name: "Olivia G",
    role: "Exit advisor",
  },
];

const faqs = [
  {
    q: "Will you contact my client without me?",
    a: "No. We never contact a founder without your introduction, and we only ask you to introduce them with their permission.",
  },
  {
    q: "Who is a good fit to introduce?",
    a: "Before the sale: a founder who hesitates, keeps finding faults with buyers, or can't say what they'll do afterwards. After the sale: founders who have exited and are no longer in the day-to-day (a board or advisory role is fine). This is often a fit when they have more freedom than before, and it does not feel the way they expected. If you are unsure, we can talk it through on the intro call.",
  },
  {
    q: "What about a client who has not sold yet?",
    a: "We have a shorter Exit-Prep for founders who have firmly decided to exit and are preparing for it: six weekly sessions, held remotely, with the same guarantee as Stage 1. If they later want to go deeper after the sale, they can move on to Stage 1. Ask us about it on the intro call.",
  },
  {
    q: "What happens when the owner isn't ready?",
    a: "It usually shows late: cold feet near closing, fault-finding with every buyer, a deal that stalls. The personal leg is the part of readiness that moves slowest, so the earlier it starts, the less it costs the deal.",
  },
  {
    q: "How do I raise the personal side with a client?",
    a: "Only when it feels natural, and never under pressure. The best opening is when a founder tells you they are struggling. If you have a long relationship built on trust, a frank word works too: \"I've known you for years, and I think this would really help you.\" If a founder isn't open to it, that's fine. Leave it there.",
  },
  {
    q: "What should I tell them?",
    a: "That DoGood is a private 30-day engagement for founders navigating life after exit, and that you would like to introduce them, if they are willing. We can give you a short way to say this on the intro call.",
  },
  {
    q: "Do the free tools cost anything, or need a sign-up?",
    a: "No. They are free to use and to share, with no sign-up for you. The only email we ask for is your client's, so we can send them their own readiness report. You see a copy only if they say yes.",
  },
  {
    q: "How does the referral fee work?",
    a: "There is a referral fee, paid under a written Referral Partner Agreement. The details are in that agreement, and we share them on the intro call. We do not publish amounts on this page.",
  },
  {
    q: "Will I know how the work is going?",
    a: "Yes, with the founder's consent. We keep you informed of the broad shape of things. We do not share confidential details from the sessions.",
  },
  {
    q: "Do you give financial or legal advice?",
    a: "No. We do not give financial or legal advice, and we do not poach. You stay the trusted advisor. We work only on the personal side of life after exit.",
  },
];
---

<Base
  title={title}
  description={description}
  canonical="https://www.dogoodagency.co/advisor-center"
  footerStrip="#ffffff"
  footerEdge={footerEdge}
  ogTitle={title}
>
  <article class="adv-page">
    <header class="adv-hero">
      <div class="adv-hero-inner adv-hero-inner--split">
        <div class="adv-hero-copy">
          <p class="adv-eyebrow">Advisor Center · For exit planning advisors</p>
          <h1>When the deal closes, the hard part starts.</h1>
          <p class="adv-lede">
            We support life in <span class="adv-founder"><strong>FOUNDR</strong>.land</span>. You prepare the business and the money for the sale. We prepare the founder: the <a href="/advisor-center/insights#advi-legs">personal readiness leg</a> of exit planning.
          </p>
        </div>

      </div>
      <Wave fill="#fff" edge={heroEdge} />
    </header>

    <!-- Advisor Center hub right under the hero (Seb, 20 Nov 2026) -->
    <section class="adv-band adv-band--white" aria-label="Introduction">
      <div class="adv-well">
        <AdvisorNav current="refer" />
        <div class="adv-intro">
          <p>You helped your client through the transaction. What comes next is personal: more freedom than they expected, and less certainty about what to do with it.</p>
          <p>You stay the trusted advisor. We provide a private place for the part that is not financial or legal: helping them see what they actually want in life after exit.</p>
        </div>
      </div>
    </section>

    <!-- Who this is for: four cards (Seb, 19 Nov 2026; was one line in the hero) -->
    <section class="adv-band adv-band--white" aria-labelledby="adv-who">
      <div class="adv-well">
        <h2 class="adv-section-title" id="adv-who">Who we work alongside</h2>
        <ul class="adv-aud">
          {audiences.map((a, i) => (
            <li class:list={["adv-aud-card", `adv-aud-card--${i + 1}`]}>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="adv-band adv-band--lilac" aria-labelledby="adv-tell">
      <div class="adv-well">
        <h2 class="adv-section-title" id="adv-tell">What advisors tell us</h2>
        <TestimonialWall items={quotes.map((q) => ({ quote: q.text, name: q.name, role: q.role }))} short label="What advisors tell us" />
        <!-- Two doors (Seb, 19 Nov 2026) -->
        <div class="adv-doors-intro">
          <p>That's the personal leg of exit planning. It's what we cover, so your deal and your client both land well.</p>
          <p class="adv-doors-ask">Which kind of advisor are you?</p>
        </div>
        <div class="adv-doors">
          <section class="adv-door adv-door--exit" aria-labelledby="adv-door-exit">
            <p class="adv-door-label">Exit, succession and M&amp;A</p>
            <h3 id="adv-door-exit">I prepare the business for the sale</h3>
            <p>You know the founder before the sale. Bring us in 12 to 18 months out, or at least before the LOI, so the founder walks into the deal ready, and out of it with a plan for life after.</p>
            <a class="btn-teal btn-dream" href="/exit">Exit advisors: become a partner</a>
          </section>
          <section class="adv-door adv-door--wealth" aria-labelledby="adv-door-wealth">
            <p class="adv-door-label">Wealth and family office</p>
            <h3 id="adv-door-wealth">I look after the money and the family</h3>
            <p>You stay with the founder and their family after the sale. The wealth is planned. We help them decide what the time, energy and freedom are for.</p>
            <a class="btn-teal" href="/wealth">Wealth advisors: become a partner</a>
          </section>
        </div>
      </div>
    </section>

    <FoundrLand kind="advisor" />

    <section class="adv-band adv-band--lilac" aria-labelledby="adv-why">
      <div class="adv-well">
        <h2 class="adv-section-title" id="adv-why">Why refer</h2>
        <div class="adv-prose">
          <p>Before the sale, a founder who can't picture life afterwards gets cold feet: they put the brakes on, nitpick buyers, or stall the deal at the last minute. A founder who is personally ready signs calmly.</p>
          <p>After the sale, your client's deal can close and the hard part can still be starting.</p>
          <p>The company gave their days structure, urgency, and a place to put their energy. Without it, many founders find the freedom they worked toward does not feel the way they expected. Exit and succession work, and wealth advice, look after the transaction and the money. Very few people help with what happens after.</p>
          <p>A trusted introduction means they do not have to look for that help alone, and you remain the person they came from.</p>
        </div>
      </div>
    </section>

    <section class="adv-band adv-band--white" aria-labelledby="adv-gets">
      <div class="adv-well">
        <p class="adv-eyebrow">What your client gets</p>
        <div class="adv-card">
          <h2 class="adv-section-title" id="adv-gets">Before or after the sale, a private place for the personal side</h2>
          <div class="adv-prose">
            <p><strong>Before the sale:</strong> <a href="/exit-prep">The Exit Prep</a>, six weekly sessions, fully remote, built to fit around a busy deal.</p>
            <p><strong>After the sale:</strong> Stage 1, a private, confidential 30 days. We help them see what is really going on for them, tell the next shiny thing from what they really want, and get clear on what needs attention before the next major decision. If it fits, Stage 2 follows by invitation only.</p>
            <p>The work is limited to 5 new founders a month. If Stage 1 is not right, we say so, and we point them somewhere better. Stage 1 is covered by our Clarity-First Guarantee.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Free session (Seb, 19 Nov 2026) -->
    <section class="adv-band adv-band--lilac" aria-labelledby="adv-trial">
      <div class="adv-well">
        <div class="adv-trial">
          <p class="adv-trial-badge">For your client, on us</p>
          <h2 class="adv-section-title" id="adv-trial">A free session with a Wayfinder</h2>
          <p>Have a client who is interested but wants to try us first? Introduce them, and they get one private session with one of our Wayfinders at no cost. No obligation for them, and no paperwork for you.</p>
          <div class="adv-card-actions">
            <a class="btn-teal btn-dream" href="/exit">Exit advisors: arrange a free session</a>
            <a class="btn-teal" href="/wealth">Wealth advisors: arrange a free session</a>
          </div>
        </div>
      </div>
    </section>

    <section class="adv-band adv-band--white" aria-labelledby="adv-toolkit">
      <div class="adv-well">
        <div class="adv-card">
          <p class="adv-card-badge">Free toolkit</p>
          <h2 class="adv-section-title" id="adv-toolkit">Something useful to hand your client, at no cost</h2>
          <div class="adv-prose">
            <p>Advisors told us the same thing again and again: their clients have no plan for life after the sale, and there is nothing to hand them that opens the personal conversation. So we are building free tools for exactly that. No sign-up for you, and no strings.</p>
            <p>First comes the Founder Readiness Check. You send it with your own link. Your client gets a private report and a free debrief call. If they say yes, you get a copy.</p>
          </div>
          <div class="adv-card-actions">
            <a class="btn-teal" href="/advisor-center/client-tools">See the free toolkit →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="adv-band adv-band--lilac adv-how-band" aria-labelledby="adv-how">
      <div class="adv-well">
        <h2 class="adv-section-title" id="adv-how">How a referral works</h2>
        <p>A short, careful path. We never contact your client without you.</p>
        <ol class="adv-steps adv-steps--color" role="list" data-adv-steps>
          {
            steps.map((step) => (
              <li class="adv-step">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="adv-walk">
          <div>
            <p class="adv-walk-badge">Coming soon</p>
            <h3>See a referral from the inside</h3>
            <p>A short walk-through, with a video from Seb, shows step by step what happens after you refer someone: the first call, the 30 days, and what you hear back.</p>
          </div>
          <a class="btn-teal btn-dream" href="/exit">Ask Seb for a live walk-through now</a>
        </div>
      </div>
    </section>

    <section class="adv-band adv-band--white" aria-labelledby="adv-benefits">
      <div class="adv-well">
        <h2 class="adv-section-title" id="adv-benefits">What you get</h2>
        <p class="adv-benefits-lede">Patterns from our conversations with exit planners, wealth advisors and M&amp;A advisors.</p>
        <div class="adv-benefit-hero">
          <h3>{benefits[0].title}</h3>
          <p>{benefits[0].text}</p>
        </div>
        <ul class="adv-benefits">
          {benefits.slice(1).map((item) => (
            <li class:list={["adv-benefit", `adv-benefit--${item.key}`]}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="adv-band adv-band--lilac" aria-labelledby="adv-conf">
      <div class="adv-well">
        <p class="adv-eyebrow">Confidentiality</p>
        <h2 class="adv-section-title" id="adv-conf">How we treat your relationship</h2>
        <div class="adv-prose">
          <p>We never contact the founder without your introduction.</p>
          <p>We do not poach, and we do not give financial or legal advice. The personal work stays private. Anything we tell you about how things are going is with the founder's consent, and never includes confidential details.</p>
        </div>
      </div>
    </section>

    <!-- Recommend an advisor (Seb, 19 Nov 2026) -->
    <section class="adv-band adv-band--white" aria-labelledby="adv-recommend">
      <div class="adv-well">
        <div class="adv-recommend">
          <div>
            <h2 class="adv-section-title" id="adv-recommend">Know an advisor who should see this?</h2>
            <p>If a colleague in exit planning, wealth or M&amp;A keeps meeting founders who are not ready for life after the sale, send them this page, or tell us who they are and we will reach out with your name.</p>
          </div>
          <a class="btn-teal" href="mailto:hiya@dogoodagency.co?subject=An%20advisor%20you%20should%20meet">Recommend an advisor</a>
        </div>
      </div>
    </section>

    <section class="adv-band adv-band--lilac" aria-labelledby="adv-faq">
      <div class="adv-well">
        <p class="adv-eyebrow">FAQ</p>
        <h2 class="adv-section-title" id="adv-faq">Questions advisors ask</h2>
        <ul class="adv-faq" data-adv-faq>
          {
            faqs.map((faq, i) => (
              <li class="adv-faq-item">
                <h3>
                  <button
                    class="adv-faq-trigger"
                    type="button"
                    id={`adv-faq-q-${i}`}
                    aria-expanded="false"
                    aria-controls={`adv-faq-a-${i}`}
                  >
                    <span class="adv-faq-q">{faq.q}</span>
                    <span class="adv-faq-icon" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none">
                        <path d="m3 6 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </button>
                </h3>
                <div class="adv-faq-panel" id={`adv-faq-a-${i}`} role="region" aria-labelledby={`adv-faq-q-${i}`}>
                  <div class="adv-faq-answer">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="adv-band adv-band--white" aria-labelledby="adv-close">
      <div class="adv-well">
        <div class="adv-cta">
          <h2 id="adv-close">If you have a client in mind,<br />or might.</h2>
          <p>Book a short intro call with Seb.<br />We can take it from there.</p>
          <div class="adv-card-actions">
            <a class="btn-teal btn-dream" href="/exit">Exit advisors: book an intro call</a>
            <a class="btn-teal" href="/wealth">Wealth advisors: book an intro call</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  // Bundled (not inline) so it passes the site's Content-Security-Policy.
  // Without JavaScript every answer stays open; with it they collapse into an accordion.
  document.documentElement.classList.add("adv-js");

  // How a referral works: steps come in one after another when scrolled into view.
  const advSteps = document.querySelector<HTMLElement>("[data-adv-steps]");
  if (advSteps) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) advSteps.classList.add("is-in");
    else {
      advSteps.classList.add("will-animate");
      const io = new IntersectionObserver(([e]) => {
        if (!e?.isIntersecting) return;
        advSteps.classList.add("is-in");
        io.disconnect();
      }, { threshold: 0.2 });
      io.observe(advSteps);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-adv-faq] .adv-faq-item").forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".adv-faq-trigger");
    if (!trigger) return;
    trigger.addEventListener("click", () => {
      const open = !item.classList.contains("is-open");
      item.classList.toggle("is-open", open);
      trigger.setAttribute("aria-expanded", String(open));
    });
  });
</script>
