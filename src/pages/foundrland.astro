---
/**
 * foundr.land (Seb, 19 Nov 2026 21:02): the product page for foundr.land, by DoGood Agency.
 * Its own look, from the foundr.land logo selection board: light lilac, airy gradients, pastel cards in PLAY,
 * GRASS, SKY and HEART, DREAM 500 ink, a serif accent (Fraunces) next to Montserrat. It deliberately does not
 * follow the DoGood page style.
 *
 * Content comes from Seb's notes, the Product Vision & MVP deck, the brand visual deck and the Founder Journey
 * system image (Nov 2026). Everything is a product concept and is labelled so. All visuals are drawn here in
 * HTML/SVG (phone, clarity wheel, journey, workspace); the numbers in mock-ups are illustrative.
 */
// Fraunces is self-hosted (20 Nov 2026): the site's Content-Security-Policy blocks Google Fonts, so the
// earlier Google Fonts link never loaded and the serif fell back to Georgia.
import "@fontsource/fraunces/latin-800.css";
import "@fontsource/fraunces/latin-500-italic.css";
import "@fontsource/fraunces/latin-700-italic.css";
import Base from "../layouts/Base.astro";
import { edgeAbove } from "../data/edge-line";

const tint = "#F5F2FF";
const footerEdge = edgeAbove(tint);

// The six dimensions of the Personal Clarity Wheel (from the vision deck).
const dims = [
  { name: "Identity", q: "Who am I without my owner role?", tone: "grass" },
  { name: "Time & structure", q: "What will everyday life look like?", tone: "play" },
  { name: "Relationships", q: "Who is part of the transition?", tone: "sky" },
  { name: "Purpose", q: "What am I moving toward?", tone: "heart" },
  { name: "Letting go", q: "What feels difficult to release?", tone: "grass" },
  { name: "Energy & support", q: "What do I need to move well?", tone: "play" },
];

// Seven days (from the vision deck).
const days = [
  { n: "01", t: "Identity", q: "Who am I beyond the company?" },
  { n: "02", t: "Time", q: "What might my week look like?" },
  { n: "03", t: "Relationships", q: "Who needs to be part of this?" },
  { n: "04", t: "Purpose", q: "What is this next chapter for?" },
  { n: "05", t: "Letting go", q: "What is hard to leave behind?" },
  { n: "06", t: "Energy", q: "What support do I need?" },
  { n: "07", t: "My next step", q: "Review and choose an action." },
];

// Radar geometry for the wheel (illustrative values, 0–5 scale).
const cx = 160;
const cy = 160;
const R = 120;
const angle = (i: number) => (-90 + i * 60) * (Math.PI / 180);
const xy = (i: number, v: number) => {
  const r = (v / 5) * R;
  return [cx + r * Math.cos(angle(i)), cy + r * Math.sin(angle(i))];
};
const pt = (i: number, v: number) => xy(i, v).map((n) => n.toFixed(1)).join(",");
const ring = (v: number) => [0, 1, 2, 3, 4, 5].map((i) => pt(i, v)).join(" ");
const day7 = [3.2, 4.2, 2.6, 3.6, 2.1, 3];
const day30 = [3.9, 4.5, 3.6, 4.1, 3.2, 3.8];
const shape = (vals: number[]) => vals.map((v, i) => pt(i, v)).join(" ");
const wheelLabels = ["Identity", "Time", "Relationships", "Purpose", "Letting go", "Energy"];
const labelAt = (i: number) => {
  const r = R + 26;
  return [cx + r * Math.cos(angle(i)), cy + r * Math.sin(angle(i)) + 5];
};

// Feature plan (Seb's list, 19 Nov 2026). Proposed split: first release vs following release.
const features: [string, "mvp" | "next"][] = [
  ["Mobile-friendly founder account", "mvp"],
  ["Seven-day guided reflections", "mvp"],
  ["Six-dimension Clarity Wheel", "mvp"],
  ["Personalised private report", "mvp"],
  ["Suggested actions from a reviewed library", "mvp"],
  ["Saved personal action and progress", "mvp"],
  ["Automated email reminders", "mvp"],
  ["Advisor link and light workspace", "mvp"],
  ["Founder-controlled advisor sharing", "mvp"],
  ["Optional DoGood specialist pathway", "mvp"],
  ["Day 14 and 30 progress check-ins", "next"],
  ["Original-versus-current Clarity Wheel", "next"],
  ["Additional journeys for specific life stages", "next"],
  ["Longer-term personal progress history", "next"],
  ["Optional SMS or push notifications", "next"],
];

const I: Record<string, string> = {
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  report: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 16v-3M12 16v-6M15 16v-4"/>',
  shield: '<path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  calendar: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16M9 14h.01M12 14h.01M15 14h.01M9 17h.01M12 17h.01"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/>',
  person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
  eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  chat: '<path d="M4 5h16v10H9l-5 4z"/><path d="M8 10h.01M12 10h.01M16 10h.01"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  sprout: '<path d="M12 20v-8"/><path d="M12 12c0-4 3-6 7-6 0 4-3 6-7 6zM12 14c0-3-2.5-5-6-5 0 3 2.5 5 6 5z"/>',
};
const svg = (k: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${I[k]}</svg>`;
---

<Base
  title="foundr.land | Life beyond the business | by DoGood Agency"
  description="foundr.land helps exit and succession advisors turn personal readiness into practical conversations, next steps and founder support, before and after an exit."
  canonical="https://www.dogoodagency.co/foundrland"
  footerStrip={tint}
  footerEdge={footerEdge}
  ogImage="/media/foundrland/foundrland-og.jpg"
  robots="noindex, follow"
>

  <article class="fl">
    <!-- ===== Hero ===== -->
    <header class="fl-hero">
      <div class="fl-swoosh" aria-hidden="true"></div>
      <div class="fl-wrap fl-hero-grid">
        <div class="fl-hero-copy">
          <h1 class="fl-logo">
            <picture>
              <source type="image/webp" srcset="/media/foundrland/foundrland-logo-dark@1x.webp 480w, /media/foundrland/foundrland-logo-dark@2x.webp 960w" sizes="(max-width: 700px) 70vw, 420px" />
              <img src="/media/foundrland/foundrland-logo-dark@2x.png" width="960" height="226" alt="foundr.land" />
            </picture>
          </h1>
          <p class="fl-tagline">Life beyond the business.</p>
          <p class="fl-sub">Personal readiness before and after a business exit.</p>
          <p class="fl-by">by DoGood Agency</p>
          <p class="fl-lede">
            foundr.land helps exit and succession advisors turn personal readiness into practical conversations,
            clear next steps and ongoing founder support, before and after a business exit.
          </p>
          <ul class="fl-chips" aria-label="At a glance">
            <li class="fl-chip fl-chip--grass">7-day founder journey</li>
            <li class="fl-chip fl-chip--sky">Light advisor workspace</li>
            <li class="fl-chip fl-chip--play">Private by default</li>
          </ul>
          <div class="fl-ctas">
            <a class="fl-btn" href="/contact">Join the advisor pilot</a>
            <a class="fl-btn fl-btn--ghost" href="#fl-journey">See the journey</a>
          </div>
        </div>

        <!-- Phone mock-up, drawn in HTML/SVG -->
        <div class="fl-hero-visual" aria-hidden="true">
          <div class="fl-float fl-float--days">
            <strong>7</strong>
            <span>days of clarity</span>
          </div>
          <div class="fl-float fl-float--min">
            <span class="fl-dot"></span>
            5–7 min a day
          </div>
          <div class="fl-phone">
            <div class="fl-phone-notch"></div>
            <div class="fl-phone-screen">
              <p class="fl-ph-brand">foundr<span>.</span>land</p>
              <p class="fl-ph-pill">Day 7 of 7</p>
              <p class="fl-ph-title">Your clarity wheel</p>
              <svg class="fl-ph-wheel" viewBox="0 0 320 320">
                {[1, 2, 3, 4, 5].map((v) => <polygon class="fl-w-ring" points={ring(v)} />)}
                {[0, 1, 2, 3, 4, 5].map((i) => <line class="fl-w-spoke" x1={cx} y1={cy} x2={xy(i, 5)[0]} y2={xy(i, 5)[1]} />)}
                <polygon class="fl-w-shape" points={shape(day7)} />
                {day7.map((v, i) => <circle class="fl-w-dot" cx={xy(i, v)[0]} cy={xy(i, v)[1]} r="7" />)}
              </svg>
              <p class="fl-ph-note">A picture of how clear things feel today.</p>
              <div class="fl-ph-card">
                <span>Your next step</span>
                <strong>Talk with your partner</strong>
              </div>
              <p class="fl-ph-btn">See my report</p>
            </div>
          </div>
        </div>
      </div>
      <p class="fl-wrap fl-concept">Product concept · in development</p>
    </header>

    <!-- ===== Promise ===== -->
    <section class="fl-band" aria-labelledby="fl-promise">
      <div class="fl-wrap">
        <p class="fl-eyebrow">The promise</p>
        <h2 id="fl-promise">One introduction. <em>A complete journey.</em></h2>
        <p class="fl-intro">The system handles the routine work. The advisor keeps the relationship.</p>
        <ul class="fl-three">
          <li class="fl-card fl-card--sky">
            <span class="fl-ico" set:html={svg("shield")} />
            <p class="fl-card-tag">The advisor</p>
            <h3>Confidence</h3>
            <p>Introduce once. Receive useful insights only with the founder’s consent.</p>
            <span class="fl-mini">No additional admin</span>
          </li>
          <li class="fl-card fl-card--dark">
            <span class="fl-ico" set:html={svg("eye")} />
            <p class="fl-card-tag">The founder</p>
            <h3>Clarity</h3>
            <p>Reflect in private. Understand what matters. Choose practical actions.</p>
            <span class="fl-mini">Founder controls sharing</span>
          </li>
          <li class="fl-card fl-card--grass">
            <span class="fl-ico" set:html={svg("compass")} />
            <p class="fl-card-tag">DoGood</p>
            <h3>Specialist support</h3>
            <p>Step in when invited, with the right Wayfinder or other help.</p>
            <span class="fl-mini">Help without pressure</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- ===== Two ways in ===== -->
    <section class="fl-band fl-band--soft" aria-labelledby="fl-ways">
      <div class="fl-wrap">
        <p class="fl-eyebrow">How it starts</p>
        <h2 id="fl-ways">A founder-facing service. <em>Advisor-enabled.</em></h2>
        <p class="fl-intro">Two ways in, one private founder experience, and optional specialist support.</p>

        <div class="fl-flow" data-fl-anim>
          <div class="fl-entry fl-entry--advisor">
            <span class="fl-ico" set:html={svg("briefcase")} />
            <div>
              <h3>Advisor or CEPA</h3>
              <p>Introduces a founder once, with a personal link.</p>
              <ul>
                <li>Takes seconds</li>
                <li>No extra workload</li>
                <li>Kept informed, with consent</li>
              </ul>
            </div>
          </div>
          <div class="fl-entry fl-entry--founder">
            <span class="fl-ico" set:html={svg("person")} />
            <div>
              <h3>Founder directly</h3>
              <p>Starts privately, at their own pace.</p>
              <ul>
                <li>Confidential and supportive</li>
                <li>The same guided experience</li>
                <li>Specialist help when needed</li>
              </ul>
            </div>
          </div>
          <svg class="fl-flow-lines" viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M250 0 C250 50, 500 30, 500 80" />
            <path d="M750 0 C750 50, 500 30, 500 80" />
          </svg>
          <div class="fl-core">
            <p class="fl-core-title">The 7-day mobile journey</p>
            <p class="fl-core-sub">Reflect · Understand · Choose</p>
          </div>
          <svg class="fl-flow-lines" viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M500 0 C500 40, 170 40, 170 80" />
            <path d="M500 0 L500 80" />
            <path d="M500 0 C500 40, 830 40, 830 80" />
          </svg>
          <div class="fl-outcomes">
            <div class="fl-out fl-out--play"><strong>Founder</strong><span>Private report and a next step</span></div>
            <div class="fl-out fl-out--sky"><strong>Advisor</strong><span>Consented summary and status</span></div>
            <div class="fl-out fl-out--heart"><strong>DoGood Wayfinder</strong><span>Opt-in specialist help</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Seven days ===== -->
    <section class="fl-band" id="fl-journey" aria-labelledby="fl-seven">
      <div class="fl-wrap">
        <p class="fl-eyebrow">Days 1–7 · Discover</p>
        <h2 id="fl-seven">Seven days. Six dimensions. <em>One clearer picture.</em></h2>
        <p class="fl-intro">Each daily reflection takes about 5–7 minutes. Progress is saved, so founders can return at their own pace.</p>
        <ol class="fl-days" data-fl-anim>
          {
            days.map((d, i) => (
              <li class:list={["fl-day", i === 6 && "fl-day--last"]} style={`--i:${i}`}>
                <span class="fl-day-n">Day {d.n}</span>
                <h3>{d.t}</h3>
                <p>{d.q}</p>
              </li>
            ))
          }
        </ol>
        <ul class="fl-principles">
          <li><span set:html={svg("lock")} />Calm and private</li>
          <li><span set:html={svg("calendar")} />5–7 minutes a day</li>
          <li><span set:html={svg("sprout")} />Mobile first, no app store</li>
          <li><span set:html={svg("shield")} />Not a clinical assessment</li>
        </ul>
      </div>
    </section>

    <!-- ===== Clarity wheel ===== -->
    <section class="fl-band fl-band--soft" aria-labelledby="fl-wheel">
      <div class="fl-wrap">
        <p class="fl-eyebrow">The Personal Clarity Wheel</p>
        <h2 id="fl-wheel">A visual language for <em>personal clarity.</em></h2>
        <p class="fl-intro">Six self-reported dimensions create a useful picture for a conversation, not a clinical diagnosis or an exit-readiness score.</p>
        <div class="fl-wheel-grid">
          <figure class="fl-wheel" data-fl-anim>
            <svg viewBox="-50 -20 420 360" role="img" aria-label="Illustrative clarity wheel with six dimensions, showing a Day 7 shape and a fuller Day 30 shape.">
              {[1, 2, 3, 4, 5].map((v) => <polygon class="fl-w-ring" points={ring(v)} />)}
              {[0, 1, 2, 3, 4, 5].map((i) => <line class="fl-w-spoke" x1={cx} y1={cy} x2={xy(i, 5)[0]} y2={xy(i, 5)[1]} />)}
              <polygon class="fl-w-shape fl-w-shape--before" points={shape(day7)} />
              <polygon class="fl-w-shape fl-w-shape--after" points={shape(day30)} />
              {day30.map((v, i) => <circle class="fl-w-dot" cx={xy(i, v)[0]} cy={xy(i, v)[1]} r="6" />)}
              {wheelLabels.map((l, i) => <text class="fl-w-label" x={labelAt(i)[0].toFixed(1)} y={labelAt(i)[1].toFixed(1)} text-anchor="middle">{l}</text>)}
            </svg>
            <figcaption>
              <span><i class="fl-key fl-key--before"></i>Day 7</span>
              <span><i class="fl-key fl-key--after"></i>Day 30</span>
              <em>Illustrative responses. Designed to prompt reflection, not a psychometric instrument.</em>
            </figcaption>
          </figure>
          <ul class="fl-dims">
            {dims.map((d) => (
              <li class:list={["fl-dim", `fl-dim--${d.tone}`]}>
                <h3>{d.name}</h3>
                <p>{d.q}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== After Day 7 ===== -->
    <section class="fl-band" aria-labelledby="fl-after">
      <div class="fl-wrap">
        <p class="fl-eyebrow">Day 8 onward · Navigate</p>
        <h2 id="fl-after">Day 7 is not the end. <em>It is where doing begins.</em></h2>
        <p class="fl-intro">
          The founder moves from understanding themselves to doing something with that understanding. No second
          programme straight away, and no daily messages forever.
        </p>

        <div class="fl-phases">
          <div class="fl-phase fl-phase--discover">
            <p class="fl-phase-tag">Days 1–7</p>
            <h3>Discover</h3>
            <p>Guided reflections, six personal-clarity dimensions and a private report.</p>
          </div>
          <span class="fl-phase-arrow" aria-hidden="true">→</span>
          <div class="fl-phase fl-phase--navigate">
            <p class="fl-phase-tag">Day 8 onward</p>
            <h3>Navigate</h3>
            <p>Suggested practical actions, optional check-ins, visual progress and access to the right support.</p>
          </div>
        </div>

        <ol class="fl-timeline" data-fl-anim>
          <li style="--i:0">
            <span class="fl-tl-day">Day 7</span>
            <h3>Understand where I stand</h3>
            <p>The Personal Clarity Wheel, a private report on the reflection themes and three or four suggested actions from a reviewed library. Choose one, or not yet.</p>
          </li>
          <li style="--i:1">
            <span class="fl-tl-day">Days 8–13</span>
            <h3>Put something into practice</h3>
            <p>A simple home screen with the chosen action: complete it, change it or postpone it. No compulsory daily activity; an optional reminder helps.</p>
          </li>
          <li style="--i:2">
            <span class="fl-tl-day">Day 14</span>
            <h3>A gentle progress check</h3>
            <p>A short reflection: what happened, what was learned, and whether a different next step would help.</p>
          </li>
          <li style="--i:3">
            <span class="fl-tl-day">Day 30</span>
            <h3>See what has changed</h3>
            <p>Repeat the six self-ratings and compare the wheel with the original. Changes in self-reported clarity, never claims of psychological improvement.</p>
          </li>
          <li style="--i:4">
            <span class="fl-tl-day">Beyond Day 30</span>
            <h3>Continue when useful</h3>
            <p>Return to the private space, begin another short journey, or ask for a check-in around a milestone such as completing the sale.</p>
          </li>
        </ol>

        <h3 class="fl-h3">Three paths after Day 7</h3>
        <ul class="fl-three">
          <li class="fl-path fl-path--grass">
            <span class="fl-ico" set:html={svg("sprout")} />
            <h4>Continue independently</h4>
            <p>Follow the chosen actions and keep the personal report and reflections close at hand.</p>
          </li>
          <li class="fl-path fl-path--sky">
            <span class="fl-ico" set:html={svg("briefcase")} />
            <h4>Continue with their advisor</h4>
            <p>With explicit permission, the advisor receives a useful summary and conversation prompts. The system manages follow-ups; the advisor gains no admin.</p>
          </li>
          <li class="fl-path fl-path--heart">
            <span class="fl-ico" set:html={svg("compass")} />
            <h4>Work with DoGood</h4>
            <p>A voluntary path to a Wayfinder conversation and, where it fits, deeper DoGood support. Nothing is sold or referred because of a wheel score.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ===== Automation engine ===== -->
    <section class="fl-band fl-band--dark" aria-labelledby="fl-engine">
      <div class="fl-wrap">
        <p class="fl-eyebrow fl-eyebrow--light">The automation engine</p>
        <h2 id="fl-engine">Handles the routine work, <em>so nobody has to.</em></h2>
        <ul class="fl-engine">
          <li><span set:html={svg("link")} /><strong>Personal links</strong><small>One link per advisor</small></li>
          <li><span set:html={svg("report")} /><strong>Private reflection report</strong><small>For the founder first</small></li>
          <li><span set:html={svg("shield")} /><strong>Explicit sharing consent</strong><small>The founder decides what is shared</small></li>
          <li><span set:html={svg("mail")} /><strong>Email follow-ups</strong><small>Discreet, opt-in reminders</small></li>
          <li><span set:html={svg("calendar")} /><strong>Booking and referral routing</strong><small>To a Wayfinder, when asked</small></li>
        </ul>
      </div>
    </section>

    <!-- ===== Advisor workspace ===== -->
    <section class="fl-band" aria-labelledby="fl-advisor">
      <div class="fl-wrap fl-adv-grid">
        <div>
          <p class="fl-eyebrow">For advisors and CEPAs</p>
          <h2 id="fl-advisor">The advisor workspace stays <em>intentionally small.</em></h2>
          <p class="fl-intro fl-intro--left">One link to share. A clear overview. Only what the founder has agreed to share.</p>
          <ul class="fl-adv-points">
            <li><span set:html={svg("link")} />One link to share</li>
            <li><span set:html={svg("report")} />A low-effort overview</li>
            <li><span set:html={svg("shield")} />Consent-led information</li>
            <li><span set:html={svg("chat")} />Suggested conversation prompts</li>
            <li><span set:html={svg("compass")} />A path to DoGood specialist help</li>
          </ul>
        </div>
        <div class="fl-laptop" aria-hidden="true">
          <div class="fl-laptop-screen">
            <div class="fl-lp-side">
              <p class="fl-lp-brand">foundr<span>.</span>land</p>
              <p class="fl-lp-role">Advisor</p>
              <span class="is-on">Overview</span>
              <span>My links</span>
              <span>Founder journeys</span>
              <span>Resources</span>
              <span>DoGood support</span>
            </div>
            <div class="fl-lp-main">
              <p class="fl-lp-title">Your founder journeys</p>
              <div class="fl-lp-stats">
                <div class="fl-lp-stat fl-lp-stat--play"><strong>4</strong><span>Invited</span></div>
                <div class="fl-lp-stat fl-lp-stat--grass"><strong>2</strong><span>Active</span></div>
                <div class="fl-lp-stat fl-lp-stat--sky"><strong>1</strong><span>Shared with consent</span></div>
              </div>
              <div class="fl-lp-link">
                <span>foundr.land/join/your-firm</span>
                <b>Copy link</b>
              </div>
              <div class="fl-lp-cards">
                <div class="fl-lp-card">
                  <p>Suggested conversation</p>
                  <small>“What feels hardest to imagine about stepping away?”</small>
                </div>
                <div class="fl-lp-card fl-lp-card--heart">
                  <p>Specialist backup</p>
                  <small>Optional Wayfinder support, with founder permission.</small>
                </div>
              </div>
            </div>
          </div>
          <div class="fl-laptop-base"></div>
          <p class="fl-mock-note">Illustrative screen</p>
        </div>
      </div>
    </section>

    <!-- ===== Trust ===== -->
    <section class="fl-band fl-band--soft" aria-labelledby="fl-trust">
      <div class="fl-wrap">
        <p class="fl-eyebrow">Privacy and boundaries</p>
        <h2 id="fl-trust">Trust is a <em>core feature.</em></h2>
        <ul class="fl-trust">
          <li class="fl-trust-card fl-trust-card--grass">
