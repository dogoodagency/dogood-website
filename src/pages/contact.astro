---
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
import { edgeAbove } from "../data/edge-line";

const thanks = Astro.url.searchParams.has("thanks");
const sky = "#F2F7FF";
const heroEdge = edgeAbove("#2A0B4F");
const footerEdge = edgeAbove(sky);
---

<Base
  title="Contact | DoGood Agency"
  description="Let's talk. Founders can apply for Stage 1. Press, podcasts and general questions can send a short message."
  canonical="https://www.dogoodagency.co/contact"
  hideOptin={true}
  footerStrip={sky}
  footerEdge={footerEdge}
>
  <article class="page-privacy page-contact" style={`--band-tint:${sky}`}>
    <header class="privacy-hero">
      <div class="privacy-hero-inner">
        <h1>Let's talk</h1>
      </div>
      <Wave fill={sky} edge={heroEdge} />
    </header>

    <section class="privacy-band privacy-band-tint">
      <div class="privacy-well">
        <p class="contact-lead">
          Whether you've recently sold your company or you advise founders who have, this is the quickest way to reach us.
        </p>
        <div class="contact-top">
          <div class="contact-main">
            <h2>Everything else</h2>
            <p>Press, podcasts and general questions.</p>
            {
              thanks ? (
                <p class="contact-thanks">Thank you. Your message is with us.</p>
              ) : (
                <form class="contact-form" name="contact" method="POST" action="/contact?thanks" data-netlify="true" data-netlify-honeypot="bot-field">
                  <input type="hidden" name="form-name" value="contact" />
                  <p class="hp" hidden>
                    <label>Don't fill this out <input name="bot-field" /></label>
                  </p>
                  <label for="contact-name">Name</label>
                  <input id="contact-name" name="name" type="text" autocomplete="name" required />
                  <label for="contact-email">Email</label>
                  <input id="contact-email" name="email" type="email" autocomplete="email" required />
                  <label for="contact-role">I am a…</label>
                  <select id="contact-role" name="role" required>
                    <option value="">Choose one</option>
                    <option>Founder</option>
                    <option>Advisor</option>
                    <option>Press or podcast</option>
                    <option>Other</option>
                  </select>
                  <label for="contact-message">Message</label>
                  <textarea id="contact-message" name="message" rows="5" required />
                  <button class="btn-teal" type="submit">Send</button>
                </form>
              )
            }
            <p class="contact-privacy">We use this only to reply to you. <a href="/privacy">Privacy policy</a></p>
          </div>
          <aside class="contact-side">
            <picture class="contact-sketch">
              <source type="image/webp" srcset="/sketches/contact-letterbox@1x.webp 540w, /sketches/contact-letterbox@2x.webp 1080w" sizes="(max-width: 800px) min(100vw, 420px), 360px" />
              <img src="/sketches/contact-letterbox@1x.png" srcset="/sketches/contact-letterbox@1x.png 540w, /sketches/contact-letterbox@2x.png 1080w" sizes="(max-width: 800px) min(100vw, 420px), 360px" width="540" height="400" alt="A wall letterbox with its flag raised and a teal envelope halfway in the slot, with a small pink stamp." />
            </picture>
            <p class="contact-newsletter"><a href="/newsletter">Not ready yet? That's okay. Fuel up, stay ready →</a></p>
          </aside>
        </div>
        <iframe
          class="contact-map"
          title="Map showing DoGood Agency LLC at 30 N Gould St Ste N, Sheridan, Wyoming"
          src="https://www.google.com/maps?q=44.7977708,-106.9549504&z=16&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <p class="contact-address"><strong>DoGood Agency LLC</strong>, 30 N Gould St Ste N, Sheridan WY 82801, United States</p>
        <p class="contact-ioda">Proud member of IODA, a global network of OD professionals spanning 50+ countries</p>
      </div>
    </section>
  </article>
</Base>
