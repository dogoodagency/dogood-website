---
import Base from "../layouts/Base.astro";

const thanks = Astro.url.searchParams.has("thanks");
const apply = "https://form.jotform.com/DoGoodAgency/frp-stage-1";
---

<Base
  title="Contact | DoGood Founders"
  description="Let's talk. Founders can apply for Stage 1, advisors can book an intro call, and everyone else can send a short message."
  canonical="https://www.dogoodagency.co/contact"
  hideOptin={true}
>
  <section class="contact">
    <div class="contact-intro">
      <div>
        <h1 class="t-display">Let's talk.</h1>
        <p class="contact-sub">
          Whether you're a founder thinking about what's next, or an advisor with a client in mind, here is the quickest way to reach us.
        </p>
        <p class="contact-email"><a href="mailto:hiya@dogoodagency.co">hiya@dogoodagency.co</a></p>
      </div>
      <picture class="contact-sketch">
        <source type="image/webp" srcset="/sketches/contact-letterbox@1x.webp 540w, /sketches/contact-letterbox@2x.webp 1080w" sizes="(max-width: 1080px) min(100vw, 540px), 540px" />
        <img src="/sketches/contact-letterbox@1x.png" srcset="/sketches/contact-letterbox@1x.png 540w, /sketches/contact-letterbox@2x.png 1080w" sizes="(max-width: 1080px) min(100vw, 540px), 540px" width="540" height="400" alt="A wall letterbox with its flag raised and a teal envelope halfway in the slot, with a small pink stamp." />
      </picture>
    </div>
    <div class="contact-routes">
      <article class="card contact-card">
        <h2 class="t-h3">Ready to start?</h2>
        <p>Stage 1 is the private 30-day engagement.</p>
        <a class="btn-apply" href={apply}>Apply for Stage 1</a>
      </article>
      <article class="card contact-card">
        <h2 class="t-h3">Have a client in mind?</h2>
        <p>Advisors can book a short introduction with Seb.</p>
        <a class="btn-teal" href="/internal">Book an intro call</a>
      </article>
      <article class="card contact-card">
        <h2 class="t-h3">Everything else</h2>
        <p>Press, podcasts, and general questions. Founders and advisors should use the paths above.</p>
        {
          thanks ? (
            <p class="contact-thanks">Thank you. Your message is with us.</p>
          ) : (
            <form class="contact-form" name="contact" method="POST" action="/contact?thanks" data-netlify="true" data-netlify-honeypot="bot-field">
              <input type="hidden" name="form-name" value="contact" />
              <p class="hp" hidden>
                <label>Don't fill this out <input name="bot-field" /></label>
              </p>
              <label for="contact-name">Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required />
              <label for="contact-email">Email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" required />
              <label for="contact-role">I am a…</label>
              <select id="contact-role" name="role" required>
                <option value="">Choose one</option>
                <option>Founder</option>
                <option>Advisor</option>
                <option>Press or podcast</option>
                <option>Other</option>
              </select>
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="5" required />
              <button class="btn-teal" type="submit">Send</button>
            </form>
          )
        }
        <p class="contact-email"><a href="mailto:hiya@dogoodagency.co">hiya@dogoodagency.co</a></p>
        <p>If you apply for Stage 1, we'll respond within 24 hours. If there's a fit, we'll have an honest conversation.</p>
        <p class="contact-privacy">We use this only to reply to you. <a href="/privacy">Privacy policy</a></p>
      </article>
    </div>
  </section>
</Base>
