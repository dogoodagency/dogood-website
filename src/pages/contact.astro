---
import Base from "../layouts/Base.astro";
import { urls } from "../data/homepage";

const thanks = Astro.url.searchParams.has("thanks");
---

<Base>
  <section class="contact">
    <div class="contact-intro">
      <h1 class="t-display">Let’s talk.</h1>
      <p class="contact-sub">
        Whether you’re a founder thinking about what’s next or an advisor with a client in mind, here’s
        the quickest way to reach us.
      </p>
    </div>
    <div class="contact-routes">
      <article class="card contact-card">
        <h2 class="t-h3">Ready to start?</h2>
        <p>Stage 1 is the private 30-day engagement.</p>
        <a class="btn-apply" href={urls.apply}>Apply for Stage 1</a>
      </article>
      <article class="card contact-card">
        <h2 class="t-h3">Have a client in mind?</h2>
        <p>Advisors can book a short introduction.</p>
        <a class="btn-outline" href="https://tidycal.com/dogoodagency" rel="noopener noreferrer">
          Book an intro call
        </a>
      </article>
      <article class="card contact-card">
        <h2 class="t-h3">Everything else</h2>
        <p>Press, podcasts, and general questions.</p>
        {
          thanks ? (
            <p class="contact-thanks">Thank you. Your message is with us.</p>
          ) : (
            <form
              class="contact-form"
              name="contact"
              method="POST"
              action="/contact?thanks"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="hp" hidden>
                <label>
                  Don’t fill this out <input name="bot-field" />
                </label>
              </p>
              <label for="contact-name">Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required />
              <label for="contact-email">Email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" required />
              <label for="contact-role">I am a…</label>
              <select id="contact-role" name="role" required>
                <option value="">Choose one</option>
                <option value="founder">Founder</option>
                <option value="advisor">Advisor</option>
                <option value="press or podcast">Press or podcast</option>
                <option value="other">Other</option>
              </select>
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="5" required />
              <button class="btn-apply" type="submit">Send</button>
              <p class="contact-privacy">
                We use this only to reply to you.{" "}
                <a href="https://www.dogoodagency.co/privacy-policy">Privacy policy</a>
              </p>
            </form>
          )
        }
        <p class="contact-email">hiya@dogoodagency.co</p>
      </article>
    </div>
  </section>
</Base>
