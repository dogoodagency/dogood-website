---
import Wave from "../components/Wave.astro";
import WriteToUs from "../components/WriteToUs.astro";
import Base from "../layouts/Base.astro";
import { sevenQuestionContext, sevenQuestions, sevenQuestionsPdf } from "../data/seven-questions";

const heading = "The 7 questions for the first 90 days after the sale";
const description = "Seven questions for founders in the first 90 days after selling their company. Worth reading before you sell, too. A PDF from DoGood's founder coaching team.";
---

<Base
  title={`${heading} | DoGood coaching`}
  description={description}
  canonical="https://www.dogoodagency.co/seven-questions"
  robots="noindex, nofollow"
  ogTitle={heading}
  ogImage="/og/seven-questions-1200x627.jpg"
  ogImageHeight={627}
  bare
>
  <header class="r4-seven-hero">
    <div class="r4-seven-hero-inner">
      <img class="seven-logo" src="/logo-light.svg" width="4861" height="2195" alt="DoGood Agency" />
      <div class="seven-heading">
        <h1>{heading}</h1>
        <p class="seven-subline">Worth reading before you sell, too.</p>
      </div>
    </div>
    <Wave fill="#F5F2FF" edge="#15012E" />
  </header>
  <div class="seven-page">
    <section class="seven-guide" aria-labelledby="seven-guide-title">
      <div class="seven-fan">
        <img
          class="seven-fan-cover"
          src="/media/r10/seven-questions@1x.webp"
          srcset="/media/r10/seven-questions@1x.webp 600w, /media/r10/seven-questions@2x.webp 1200w"
          sizes="(max-width: 600px) 86vw, (max-width: 960px) 520px, 460px"
          width="600"
          height="401"
          alt="The 7 Questions guide: Seven questions for the first 90 days, an open booklet and its cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="seven-guide-copy">
        <p class="seven-eyebrow">Our gift to you</p>
        <!-- R6-NEWCOPY: "What's in the guide" -->
        <h2 id="seven-guide-title">What's in the guide</h2>
        <p class="seven-guide-gift">Yours to keep. Nothing asked in return.</p>
        <!-- R6-NEWCOPY: "For each question:" (the four items are the existing /newsletter line, split) -->
        <p class="seven-guide-lead">For each question:</p>
        <ul class="seven-guide-list" role="list">
          <li>More context</li>
          <li>The questions behind it</li>
          <li>A short exercise</li>
          <li>Journal prompts</li>
        </ul>
        <a class="btn-teal btn-dream" href={sevenQuestionsPdf} target="_blank" rel="noopener">Download the PDF</a>
      </div>
    </section>

    <!-- R7.A1: the question cards now sit below the guide/opt-in frame. -->
    <section class="seven-qs" aria-label="The seven questions">
      <p class="seven-intro">Take your time with them. There are no right answers, only honest ones.</p>
      <ol class="seven-cards" role="list">
        {sevenQuestions.map((question, index) => (
          <li class="seven-card">
            <span class="seven-number" aria-hidden="true">{index + 1}</span>
            <div class="seven-card-body">
              <p class="seven-q">{question}</p>
              <p class="seven-context">{sevenQuestionContext[index]}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="seven-followup">
      <p>Want the next notes too? <a href="/newsletter#signup">Get the DoGood newsletter</a>, one email every two weeks.</p>
      <WriteToUs />
    </div>
  </div>
</Base>

<style>
  .seven-page {
    min-height: 100svh;
    max-width: 1208px;
    margin-inline: auto;
    padding: 32px 64px calc(80px + 32px);
    color: var(--color-dream-500);
  }

  .seven-logo {
    display: block;
    width: 128px;
    height: auto;
    margin-inline: auto;
    pointer-events: none;
  }

  .seven-heading {
    max-width: 960px;
    margin: 48px auto;
    text-align: center;
  }

  .seven-heading h1 {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.15;
    text-wrap: balance;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-heading h1 { font-size: 46px; }
  }


  .seven-heading .seven-subline {
    margin-top: 24px;
    font-size: var(--hero-subline-size);
    font-weight: var(--hero-subline-weight);
    line-height: var(--hero-subline-leading);
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-heading .seven-subline { font-size: calc(var(--hero-subline-size) - 2px); }
  }


  /* R6.34: numbered question cards, then the guide block (fanned pages + bullets + download). */
  .seven-intro {
    max-width: 720px;
    margin: 0 auto 32px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.6;
    text-align: center;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-intro { font-size: 16px; }
  }


  .seven-qs { margin-top: 64px; }

  .seven-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .seven-card {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: start;
    gap: 20px;
    padding: 28px 32px;
    border: 1px solid #C2B7DD;
    border-radius: 20px;
    background: var(--color-white);
  }

  .seven-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc((100% - 24px) / 2);
  }

  .seven-number {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-grass-500);
    color: var(--color-dream-500);
    font-size: 18px;
    font-weight: 800;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-number { font-size: 16px; }
  }


  .seven-card .seven-q {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.35;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-card .seven-q { font-size: 18px; }
  }


  .seven-card .seven-context {
    margin: 0;
    color: #58447F;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-card .seven-context { font-size: 14px; }
  }


  .seven-guide {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    margin-top: 0;
    padding: 56px;
    border: 1px solid #A3F2D7;
    border-radius: 24px;
    background: #E7FFF6;
  }

  /* R10: one transparent mockup (landscape, 600x401) replaces the cover and the fanned pages. */
  .seven-fan {
    position: relative;
    width: 100%;
  }

  .seven-fan img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border: 0;
    border-radius: 0;
    background: none;
    pointer-events: none;
  }

  .seven-guide-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .seven-eyebrow {
    margin: 0 0 12px;
    color: var(--color-grass-700);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-eyebrow { font-size: 14px; }
  }


  .seven-guide-copy h2 {
    margin: 0;
    font-size: 36px;
    font-weight: 800;
    line-height: 1.15;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-guide-copy h2 { font-size: 34px; }
  }


  .seven-guide-gift {
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.5;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-guide-gift { font-size: 16px; }
  }


  .seven-guide-lead {
    margin: 20px 0 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-guide-lead { font-size: 16px; }
  }


  .seven-guide-list {
    display: grid;
    gap: 12px;
    margin: 16px 0 32px;
    padding: 0;
    list-style: none;
  }

  .seven-guide-list li {
    position: relative;
    padding-left: 36px;
    font-size: 18px;
    line-height: 1.5;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-guide-list li { font-size: 16px; }
  }


  .seven-guide-list li::before {
    content: "";
    position: absolute;
    top: 2px;
    left: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-grass-500);
  }

  .seven-guide-list li::after {
    content: "";
    position: absolute;
    top: 7px;
    left: 9px;
    width: 6px;
    height: 11px;
    border: solid var(--color-dream-500);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .seven-followup {
    display: grid;
    justify-items: center;
    gap: 24px;
    max-width: 820px;
    margin: 48px auto 0;
    text-align: center;
  }

  .seven-followup p {
    font-size: 16px;
    line-height: 1.6;
  }
  /* R15.10 */
  @media (min-width: 744px) and (max-width: 1279px), (min-width: 1280px) and (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    :global(html:not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15):not(#r15)) .seven-followup p { font-size: 14px; }
  }


  .seven-followup p a {
    color: var(--color-dream-500);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-grass-700);
    text-underline-offset: 4px;
  }

  .seven-followup p a:is(:hover, :focus-visible) {
    color: var(--color-grass-700);
    text-decoration-thickness: 3px;
  }

  .seven-guide .btn-dream:focus-visible {
    outline: 3px solid var(--color-grass-700);
    outline-offset: 3px;
  }

  @media (max-width: 960px) {
    .seven-guide { grid-template-columns: minmax(0, 1fr); gap: 40px; padding: 48px 40px; }
    .seven-fan { max-width: 520px; width: 100%; margin-inline: auto; }
    .seven-guide-copy { width: 100%; max-width: 520px; margin-inline: auto; }
  }

  @media (max-width: 720px) {
    .seven-cards { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .seven-card:last-child:nth-child(odd) { width: 100%; }
  }

  @media (max-width: 600px) {
    .seven-page { padding: 24px 24px 64px; }
    .seven-heading { margin: 32px auto; }
    .seven-heading h1 { font-size: 32px; }
    .seven-intro { margin-bottom: 24px; font-size: 17px; }
    .seven-card { grid-template-columns: 32px minmax(0, 1fr); gap: 14px; padding: 20px; }
    .seven-number { width: 32px; height: 32px; font-size: 16px; }
    .seven-card .seven-q { font-size: 18px; }
    .seven-qs { margin-top: 48px; }
    .seven-guide { gap: 28px; margin-top: 0; padding: 28px 20px 32px; }
    .seven-guide-copy h2 { font-size: 28px; }
    .seven-guide-lead, .seven-guide-list li { font-size: 17px; }
    .seven-guide-list { margin-bottom: 28px; }
    .seven-followup { margin-top: 32px; }
    .seven-followup p { overflow-wrap: anywhere; }
  }

  @media (max-width: 599px) {
    .seven-page { padding-bottom: calc(64px + 48px); }
  }
</style>
