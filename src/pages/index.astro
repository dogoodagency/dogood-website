import TestimonialWall from "../components/TestimonialWall.astro";

const portraits = import.meta.glob<ImageMetadata>("../assets/reviews/*", {
  eager: true,
  import: "default",
});

function fromMap(map: Record<string, ImageMetadata>, file: string) {
  const found = Object.entries(map).find(([path]) => path.endsWith(`/${file}`));
  if (!found) throw new Error(`Missing image ${file}`);
  return found[1];
}

const reviewSet = reviews.map((review) => ({
  ...review,
  src: review.file ? fromMap(portraits, review.file) : undefined,
}));

const wallItems = reviewSet.map((r) => ({ quote: r.quote, name: r.name, role: r.role, image: r.src }));
// Phones: the five reviews closest to life after the exit (Seb, 20 Nov 2026: "choose 5 of the most relevant").
const phonePick = phonePicks.home;
const phoneWall = phonePick.map((n) => wallItems.find((w) => w.name === n)).filter((w): w is (typeof wallItems)[number] => !!w);

// DREAM 400 press logos (public/media/press, all 96px high). `h` = shown height in px, set by eye so the
// six marks carry equal visual weight.
const pressLogos = [
  { file: "globe-and-mail.png", name: "The Globe and Mail", w: 96, h: 52 },
  { file: "fox.png", name: "FOX", w: 223, h: 32 },
  { file: "chronicle-journal.png", name: "The Chronicle Journal", w: 268, h: 42 },
  { file: "benzinga.png", name: "Benzinga", w: 677, h: 24 },
  { file: "starkville-daily-news.png", name: "Starkville Daily News", w: 544, h: 36 },
  { file: "ncn.png", name: "ncn", w: 162, h: 40 },
];


const beforeSale = [
  "You still run your company and are thinking about selling, or aren't sure you want to.",
  "Your advisors are getting the business ready, and nobody is getting you ready.",
  "You can't yet picture life without the company.",
];

const afterSale = [
  "You have sold or stepped away from the company.",
  "You have more freedom than before, but it doesn't feel the way you expected.",
  "You want to choose what comes next on purpose.",
  "You can protect 5–6 hours a week for 30 days.",
];

