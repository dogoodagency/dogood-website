  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) {
      const counters = document.querySelectorAll("[data-count]");
      const format = (el, value) => {
        const prefix = el.dataset.prefix ?? "";
        const suffix = el.dataset.suffix ?? "";
        const decimals = Number(el.dataset.decimals ?? "0");
        const shown = decimals
          ? value.toFixed(decimals)
          : Math.round(value).toLocaleString("en-US");
        el.textContent = `${prefix}${shown}${suffix}`;
      };
      const start = (el) => {
        const target = Number(el.dataset.count);
        const begin = performance.now();
        const duration = 1800;
        const tick = (now) => {
          const progress = Math.min(1, (now - begin) / duration);
          const eased = 1 - (1 - progress) ** 3;
          format(el, target * eased);
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const group = document.querySelector("[data-count-group]");
      if (group) {
        let started = false;
        const observer = new IntersectionObserver(
          (entries) => {
            if (started || !entries.some((entry) => entry.isIntersecting)) return;
            started = true;
            observer.disconnect();
            counters.forEach((el) => {
              if (el instanceof HTMLElement) start(el);
            });
          },
          { threshold: 0.35 },
        );
        observer.observe(group);
      }
    }
  </script>
  <script>
    const driftCards = [...document.querySelectorAll(".drift-card")];
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const wide = window.matchMedia("(min-width: 601px)");
    const active = new Set();
    const half = () => (wide.matches ? 105 : 52);
    const layoutTop = (el) => {
      const previous = el.style.transform;
      el.style.transform = "none";
      const top = el.getBoundingClientRect().top + window.scrollY;
      el.style.transform = previous;
      return top;
    };
    const shiftFor = (el) => {
      const travel = half();
      const progress = (window.scrollY + window.innerHeight - layoutTop(el)) / (window.innerHeight + el.offsetHeight);
      const t = Math.min(1, Math.max(0, progress));
      return travel - t * travel * 2;
    };
    let frame = 0;
    const paint = () => {
      frame = 0;
      if (reduceMotion.matches) {
        driftCards.forEach((el) => {
          el.style.transform = "";
          el.style.willChange = "";
        });
        return;
      }
      active.forEach((el) => {
        el.style.transform = `translate3d(0, ${shiftFor(el).toFixed(2)}px, 0)`;
      });
    };
    const queue = () => {
      if (frame) return;
      frame = requestAnimationFrame(paint);
    };
    const watcher = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const el = entry.target;
        if (!(el instanceof HTMLElement)) return;
        if (entry.isIntersecting) {
          el.style.willChange = "transform";
          active.add(el);
        } else {
          active.delete(el);
          el.style.willChange = "";
          if (!reduceMotion.matches) {
            const above = el.getBoundingClientRect().top < 0;
            el.style.transform = `translate3d(0, ${above ? -half() : half()}px, 0)`;
          }
        }
      });
      queue();
    }, { rootMargin: "100px 0px" });
    driftCards.forEach((el) => watcher.observe(el));
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    reduceMotion.addEventListener("change", queue);
    wide.addEventListener("change", queue);
    queue();
  </script>
  <script>
    import gsap from "gsap";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const narrow = window.matchMedia("(max-width: 600px)");

    const watch = (el, play, pause) => {
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) play();
        else pause();
      });
      io.observe(el);
    };

    const wing = document.querySelector(".fm-wing img");
    if (wing instanceof HTMLElement && !reduce.matches) {
      gsap.set(wing, { transformOrigin: "49.07% 41.52%" });
      const flap = gsap.fromTo(
        wing,
        { rotation: -3.3 },
        { rotation: 3.3, duration: 0.5, ease: "sine.inOut", yoyo: true, repeat: -1, paused: true },
      );
      watch(wing.closest(".fm-anim"), () => flap.play(), () => flap.pause());
    }

    const leaf = document.querySelector(".door-leaf img");
    if (leaf instanceof HTMLElement) {
      gsap.set(leaf, { transformOrigin: "87.63% 28.8%", scaleX: 1 });
      let gust = null;
      const stop = () => {
        gust?.kill();
        gust = null;
        gsap.set(leaf, { scaleX: 1 });
      };
      const play = () => {
        if (gust || reduce.matches || narrow.matches) return;
        const r = gsap.utils.random;
        gust = gsap
          .timeline({
            onComplete: () => {
              gust = null;
              play();
            },
          })
          .to(leaf, { scaleX: r(0.86, 0.93), duration: r(1.25, 1.75), ease: "sine.inOut" })
          .to(leaf, { scaleX: r(1.07, 1.14), duration: r(1.25, 1.75), ease: "sine.inOut" })
          .to(leaf, { scaleX: 1, duration: r(1.2, 1.6), ease: "sine.inOut" })
          .to({}, { duration: Math.random() < 0.35 ? r(1.5, 3) : r(0, 0.4) });
      };
      watch(leaf.closest(".door-anim"), play, stop);
      narrow.addEventListener("change", () => {
        stop();
        if (!narrow.matches) play();
      });
    }
  </script>
