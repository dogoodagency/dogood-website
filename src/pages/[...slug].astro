---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import LogoPills from "../components/LogoPills.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages
    .filter((page) => page.id !== "error404" && page.id !== "contact")
    .map((page) => ({ params: { slug: page.id } }));
}

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/");
const entry = await getEntry("pages", slug);
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);
const canonical = new URL(slug, "https://www.dogoodagency.co/").href;

const pageNames: Record<string, string> = {
  about: "About",
  "application-thankyou": "Application received",
  "apply-stage-1": "Apply for Stage 1",
  benchmark: "Benchmark",
  "casestudies/j": "How J created a clear next life chapter",
  "casestudies/v": "How V reclaimed life after success",
  casestudies: "Stories",
  catchup: "Catch-up call",
  "catchup-thankyou": "Catch-up call booked",
  chat: "Chat",
  "clarity-first-guarantee-terms": "Clarity-First Guarantee",
  claritysprints: "Clarity Sprints",
  "claritysprints-thankyou": "Clarity Sprints booked",
  cleansudaji: "CleanSudaji",
  contact: "Contact",
  cookies: "Cookies Policy",
  diagnostics: "Founder Diagnostic",
  "diagnostics/founder-check": "Founder Diagnostic",
  "diagnostics/results-businesscrisis": "Diagnostic result",
  "diagnostics/results-hr": "Diagnostic result for people leaders",
  "diagnostics/results-nonfounder": "Diagnostic result",
  "dogood-insider": "DoGood Insider",
  faqs: "FAQs",
  "for-advisors": "For Advisors",
  frpfit: "FRP-Fit call",
  "frpfit-thankyou": "FRP-Fit call booked",
  "how-it-works": "How it works",
  insights: "Insights",
  "insights/after-the-deal": "After the deal closes",
  "insights/first-months-after-exit": "The first months after exit",
  "insights/who-are-you-now": "Who are you now",
  internal: "An introduction for advisors",
  "internal-60": "An introduction for advisors",
  "internal-thankyou": "Introduction booked",
  newsletter: "The first 90 days after exit",
  "newsletter/thanks": "You're on the list",
  "orientation-call": "Orientation call",
  "orientation-call-thankyou": "Orientation call booked",
  "podcast-chat": "Podcast chat",
  "pre-frp": "Pre-FRP call",
  "prefrp-thankyou": "Pre-FRP call booked",
  privacy: "Privacy Policy",
  "stage1-tc": "Stage 1",
  stories: "Stories",
  teams: "Team readiness",
  "teams-thankyou": "Team readiness booked",
  terms: "Terms of Use",
  "thank-you": "Thank you",
  wayfinders: "Wayfinders",
  "wayfinders/chantill": "Chantill",
  "wayfinders/clientfit": "Client-Fit",
  "wayfinders/katrin": "Katrin",
  "wayfinders/seb": "Seb",
  "wayfinders/shiva": "Shiva",
  "wayfinders/vlora": "Vlora",
};

const named = pageNames[slug];
const stripped = entry.data.title.replace(/\s*\|\s*DoGood (Founders|Agency)\s*$/i, "").trim();
const pageTitle = named
  ? `${named} | DoGood Agency`
  : stripped && !/^[a-z0-9./-]+$/i.test(stripped)
    ? `${stripped} | DoGood Agency`
    : `${slug.split("/").pop()?.replace(/-/g, " ") ?? "DoGood"} | DoGood Agency`;
const genericDescription = entry.data.description.startsWith("Founder Reclamation Partnership");
const pageDescription = genericDescription
  ? `${named ?? "This page"} from DoGood Agency, a private partnership for founders after exit.`
  : entry.data.description;
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  hideOptin={entry.data.hideOptin}
>
  <article class:list={["page", entry.data.advisorLine && "page-advisor", ["how-it-works", "for-advisors", "stories", "wayfinders", "newsletter", "diagnostics", "faqs", "insights", "dogood-insider", "apply-stage-1", "clarity-first-guarantee-terms", "casestudies/j", "casestudies/v", "about"].includes(slug) && "page-art"]}>
    <div class="page-wrap">
      {entry.data.advisorLine && (
        <svg class="advisor-line" viewBox="0 0 40 640" preserveAspectRatio="none" aria-hidden="true">
          <path
            id="advisor-line-path"
            d="M20 8 C 8 80, 32 140, 20 220 C 8 300, 32 380, 20 470 C 10 540, 28 590, 20 632"
            fill="none"
            stroke="#28DBB0"
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
      )}
      <div class="page-body">
        <Content />
      </div>
      {slug === "stories" && <LogoPills />}
      {
        entry.data.tidycal && (
          <div class="tidycal-embed" data-path={entry.data.tidycal}></div>
        )
      }
      {
        slug === "dogood-insider" && (
          <div class="buzzsprout-gate" data-buzzsprout-src="https://www.buzzsprout.com/2435557">
            <button type="button">Load the podcast player</button>
          </div>
        )
      }
    </div>
  </article>
</Base>

{
  entry.data.tidycal && (
    <script is:inline src="https://asset-tidycal.b-cdn.net/js/embed.js" async></script>
  )
}

<script>
  const wave = document.querySelector("#advisor-line-path");
  if (wave instanceof SVGPathElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const paint = (progress) => {
      const length = wave.getTotalLength();
      wave.style.strokeDasharray = `${length}`;
      wave.style.strokeDashoffset = reduce.matches ? "0" : String(length * (1 - progress));
    };
    const update = () => {
      if (reduce.matches) return paint(1);
      const rect = wave.getBoundingClientRect();
      const start = window.innerHeight * 0.9;
      const finish = window.innerHeight * 0.2;
      paint(Math.min(1, Math.max(0, (start - rect.top) / Math.max(1, start - finish))));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  document.querySelectorAll("[data-buzzsprout-src]").forEach((gate) => {
    gate.querySelector("button")?.addEventListener("click", () => {
      if (!(gate instanceof HTMLElement) || gate.querySelector("iframe")) return;
      const frame = document.createElement("iframe");
      frame.src = gate.dataset.buzzsproutSrc || "";
      frame.title = "DoGood Insider on Buzzsprout";
      frame.loading = "lazy";
      gate.replaceChildren(frame);
    });
  });
</script>
