---
import "../styles/apply.css";
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
import { urls } from "../data/homepage";
import { edgeAbove } from "../data/edge-line";
import caseJ from "../assets/cases/case-study-j-founder-life-after-exit.png";

const grass = "#F3FFFB";
const heroEdge = edgeAbove("#2A0B4F");
const footerEdge = edgeAbove("#FFFFFF");
// DG-PRE-57 (round 7): /apply-stage-1 is now the shared founder application chooser. The two forms are embedded on
// /apply-exit-prep and /apply-reset (the Reset route is Tec's proposal, so the chooser does not link to itself).
---

<Base
  title="Apply for Exit-Prep or Stage 1: founder applications | DoGood Agency"
  description="Apply for Exit-Prep or Stage 1, The Reset. The form takes 5–10 minutes and is reviewed within 24 hours."
  canonical="https://www.dogoodagency.co/apply-stage-1"
  footerStrip="#FFFFFF"
  footerEdge={footerEdge}
>
  <article class="page-apply apl" style={`--band-tint:${grass}`}>
    <header class="apl-hero">
      <div class="apl-hero-inner">
        <p class="apl-eyebrow">Apply</p>
        <h1>Founder applications</h1>
      </div>
      <Wave fill={grass} edge={heroEdge} />
    </header>

    <section class="apl-band">
      <div class="apl-well">
        <div class="apl-main">
          <picture class="apl-art">
            <source
              type="image/webp"
              srcset="/sketches/apply-stage-1-garden-gate@1x.webp 540w, /sketches/apply-stage-1-garden-gate@2x.webp 1080w"
              sizes="(max-width: 648px) calc(100vw - 48px), 600px"
            />
            <img
              src="/sketches/apply-stage-1-garden-gate@1x.png"
              srcset="/sketches/apply-stage-1-garden-gate@1x.png 540w, /sketches/apply-stage-1-garden-gate@2x.png 1080w"
              sizes="(max-width: 648px) calc(100vw - 48px), 600px"
              width="540"
              height="400"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
          </picture>

          <ul class="apl-facts" aria-label="About the application">
            <li><span aria-hidden="true">◷</span> Takes 5–10 minutes</li>
            <li><span aria-hidden="true">◎</span> Private</li>
          </ul>

          <ul class="r7-choose">
            <li class="r7-choice">
              <h2>Exit-Prep™</h2>
              <p class="r7-choice-for">For founders considering or preparing for a sale or navigating an ownership transition.</p>
              <p class="r7-choice-meta">Six weeks, fully remote.</p>
              <a class="btn-apply r5-button-heart" href="/apply-exit-prep">Apply for Exit-Prep™</a>
            </li>
            <li class="r7-choice">
              <h2>Stage 1: The Reset™</h2>
              <p class="r7-choice-for">For founders navigating life after the sale.</p>
              <p class="r7-choice-meta">30 days, including a 1.5-day in-person residency.</p>
              <a class="btn-apply r5-button-heart" href="/apply-reset">Apply for Stage 1: The Reset™</a>
            </li>
          </ul>
        </div>

        <section class="apl-process" aria-labelledby="apl-next-title">
        <h2 id="apl-next-title">What happens next</h2>
        <ol class="apl-next">
          <li><span class="apl-next-n">1</span><strong>You apply</strong><span>A short form, in your own words.</span></li>
          <li><span class="apl-next-n">2</span><strong>We read it</strong><span>Within 24 hours, by a person, in confidence.</span></li>
          <li><span class="apl-next-n">3</span><strong>We talk</strong><span>If we see a potential fit, we will invite you to a private FRP-Fit Call.</span></li>
        </ol>
        </section>
      </div>
    </section>

    <div class="apl-case-divider" aria-hidden="true"><div></div></div>

        <section id="case-j" class="apl-case-wrap" aria-label="Case study">
          <article class="case-compact">
            <img class="portrait" src={caseJ.src} width="220" height="244" alt="Pixelated portrait of founder J, shown this way to protect their identity" loading="lazy" decoding="async" />
            <div>
              <p class="t-kicker apl-eyebrow">Case Study</p>
              <h3>From exit anxiety to aligned legacy —<br />How J created a clear next life chapter</h3>
              <p class="caption case-who">J (anonymous), USD 2M founder</p>
              <div class="btn-stack">
                <div class="btn-with-caption">
                  <a class="btn-case r5-button-heart" href={urls.caseJ} aria-label="Read the short case study: how J created a clear next life chapter">Read the short case study</a>
                  <p class="case-protect">We protect our founders’ identities</p>
                </div>
              </div>
            </div>
          </article>
        </section>
  </article>
  <script>
    const process = document.querySelector(".apl-process");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (process && "IntersectionObserver" in window && !reduce.matches) {
      process.classList.add("apl-process--waiting");
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        process.classList.add("is-visible");
        observer.disconnect();
      }, { threshold: 0.25 });
      observer.observe(process);
      reduce.addEventListener("change", () => {
        if (reduce.matches) {
          process.classList.add("is-visible");
          observer.disconnect();
        }
      });
    }
  </script>
</Base>
