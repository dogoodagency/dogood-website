---
import { getCollection, render } from "astro:content";
import "../../styles/blog.css";
import Base from "../../layouts/Base.astro";
import BlogImage from "../../components/BlogImage.astro";
import BlogCard from "../../components/BlogCard.astro";
import BlogNewsletter from "../../components/BlogNewsletter.astro";
import AuthorByline from "../../components/AuthorByline.astro";
import { getAuthor } from "../../data/authors";
import Wave from "../../components/Wave.astro";
import { gitDate } from "../../lib/lastmod.mjs";
import { edgeAbove } from "../../data/edge-line";
import {
  SITE,
  audiences,
  formatDate,
  getCategory,
  isoDate,
  relatedPosts,
  sketchSrc,
} from "../../data/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all: posts },
  }));
}

const { post, all } = Astro.props;
// Keep the modification date in structured data only.
const lastUpdated: Date = (() => {
  const fromGit = gitDate(`src/content/blog/${post.id}.md`);
  const candidates = [post.data.updated, fromGit ? new Date(fromGit) : undefined, post.data.date].filter(Boolean) as Date[];
  return post.data.updated ?? new Date(Math.max(...candidates.map((x) => x.getTime())));
})();
const d = post.data;
const { headings } = await render(post);
const author = getAuthor(d.author);

// Newsletter box in the middle of the article (Seb, 18 Nov 2026): split the rendered body before the
// H2 closest to the middle, so readers see the sign-up while they read.
const bodyHtml = post.rendered?.html ?? "";
const h2At = [...bodyHtml.matchAll(/<h2[\s>]/g)].map((m) => m.index ?? 0);
const middle = bodyHtml.length / 2;
const splitAt = h2At.length > 1
  ? h2At.slice(1).reduce((best, i) => (Math.abs(i - middle) < Math.abs(best - middle) ? i : best), h2At[1]!)
  : -1;
const bodyFirst = splitAt > 0 ? bodyHtml.slice(0, splitAt) : bodyHtml;
const bodySecond = splitAt > 0 ? bodyHtml.slice(splitAt) : "";
const toc = headings.filter((h) => h.depth === 2);

const category = getCategory(d.category);
const aud = audiences[d.audience];
const url = `${SITE}/insights/${post.id}`;
const related = relatedPosts(post, all, 2);
const heroPng2 = sketchSrc(d.heroImage).png2;

const tint = "#F5F2FF";
const white = "#ffffff";
const footerEdge = edgeAbove(tint);
const bandEdge = edgeAbove(white);
const heroEdge = edgeAbove("#2A0B4F");

// Audience call to action.
let cta = {
  title: "See The Reset",
  text: "For founders who have already sold. Start with 30 days to reset, then build what comes next when you are ready.",
  href: "/the-reset",
  label: "See The Reset",
};
if (d.audience === "advisor") {
  cta = {
    title: "Advisor Center",
    text: "How a referral works, what your client gets, and how we keep you in the loop. We work next to you, never instead of you.",
    href: "/advisor-center",
    label: "Advisor Center",
  };
} else if (d.category === "preparing-for-exit") {
  cta = {
    title: "See Exit-Prep™",
    text: "For founders who haven't sold yet. Private weekly sessions to prepare yourself, not just the company.",
    href: "/exit-prep",
    label: "See Exit-Prep™",
  };
}

const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const blogPosting = json({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  image: `${SITE}${heroPng2}`,
  datePublished: d.date.toISOString(),
  dateModified: lastUpdated.toISOString(),
  author: {
    "@type": "Person",
    name: author.name,
    jobTitle: d.authorRole ?? author.role,
    ...(author.id === "seb"
      ? { "@id": `${SITE}/wayfinders/seb#person`, url: `${SITE}/wayfinders/seb` }
      : { url: `${SITE}/about` }),
  },
  publisher: {
    "@type": "Organization",
    "@id": `${SITE}/#organization`,
    name: "DoGood Agency",
    logo: { "@type": "ImageObject", url: `${SITE}/logo.svg` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  articleSection: category?.name,
  keywords: d.tags.join(", "),
  about: { "@type": "Audience", audienceType: aud.label },
});

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Insights", href: "/insights" },
  ...(category ? [{ name: category.name, href: `/insights/category/${category.slug}` }] : []),
  { name: d.title, href: `/insights/${post.id}` },
];
const breadcrumbJson = json({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    item: `${SITE}${b.href}`,
  })),
});

const faqJson = d.faq.length
  ? json({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: d.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })
  : "";
const titleBreaks: Record<string, string> = {
  "first-90-days-after-the-sale": "What to do after selling your business:",
  "sudden-wealth-syndrome-after-selling-a-business": "Sudden wealth syndrome",
  "why-deals-stall-when-the-founder-isnt-ready": "Why deals stall",
  "before-you-sign-preparing-yourself": "Before you sign: how to prepare yourself",
  "emotions-of-selling-a-business": "The emotions of selling a business:",
};
const titleStart = titleBreaks[post.id];
const titleEnd = titleStart && d.title.startsWith(titleStart) ? d.title.slice(titleStart.length).trimStart() : undefined;

---

<Base
  title={d.seoTitle ?? `${d.title} | DoGood Agency`}
  description={d.description}
  canonical={url}
  ogTitle={d.title}
  ogImage={heroPng2}
  ogType="article"
  robots={d.noindex ? "noindex, follow" : undefined}
  footerStrip={tint}
  footerEdge={footerEdge}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="DoGood Insights" href="/insights/rss.xml" />
    <script is:inline type="application/ld+json" set:html={blogPosting} />
    <script is:inline type="application/ld+json" set:html={breadcrumbJson} />
    {faqJson && <script is:inline type="application/ld+json" set:html={faqJson} />}
  </Fragment>

  <div class="bl-page bl-article">
    <header class="bl-topband r4-article-hero">
      <div class="r4-article-hero-inner">
        {d.sample && <p class="bl-sample" role="note">Sample article: placeholder text to show the layout.</p>}
        <div class="bl-head">
          <h1 class="r4-phrase-title">{titleEnd ? <>{titleStart}<br class="pp-desktop-break" /> {titleEnd}</> : d.title}</h1>
          <div class="bl-card-tags r6-article-tags">
            <span class:list={["bl-badge", `bl-badge--${d.audience}`]}>{aud.label}</span>
            {
              category && (
                <a class="bl-pill" href={`/insights/category/${category.slug}`}>
                  {category.name}
                </a>
              )
            }
          </div>
        </div>
      </div>
      <Wave fill={white} edge={heroEdge} />
    </header>

    <div class="bl-col bl-col--wide bl-article-summary r6-article-top">
      <p class="bl-back r6-article-back"><a href="/insights">← Back to Insights</a></p>
      <div class="bl-share r6-article-share" aria-label="Share this article">
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Share on LinkedIn</a>
        <button type="button" data-copy-article={url}>Copy link</button>
        <span class="bl-sr" data-copy-status role="status" aria-live="polite"></span>
      </div>
      <div class="bl-byline r6-article-byline">
        <AuthorByline author={d.author} role={d.authorRole} />
        <p class="bl-meta">
          <span>Published <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time></span>
          <span aria-hidden="true"> · </span>
          <span>{d.readTime} min read</span>
        </p>
      </div>
    </div>

    <div class="bl-col bl-col--wide">
      <BlogImage class="bl-hero-img" src={d.heroImage} alt={d.heroAlt} bg={d.heroBg} eager={true} />
    </div>

    <div class="bl-col bl-col--wide bl-intro">
      <p class="bl-isyou"><strong>Is this you?</strong> {d.isThisYou}</p>

      <section class="bl-short" aria-label="The short answer">
        <p class="bl-box-label">The short answer</p>
        <p class="bl-short-text">{d.shortAnswer}</p>
      </section>

      <!-- "Questions this answers" removed (Seb, 18 Nov 2026): it repeated "In this article". The questions stay in the frontmatter. -->
      {
        toc.length > 0 && (
          <nav class="bl-toc" aria-labelledby="bl-toc-title">
            <p class="bl-box-label" id="bl-toc-title">In this article</p>
            <ol>
              {
                toc.map((h, i) => (
                  <li>
                    <a href={`#${h.slug}`} data-article-section={h.slug}><span class="bl-toc-number" aria-hidden="true">{i + 1}</span><span>{h.text}</span></a>
                  </li>
                ))
              }
            </ol>
          </nav>
        )
      }

    </div>

    <div class="bl-col">
      <div class="bl-prose">
        <Fragment set:html={bodyFirst} />
      </div>
      {
        bodySecond && (
          <div class="bl-mid-nl">
            <BlogNewsletter idSuffix="article" />
          </div>
        )
      }
      {
        bodySecond && (
          <div class="bl-prose">
            <Fragment set:html={bodySecond} />
          </div>
        )
      }

      <section class="bl-takeaways" aria-labelledby="bl-takeaways-title">
        <h2 id="bl-takeaways-title">Key takeaways</h2>
        <ul>
          {d.takeaways.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      {
        d.faq.length > 0 && (
          <section class="bl-faq" aria-labelledby="bl-faq-title">
            <h2 id="bl-faq-title">Common questions</h2>
            {
              d.faq.map((f, i) => (
                <details class="bl-faq-item" open={i === 0}>
                  <summary>
                    <span class="bl-faq-q">{f.q}</span>
                    <span class="bl-faq-icon" aria-hidden="true"></span>
                  </summary>
                  <p class="bl-faq-a">{f.a}</p>
                </details>
              ))
            }
          </section>
        )
      }

      <aside class="bl-cta" aria-labelledby="bl-cta-title">
        <p class="bl-box-label bl-box-label--light">{aud.label}</p>
        <h2 id="bl-cta-title">{cta.title}</h2>
        <p>{cta.text}</p>
        <a class="btn-teal" href={cta.href}><span>{cta.label}</span></a>
        <p class="bl-cta-quiet">Not sure which? <a href="/pathway">See how it works</a></p>
      </aside>
    </div>

    {
      !bodySecond && (
        <div class="bl-col bl-col--wide">
          <BlogNewsletter idSuffix="article" />
        </div>
      )
    }

    <div class="bl-col bl-col--wide">
    <div class="bl-share" aria-label="Share this article">
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Share on LinkedIn</a>
      <button type="button" data-copy-article={url}>Copy link</button>
      <span class="bl-sr" data-copy-status role="status" aria-live="polite"></span>
    </div>
    </div>

    <div class="bl-more">
      <Wave fill={tint} edge={bandEdge} />
      <section class="bl-more-band" aria-labelledby="bl-more-title">
        <div class="bl-wrap">
          <h2 id="bl-more-title">Read next</h2>
          <div class="bl-grid">
            {related.map((p) => <BlogCard post={p} variant="grid" />)}
          </div>
          <p class="bl-back"><a href="/insights">← Back to Insights</a></p>
        </div>
      </section>
    </div>
  </div>
  <script src="/article.js" is:inline defer></script>
</Base>
