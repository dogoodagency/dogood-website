---
import BookingPage from "../components/BookingPage.astro";
import BookingCaseCard from "../components/BookingCaseCard.astro";
// DG-PRE-56 (round 7): one neutral purpose (no "two purposes", no ad-hoc client support). For uncertain prospects and
// edge cases who do not clearly fit a specific service.
---

<BookingPage
  title="Orientation Call"
  tidycal="dogoodagency/orientation-call"
  robots="noindex"
  ogImage="/media/og/orientation-og.jpg"
  seoTitle="Orientation Call | DoGood Agency"
  description="A short call to get oriented, clarify fit and timing, and choose the right next step (or a clear “not now”). Not a consult, audit, or strategy build-out."
  canonical="https://www.dogoodagency.co/orientation"
>
  <p>
    A short, neutral conversation to clarify your situation and identify <strong>an appropriate next step with DoGood or elsewhere</strong>.
  </p>

  <p>This call is for uncertain prospects and edge cases who do not clearly fit a specific service.</p>

  <p class="bk-label bk-tight">Know what you want?</p>
  <p>Re-route below to find more specific DoGood services.</p>

  <div class="bk-route">
    <p>
      <span class="bk-n bk-pink">1.</span> For founders who sold their company, got bought out or otherwise meaningfully stepped back. FRP begins with <strong>Stage 1: The Reset (30 days)</strong>.
    </p>
    <div class="bk-btn-row">
      <a class="btn-apply" href="/application">Apply for Stage 1</a>
    </div>

    <p>
      <span class="bk-n bk-pink">2.</span> Founders with <strong>$300k+ ARR</strong> seeking clarity through 1:1 work (non-FRP) to sharpen business, leadership and life.
    </p>
  </div>

  <p class="bk-label bk-tight">Still want to book the Orientation Call?</p>
  <p>Choose a date and time below.</p>

  <Fragment slot="after">
    <BookingCaseCard />
  </Fragment>
</BookingPage>
