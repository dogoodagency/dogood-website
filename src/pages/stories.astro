---
import "../styles/stories.css";
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
import { edgeAbove } from "../data/edge-line";
import { stories } from "../data/stories";
import { caseTeasers, logoRails } from "../data/stories-page";

const white = "#ffffff";
const tint = "#F5F2FF";
const logoBg = "#E9E3F7";
const heroEdge = edgeAbove("#2A0B4F");
const tintEdge = edgeAbove(tint);
const whiteEdge = edgeAbove(white);
const logoEdge = edgeAbove(logoBg);
const footerEdge = edgeAbove(white);

// Round-robin into columns: 3 for desktop, 2 for tablet.
const cols3 = [0, 1, 2].map((i) => stories.filter((_, idx) => idx % 3 === i));
const cols2 = [0, 1].map((i) => stories.filter((_, idx) => idx % 2 === i));
const logoDir = (dir: number) => (dir === 1 ? "1" : "-1");
---

<Base
  title="Stories | DoGood Agency"
  description="Anonymised stories from founders we have worked with, plus words from leaders at organisations our team has partnered with."
  canonical="https://www.dogoodagency.co/stories"
  footerStrip={white}
  footerEdge={footerEdge}
>
  <article class="st-page">
    <header class="st-hero">
      <div class="st-hero-inner">
        <div class="st-hero-copy">
          <h1>Stories</h1>
          <p>Two short, anonymised stories from founders we have worked with. We keep their names private so they can be candid.</p>
          <p>The reviews and logos below are from leaders and organisations our team has worked with. They are not all founders after an exit.</p>
        </div>
        <figure class="st-sketch-card">
          <picture>
            <source type="image/webp" srcset="/sketches/stories-journal-path-sketch@1x.webp 560w, /sketches/stories-journal-path-sketch@2x.webp 1120w" sizes="(max-width: 899px) min(100vw, 380px), 420px" />
            <img src="/sketches/stories-journal-path-sketch@1x.png" srcset="/sketches/stories-journal-path-sketch@1x.png 560w, /sketches/stories-journal-path-sketch@2x.png 1120w" sizes="(max-width: 899px) min(100vw, 380px), 420px" width="560" height="420" alt="A fine-liner sketch of an open journal on a table, a teal path drawn across the pages and continuing toward an open door, with a founder walking from the story onto the path." loading="eager" decoding="async" />
          </picture>
        </figure>
      </div>
      <Wave fill={tint} edge={heroEdge} />
    </header>

    <section class="st-band st-band-tint" aria-labelledby="st-cases-h">
      <div class="st-well">
        <h2 id="st-cases-h">Case studies</h2>
        <ul class="st-cases">
          {
            caseTeasers.map((c) => (
              <li class="st-case">
                <p class="st-case-eyebrow">Case study</p>
                <h3>
                  {c.headline} <span class="st-accent">{c.headlineAccent}</span>
                </h3>
                <p class="st-case-attr">{c.attribution}</p>
                <p class="st-case-intro">{c.intro}</p>
                {c.snapshot.map((text) => (
                  <p class="st-case-text">{text}</p>
                ))}
                <h4>The problem</h4>
                <p class="st-case-text st-problem">{c.problem}</p>
                <a class="btn-teal" href={c.href}>Read the full story →</a>
              </li>
            ))
          }
        </ul>
        <p class="st-anon">
          <strong>We protect our founders’ identities.</strong> Most founders we work with lead visible companies and public lives –– we don't ask them to tell the private parts of their story publicly. Anonymity lets founders be candid about their intimate work — without risking reputations, partnerships, or market fallout.
        </p>
      </div>
    </section>

    <div class="st-divider" style={`--st-from:${tint}`}>
      <Wave fill={white} edge={tintEdge} />
    </div>

    <section class="st-band st-testi" data-st-testi aria-labelledby="st-testi-h">
      <div class="st-well">
        <p class="st-eyebrow">Testimonials</p>
        <h2 id="st-testi-h">From leaders we have worked with</h2>
        <p class="st-note">These are words from leaders our team has worked with. They are not all founders after an exit.</p>

        <div class="st-pause-bar">
          <button class="st-pause" type="button" aria-pressed="false" data-st-pause>Pause testimonials</button>
        </div>

        <!-- Three vertical columns (1024px and up) -->
        <div class="st-vp st-vp-3">
          <div class="st-wall">
            {
              cols3.map((col) => (
                <div class="st-col">
                  <div class="st-track">
                    {[false, true].map((dup) =>
                      col.map((s) => (
                        <figure class="st-card" aria-hidden={dup ? "true" : undefined}>
                          <blockquote>
                            <p>{s.quote}</p>
                          </blockquote>
                          <figcaption>
                            <strong class="st-name">{s.name}</strong>
                            <span class="st-role">{s.role}</span>
                          </figcaption>
                        </figure>
                      )),
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Two vertical columns (600 to 1023px) -->
        <div class="st-vp st-vp-2">
          <div class="st-wall">
            {
              cols2.map((col) => (
                <div class="st-col">
                  <div class="st-track">
                    {[false, true].map((dup) =>
                      col.map((s) => (
                        <figure class="st-card" aria-hidden={dup ? "true" : undefined}>
                          <blockquote>
                            <p>{s.quote}</p>
                          </blockquote>
                          <figcaption>
                            <strong class="st-name">{s.name}</strong>
                            <span class="st-role">{s.role}</span>
                          </figcaption>
                        </figure>
                      )),
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Plain list: phones, reduced motion, and the no-script fallback -->
        <div class="st-list">
          {
            stories.map((s) => (
              <figure class="st-card">
                <blockquote>
                  <p>{s.quote}</p>
                </blockquote>
                <figcaption>
                  <strong class="st-name">{s.name}</strong>
                  <span class="st-role">{s.role}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <div class="st-divider" style={`--st-from:${white}`}>
      <Wave fill={logoBg} edge={whiteEdge} />
    </div>

    <section class="st-logos" aria-labelledby="st-logos-h">
      <div class="st-logos-head">
        <h2 id="st-logos-h">Leaders from these organisations have worked with our team</h2>
        <p class="st-note">These are organisations our team has worked with. They are not all founders after an exit.</p>
      </div>
      <div class="st-rails" role="group" aria-label="Organisations our team has worked with">
        {
          logoRails.map((rail) => (
            <div class="st-rail" data-st-rail data-dir={logoDir(rail.dir)} data-velocity={String(rail.velocity)}>
              <div class="st-rail-inner">
                <ul class="st-pattern" data-st-pattern>
                  {rail.logos.map((logo) =>
                    logo.kind === "icon" ? (
                      <li class="st-pill">
                        <span class="st-pill-vis">
                          <img src={`/media/stories/logos/${logo.file}`} width="128" height="128" alt="" loading="lazy" decoding="async" />
                        </span>
                        <p class="st-pill-name">{logo.name}</p>
                      </li>
                    ) : (
                      <li class="st-pill st-pill-word">
                        <span class="st-pill-vis st-pill-vis-word">
                          <img src={`/media/stories/logos/${logo.file}`} width={logo.width} height="96" alt={logo.name} loading="lazy" decoding="async" />
                        </span>
                      </li>
                    ),
                  )}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <div class="st-divider" style={`--st-from:${logoBg}`}>
      <Wave fill={white} edge={logoEdge} />
    </div>

    <section class="st-band" aria-labelledby="st-next">
      <div class="st-well">
        <div class="st-cta">
          <h2 id="st-next">What’s next?</h2>
          <p class="st-cta-lead">Complete the short application for Stage 1 (30 days). We’ll respond within 24 hours. If there’s a fit, we’ll have an honest conversation.</p>
          <a class="btn-apply" href="/apply-stage-1">Apply for Stage 1</a>
          <p class="st-cta-note">Limited to five new founders a month</p>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  type Rail = {
    el: HTMLElement;
    inner: HTMLElement;
    pattern: HTMLElement;
    dir: number;
    vel: number;
    pw: number;
    x: number;
    visible: boolean;
    clones: HTMLElement[];
    live: boolean;
  };

  const root = document.querySelector<HTMLElement>(".st-page");

  if (root) {
    root.classList.add("st-js");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    /* ---- Testimonials: pause / play (WCAG 2.2.2) ---- */
    const testi = root.querySelector<HTMLElement>("[data-st-testi]");
    const pauseBtn = root.querySelector<HTMLButtonElement>("[data-st-pause]");
    if (testi && pauseBtn) {
      pauseBtn.addEventListener("click", () => {
        const paused = testi.classList.toggle("is-paused");
        pauseBtn.setAttribute("aria-pressed", String(paused));
        pauseBtn.textContent = paused ? "Play testimonials" : "Pause testimonials";
      });
    }

    /* ---- Testimonials on phones: staggered reveal ---- */
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".st-list .st-card"));
    if (cards.length) {
      if (!("IntersectionObserver" in window)) {
        cards.forEach((card) => card.classList.add("is-in"));
      } else {
        const reveal = new IntersectionObserver(
          (entries) => {
            let n = 0;
            entries.forEach((entry) => {
              if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
              entry.target.style.transitionDelay = `${Math.min(n, 4) * 90}ms`;
              n += 1;
              entry.target.classList.add("is-in");
              reveal.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
        );
        cards.forEach((card) => reveal.observe(card));
      }
    }

    /* ---- Logo rails ---- */
    const rails: Rail[] = [];
    root.querySelectorAll<HTMLElement>("[data-st-rail]").forEach((el) => {
      const inner = el.querySelector<HTMLElement>(".st-rail-inner");
      const pattern = el.querySelector<HTMLElement>("[data-st-pattern]");
      if (!inner || !pattern) return;
      rails.push({
        el,
        inner,
        pattern,
        dir: Number(el.dataset.dir) === -1 ? -1 : 1,
        vel: Number(el.dataset.velocity) || 0.35,
        pw: 0,
        x: 0,
        visible: false,
        clones: [],
        live: false,
      });
    });

    if (rails.length) {
      let raf = 0;
      let last = 0;
      let lastY = 0;
      let smooth = 0;
      let scrollDir = 1; // 1 = last scrolled down, -1 = last scrolled up (sticky)
      let dirY = window.scrollY;

      window.addEventListener(
        "scroll",
        () => {
          const y = window.scrollY;
          if (y > dirY) scrollDir = 1;
          else if (y < dirY) scrollDir = -1;
          dirY = y;
        },
        { passive: true },
      );

      const place = (r: Rail) => {
        r.inner.style.transform = `translate3d(${r.x}px,0,0)`;
      };

      const clear = (r: Rail) => {
        r.clones.forEach((clone) => clone.remove());
        r.clones = [];
      };

      const build = (r: Rail) => {
        if (reduce.matches) {
          clear(r);
          r.live = false;
          r.pw = 0;
          r.inner.style.transform = "";
          return;
        }
        const pw = r.pattern.getBoundingClientRect().width;
        if (pw < 1) return;
        const count = Math.ceil(window.innerWidth / pw) + 1 - 1;
        if (r.live && Math.abs(pw - r.pw) < 0.5 && r.clones.length === count) return;

        clear(r);
        const frac = r.pw ? Math.min(1, Math.max(0, -r.x / r.pw)) : r.dir === 1 ? 1 : 0;
        r.pw = pw;
        r.x = -frac * pw;
        for (let i = 0; i < count; i += 1) {
          const clone = r.pattern.cloneNode(true) as HTMLElement;
          clone.removeAttribute("data-st-pattern");
          clone.setAttribute("aria-hidden", "true");
          r.inner.appendChild(clone);
          r.clones.push(clone);
        }
        r.live = true;
        place(r);
      };

      const tick = (now: number) => {
        raf = 0;
        if (reduce.matches) return;
        const dt = Math.min(Math.max(now - last, 0), 64);
        last = now;
        const k = dt / 16.667;
        const y = window.scrollY;
        const perFrame = k > 0 ? (y - lastY) / k : 0;
        lastY = y;
        smooth = smooth * 0.9 + perFrame * 0.1;
        const boost = 1 + Math.abs(smooth) * 0.5 * 0.6;

        let any = false;
        for (const r of rails) {
          if (!r.visible || !r.live || r.pw < 1) continue;
          any = true;
          let x = r.x + r.vel * boost * k * r.dir * scrollDir;
          if (x <= -r.pw) x += r.pw;
          else if (x >= 0) x -= r.pw;
          r.x = x;
          place(r);
        }
        if (any) raf = requestAnimationFrame(tick);
      };

      const kick = () => {
        if (raf || reduce.matches) return;
        if (!rails.some((r) => r.visible && r.live)) return;
        last = performance.now();
        lastY = window.scrollY;
        raf = requestAnimationFrame(tick);
      };

      if ("IntersectionObserver" in window) {
        const seen = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const r = rails.find((item) => item.el === entry.target);
            if (r) r.visible = entry.isIntersecting;
          });
          kick();
        });
        rails.forEach((r) => seen.observe(r.el));
      } else {
        rails.forEach((r) => {
          r.visible = true;
        });
      }

      let pending = 0;
      const rebuildAll = () => {
        pending = 0;
        rails.forEach(build);
        kick();
      };
      const schedule = () => {
        if (!pending) pending = requestAnimationFrame(rebuildAll);
      };

      if ("ResizeObserver" in window) {
        const sizes = new ResizeObserver(schedule);
        rails.forEach((r) => {
          sizes.observe(r.el);
          sizes.observe(r.pattern);
        });
      }
      window.addEventListener("resize", schedule);
      if (typeof reduce.addEventListener === "function") reduce.addEventListener("change", schedule);
      schedule();
    }
  }
</script>
