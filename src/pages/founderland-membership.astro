  path="/founderland-membership"
  eyebrow="FOUNDR.land Membership · a founder community"
  h1="The house founders belong to, after the sale."
  sub="A private community for founders who have sold their business."
  tag="By invitation"
  soon="Opening September 2027"
  sections={[
    {
      id: "fm-why",
      heading: "After the sale, nobody needs you in the same way",
