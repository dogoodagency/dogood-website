---
import "../../../styles/advisors.css";
import "../../../styles/advisors-resources.css";
import Base from "../../../layouts/Base.astro";
import Wave from "../../../components/Wave.astro";
import AdvisorNav from "../../../components/AdvisorNav.astro";
import { edgeAbove } from "../../../data/edge-line";
import FoundrLand from "../../../components/FoundrLand.astro";

const tint = "#F5F2FF";
const heroEdge = edgeAbove("#2A0B4F");
const bandEdge = edgeAbove(tint);
const footerEdge = edgeAbove("#ffffff");
---

<Base
  title="Founder exit readiness tools | DoGood Agency"
  description="Free exit readiness assessment tools for advisors: a client readiness check, a guide to spotting when a founder needs help, and a life-after-the-sale planner."
  canonical="https://www.dogoodagency.co/advisor-center/client-tools"
  ogTitle="Founder exit readiness tools | DoGood Agency"
  footerStrip={tint}
  footerEdge={bandEdge}
>
  <article class="adv-page advr-page">
    <header class="advr-hero">
      <div class="advr-hero-inner">
        <p class="advr-eyebrow">Advisor Center · Exit readiness tools</p>
        <h1>Free tools for you and your clients</h1>
        <p class="advr-lede">
          An exit readiness assessment for the founder, plus two more tools for the part nobody plans for: life in <span class="pink-soft advr-founder"><strong>FOUNDR</strong>.land</span>.<br />Free to use and share.<br />No sign-up for you.
        </p>
      </div>
      <Wave fill="#fff" edge={heroEdge} />
    </header>

    <!-- Advisor Center hub on its own white section, the same on all three pages (Seb, 20 Nov 2026). -->
    <section class="advr-band advr-band-white advr-hub-band" aria-label="Advisor Center">
      <div class="advr-well">
        <div class="advr-nav">
          <AdvisorNav current="tools" />
        </div>
      </div>
    </section>

    <section class="advr-band advr-band-tint advr-band-straight" aria-label="Free tools">
      <div class="advr-well">

        <div class="advr-intro">
          <p>Your clients get all your help with the deal. These tools help with the part nobody plans for: the founder themselves, before and after the sale.</p>
        </div>
        <ul class="advr-grid advr-grid--links">
          <li class="advr-cardwrap">
            <a class="advr-card advr-card--link advr-card--sky" href="/advisor-center/client-tools/readiness-check">
              <span class="advr-soon">Coming soon</span>
              
              <h2>Founder Readiness Check</h2>
              <p>Send it with your own link. Your client gets a private report and a free debrief call. If they say yes, you get a copy.</p>
              <span class="advr-more">Read more →</span>
            </a>
          </li>
          <li class="advr-cardwrap">
            <a class="advr-card advr-card--link advr-card--heart" href="/advisor-center/client-tools/signals-guide">
              <span class="advr-soon">Coming soon</span>
              <h2>Signals Guide</h2>
              <p>How to spot when a founder is struggling with the personal side of the sale, what to say, and when not to suggest help.</p>
              <span class="advr-more">Read more →</span>
            </a>
          </li>
          <li class="advr-cardwrap">
            <a class="advr-card advr-card--link advr-card--grass" href="/advisor-center/client-tools/life-after-the-sale-planner">
              <span class="advr-soon">Coming soon</span>
              
              <h2>Life After the Sale Planner</h2>
              <p>A short planner for time, energy and purpose, to fill in together with your client. Life planning, not financial advice.</p>
              <span class="advr-more">Read more →</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- foundr.land on its own straight white section. -->
    <section class="advr-band advr-band-white fl-band" aria-label="foundr.land">
      <FoundrLand
        kind="small"
        linkLabel="See foundr.land for advisors"
        line="These free tools are the first step. In foundr.land, your client can carry on privately and, if they choose, share their progress with you."
      />
    </section>

    <section class="advr-band advr-band-tint" aria-label="More tools">
      <div class="advr-well">
        <div class="advr-cta">
          <p>More tools are on the way. Want to hear when each one is ready?</p>
          <a class="btn-teal" href="/contact">Get in touch</a>
        </div>
        <p class="advr-back"><a href="/advisor-center">Have a client in mind already? Visit the Advisor Center →</a></p>
      </div>
    </section>
  </article>
</Base>
