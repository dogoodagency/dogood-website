<div class="through-line" id="through-line" aria-hidden="true">
  <svg fill="none">
    <defs>
      <mask id="company-reveal" maskUnits="userSpaceOnUse">
        <path id="company-mask" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" />
      </mask>
    </defs>
    <path id="founder-line" stroke="#28DBB0" stroke-linecap="round" stroke-linejoin="round" />
    <path
      id="company-line"
      stroke="#2A0B4F"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-dasharray="1 9"
      mask="url(#company-reveal)"
    />
  </svg>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector("#through-line");
  const svg = root?.querySelector("svg");
  const founder = document.querySelector("#founder-line");
  const company = document.querySelector("#company-line");
  const companyMask = document.querySelector("#company-mask");
  const main = document.querySelector("main");

  if (root instanceof HTMLElement && svg && founder && company && companyMask && main) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let triggers = [];

    const box = (el) => {
      const r = el.getBoundingClientRect();
      const m = main.getBoundingClientRect();
      const x = r.left - m.left;
      const y = r.top - m.top;
      return {
        x,
        y,
        left: x,
        w: r.width,
        h: r.height,
        right: x + r.width,
        bottom: y + r.height,
        cx: x + r.width / 2,
        cy: y + r.height / 2,
      };
    };

    const smooth = (points) => {
      const usable = points.filter((point) => Number.isFinite(point.x) && Number.isFinite(point.y));
      if (usable.length < 2) return "";
      const d = [`M ${usable[0].x.toFixed(1)} ${usable[0].y.toFixed(1)}`];
      const shorten = (cx, cy, ax, ay, max) => {
        const dx = cx - ax;
        const dy = cy - ay;
        const len = Math.hypot(dx, dy) || 1;
        if (len <= max) return [cx, cy];
        return [ax + (dx / len) * max, ay + (dy / len) * max];
      };
      for (let i = 0; i < usable.length - 1; i++) {
        const p0 = usable[i - 1] || usable[i];
        const p1 = usable[i];
        const p2 = usable[i + 1];
        const p3 = usable[i + 2] || p2;
        const span = Math.hypot(p2.x - p1.x, p2.y - p1.y) || 1;
        const max = Math.min(span * 0.28, 90);
        let c1x = p1.x + (p2.x - p0.x) / 6;
        let c1y = p1.y + (p2.y - p0.y) / 6;
        let c2x = p2.x - (p3.x - p1.x) / 6;
        let c2y = p2.y - (p3.y - p1.y) / 6;
        [c1x, c1y] = shorten(c1x, c1y, p1.x, p1.y, max);
        [c2x, c2y] = shorten(c2x, c2y, p2.x, p2.y, max);
        d.push(
          `C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`,
        );
      }
      return d.join(" ");
    };

    const poly = (points) => {
      const usable = points.filter((point) => Number.isFinite(point.x) && Number.isFinite(point.y));
      if (usable.length < 2) return "";
      return usable
        .map((point, index) => `${index ? "L" : "M"} ${point.x.toFixed(1)} ${point.y.toFixed(1)}`)
        .join(" ");
    };

    const monotonic = (points) => {
      let y = -Infinity;
      return points
        .filter((point) => point && Number.isFinite(point.x) && Number.isFinite(point.y))
        .map((point) => {
          y = Math.max(y, point.y);
          return { x: point.x, y };
        });
    };

    const alignDoor = () => {
      const word = document.querySelector(".hero-build");
      const img = document.querySelector(".hero-sketch");
      if (!(word instanceof HTMLElement) || !(img instanceof HTMLElement)) return;
      if (window.innerWidth < 1081) {
        img.style.transform = "";
        return;
      }
      img.style.transform = "translate(-50px, 100px) scale(1.1)";
      const nudge = word.getBoundingClientRect().right - img.getBoundingClientRect().right;
      img.style.transform = `translate(${(-50 + nudge).toFixed(1)}px, 100px) scale(1.1)`;
    };

    const build = () => {
      const width = main.clientWidth;
      const phone = width <= 1080;
      const founderStroke = phone ? 36 : 100;
      const companyStroke = phone ? 18 : 50;
      const parallel = phone ? 28 : 80;
      const hero = box(document.querySelector("#hero"));
      const headline = box(document.querySelector(".hero h1"));
      const clients = box(document.querySelector("#clients"));
      const exit = box(document.querySelector("#exit-card"));
      const caseJ = box(document.querySelector("#case-j"));
      const firstCard = box(document.querySelector("#first-card"));
      const applyBtn = box(document.querySelector("#apply-first .btn-apply"));
      const apply = box(document.querySelector("#apply-first"));
      const forYou = box(document.querySelector("#for-you"));
      const youCards = [...document.querySelectorAll("#for-you .card")].map((el) => box(el));
      const whyCard = box(document.querySelector("#why .why-copy"));
      const reviews = box(document.querySelector("#reviews"));
      const message = box(document.querySelector("#message-card"));
      const guaranteeCard = box(document.querySelector(".guarantee-card"));
      const next = box(document.querySelector("#next"));
      const bubble = box(document.querySelector("#next .next-icons"));
      const nextBtn = box(document.querySelector("#next .btn-apply"));
      if (!hero || !headline || !clients || !exit || !next) return;

      const footer = document.querySelector("#footer") || document.querySelector("footer");
      const mainRect = main.getBoundingClientRect();
      const waveEl = footer?.querySelector(".connect-wave") || footer?.querySelector("svg");
      const waveRect = (waveEl || footer)?.getBoundingClientRect();
      const end = waveRect ? waveRect.bottom - mainRect.top : main.clientHeight - 6;
      const clampX = (value) => Math.min(width - (phone ? 20 : 56), Math.max(phone ? 22 : 56, value));
      const youMid =
        youCards.length === 2 ? (youCards[0].right + youCards[1].left) / 2 : width * 0.5;
      const throughY = exit.y + Math.min(exit.h * 0.55, phone ? 70 : 180);

      founder.setAttribute("stroke-width", String(founderStroke));
      company.setAttribute("stroke-width", String(companyStroke));
      companyMask.setAttribute("stroke-width", String(companyStroke + 12));
      company.setAttribute("stroke-dasharray", "none");

      const founderPts = monotonic([
        { x: clampX(phone ? 22 : 64), y: phone ? 16 : 28 },
        { x: clampX(phone ? 22 : 64), y: Math.max(24, exit.y - (phone ? 36 : 80)) },
        { x: clampX(exit.cx), y: Math.max(24, exit.y - (phone ? 36 : 80)) },
        { x: clampX(exit.cx), y: throughY },
        { x: clampX(exit.right - (phone ? 12 : 28)), y: throughY },
        { x: clampX(width - (phone ? 28 : 70)), y: throughY },
        { x: clampX(width - (phone ? 28 : 70)), y: firstCard ? firstCard.cy : exit.bottom + 280 },
        { x: clampX(firstCard ? firstCard.right - 24 : width * 0.72), y: firstCard ? firstCard.cy : exit.bottom + 280 },
        { x: clampX(firstCard ? firstCard.left + 36 : width * 0.5), y: firstCard ? firstCard.cy : exit.bottom + 280 },
        { x: clampX(applyBtn ? applyBtn.cx : apply ? apply.cx : width * 0.5), y: (firstCard ? firstCard.bottom : exit.bottom) + 48 },
        { x: clampX(applyBtn ? applyBtn.cx : apply ? apply.cx : width * 0.5), y: applyBtn ? applyBtn.cy : apply ? apply.cy : exit.bottom + 420 },
        { x: clampX(youMid), y: (applyBtn ? applyBtn.bottom : apply ? apply.bottom : exit.bottom) + 80 },
        { x: clampX(youMid), y: forYou ? forYou.bottom - 16 : (apply ? apply.bottom + 220 : exit.bottom + 560) },
        { x: clampX(whyCard ? whyCard.cx : youMid), y: whyCard ? whyCard.y + 24 : (forYou ? forYou.bottom + 80 : exit.bottom + 640) },
        { x: clampX(whyCard ? whyCard.left + 48 : youMid), y: whyCard ? whyCard.cy : (forYou ? forYou.bottom + 120 : exit.bottom + 680) },
        { x: clampX(whyCard ? whyCard.right - 30 : width * 0.75), y: whyCard ? whyCard.cy : (forYou ? forYou.bottom + 120 : exit.bottom + 680) },
        { x: clampX(reviews ? reviews.cx : youMid), y: reviews ? reviews.cy : (whyCard ? whyCard.bottom + 80 : end - 800) },
        { x: clampX(message ? message.cx : youMid), y: message ? message.cy : (reviews ? reviews.bottom + 40 : end - 500) },
        { x: clampX(guaranteeCard ? guaranteeCard.cx : width * 0.62), y: guaranteeCard ? guaranteeCard.cy : end - 280 },
        { x: clampX(bubble ? bubble.cx : phone ? 40 : 80), y: bubble ? bubble.cy : next.y + 80 },
        { x: clampX(nextBtn ? nextBtn.cx : next.cx), y: nextBtn ? nextBtn.cy : next.cy },
        { x: clampX(phone ? 28 : 70), y: end - 8 },
      ]);

      const splitAt = founderPts.findIndex((point) => point.y >= throughY - 1 && point.x >= exit.cx);
      const shared = (splitAt >= 0 ? founderPts.slice(0, splitAt + 2) : founderPts.slice(0, 4)).map(
        (point) => ({ x: clampX(point.x + parallel), y: point.y }),
      );
      const lastShared = shared[shared.length - 1] || { x: width, y: throughY };
      const companyPts = monotonic([...shared, { x: width + companyStroke, y: lastShared.y }]);

      const height = Math.max(200, end);
      root.style.top = "0px";
      root.style.height = `${height}px`;
      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
      svg.setAttribute("width", String(width));
      svg.setAttribute("height", String(height));

      founder.setAttribute("d", poly(founderPts));
      company.setAttribute("d", poly(companyPts));
      companyMask.setAttribute("d", poly(companyPts));
      alignDoor();

      triggers.forEach((trigger) => trigger.kill());
      triggers = [];

      const reveal = () => {
        const mid = window.innerHeight * 0.5;
        document.querySelectorAll("[data-line-reveal]").forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const rect = el.getBoundingClientRect();
          const reached = reduce.matches || rect.top <= mid + 80;
          el.classList.toggle("is-drawn", reached);
        });
      };

      const paint = (path, length) => {
        if (reduce.matches) {
          path.style.strokeDasharray = `${length}`;
          path.style.strokeDashoffset = "0";
          return;
        }
        const svgTop = svg.getBoundingClientRect().top;
        const target = window.innerHeight * 0.5;
        let lo = 0;
        let hi = length;
        const startY = svgTop + path.getPointAtLength(0).y;
        const endY = svgTop + path.getPointAtLength(length).y;
        if (target <= startY) hi = 0;
        else if (target >= endY) hi = length;
        else {
          for (let step = 0; step < 22; step += 1) {
            const midLength = (lo + hi) / 2;
            const y = svgTop + path.getPointAtLength(midLength).y;
            if (y < target) lo = midLength;
            else hi = midLength;
          }
        }
        path.style.strokeDasharray = `${length}`;
        path.style.strokeDashoffset = String(length - hi);
      };

      const draw = () => {
        paint(founder, founder.getTotalLength());
        paint(companyMask, companyMask.getTotalLength());
        reveal();
      };

      draw();

      if (!reduce.matches) {
        triggers.push(
          ScrollTrigger.create({
            start: 0,
            end: "max",
            scrub: 0.15,
            onUpdate: draw,
          }),
        );
      }
    };

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(build);
    };

    schedule();
    window.addEventListener("load", schedule);
    window.addEventListener("resize", schedule);
    reduce.addEventListener("change", schedule);
    document.fonts?.ready.then(schedule);
  }
</script>
