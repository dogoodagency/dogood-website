<div class="through-line" id="through-line" aria-hidden="true">
  <svg fill="none">
    <defs>
      <mask id="company-reveal" maskUnits="userSpaceOnUse">
        <path id="company-mask" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" />
      </mask>
    </defs>
    <path id="founder-line" stroke="#28DBB0" stroke-linecap="round" stroke-linejoin="round" />
    <path
      id="company-line"
      stroke="#2A0B4F"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-dasharray="70 94"
      mask="url(#company-reveal)"
    />
  </svg>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector("#through-line");
  const svg = root?.querySelector("svg");
  const founder = document.querySelector("#founder-line");
  const company = document.querySelector("#company-line");
  const companyMask = document.querySelector("#company-mask");
  const main = document.querySelector("main");

  if (root instanceof HTMLElement && svg && founder && company && companyMask && main) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let triggers = [];

    const box = (el) => {
      const r = el.getBoundingClientRect();
      const m = main.getBoundingClientRect();
      const x = r.left - m.left;
      const y = r.top - m.top;
      return {
        x,
        y,
        left: x,
        w: r.width,
        h: r.height,
        right: x + r.width,
        bottom: y + r.height,
        cx: x + r.width / 2,
        cy: y + r.height / 2,
      };
    };

    const smooth = (points) => {
      const usable = points.filter((point) => Number.isFinite(point.x) && Number.isFinite(point.y));
      if (usable.length < 2) return "";
      const d = [`M ${usable[0].x.toFixed(1)} ${usable[0].y.toFixed(1)}`];
      const shorten = (cx, cy, ax, ay, max) => {
        const dx = cx - ax;
        const dy = cy - ay;
        const len = Math.hypot(dx, dy) || 1;
        if (len <= max) return [cx, cy];
        return [ax + (dx / len) * max, ay + (dy / len) * max];
      };
      for (let i = 0; i < usable.length - 1; i++) {
        const p0 = usable[i - 1] || usable[i];
        const p1 = usable[i];
        const p2 = usable[i + 1];
        const p3 = usable[i + 2] || p2;
        const span = Math.hypot(p2.x - p1.x, p2.y - p1.y) || 1;
        const max = Math.min(span * 0.28, 90);
        let c1x = p1.x + (p2.x - p0.x) / 6;
        let c1y = p1.y + (p2.y - p0.y) / 6;
        let c2x = p2.x - (p3.x - p1.x) / 6;
        let c2y = p2.y - (p3.y - p1.y) / 6;
        [c1x, c1y] = shorten(c1x, c1y, p1.x, p1.y, max);
        [c2x, c2y] = shorten(c2x, c2y, p2.x, p2.y, max);
        d.push(
          `C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`,
        );
      }
      return d.join(" ");
    };

    const dist = (a, b) => Math.hypot(b.x - a.x, b.y - a.y);

    const heading = (a, b) => Math.atan2(b.y - a.y, b.x - a.x);

    const turnBetween = (a, b, c) => {
      let delta = heading(b, c) - heading(a, b);
      while (delta > Math.PI) delta -= Math.PI * 2;
      while (delta < -Math.PI) delta += Math.PI * 2;
      return delta;
    };

    const dedupe = (points) => {
      const out = [];
      points.forEach((point) => {
        if (!point || !Number.isFinite(point.x) || !Number.isFinite(point.y)) return;
        const prev = out[out.length - 1];
        if (!prev || dist(prev, point) > 0.5) out.push({ x: point.x, y: point.y });
      });
      return out;
    };

    const dropColinear = (points) =>
      points.filter((point, index, arr) => {
        if (index === 0 || index === arr.length - 1) return true;
        return Math.abs(turnBetween(arr[index - 1], point, arr[index + 1])) > 0.09;
      });

    // Setback each corner needs for a circular arc of `radius`. Near U-turns are capped
    // so the tangent length stays finite.
    const cornerSetback = (prev, curr, next, radius) => {
      const theta = Math.abs(turnBetween(prev, curr, next));
      if (theta < 0.09) return 0;
      return radius * Math.tan(Math.min(theta, 2.4) / 2);
    };

    // Give every remaining corner enough leg for `radius`. Tiny jogs are removed.
    // Longer corners that still cannot fit are opened by moving only that corner
    // outward, so the rest of the route stays put and the path keeps travelling down.
    const makeRoom = (points, radius) => {
      let pts = dropColinear(dedupe(points));
      for (let guard = 0; guard < 48 && pts.length > 2; guard += 1) {
        let packed = -1;
        let worst = 0;
        for (let i = 0; i < pts.length - 1; i += 1) {
          const need =
            (i > 0 ? cornerSetback(pts[i - 1], pts[i], pts[i + 1], radius) : 0) +
            (i + 2 < pts.length ? cornerSetback(pts[i], pts[i + 1], pts[i + 2], radius) : 0);
          const len = dist(pts[i], pts[i + 1]);
          const deficit = need - len;
          if (deficit > worst) {
            worst = deficit;
            packed = i;
          }
        }
        if (packed < 0 || worst <= 1) break;
        const len = dist(pts[packed], pts[packed + 1]);
        if (len < radius) {
          const left = packed > 0 ? cornerSetback(pts[packed - 1], pts[packed], pts[packed + 1], radius) : 0;
          const right =
            packed + 2 < pts.length
              ? cornerSetback(pts[packed], pts[packed + 1], pts[packed + 2], radius)
              : 0;
          const remove = right > left ? packed + 1 : packed;
          if (remove > 0 && remove < pts.length - 1) {
            pts.splice(remove, 1);
            pts = dropColinear(dedupe(pts));
            continue;
          }
        }
        const left = packed > 0 ? cornerSetback(pts[packed - 1], pts[packed], pts[packed + 1], radius) : 0;
        const right =
          packed + 2 < pts.length
            ? cornerSetback(pts[packed], pts[packed + 1], pts[packed + 2], radius)
            : 0;
        const index = right > left && packed + 1 < pts.length - 1 ? packed + 1 : packed;
        if (index <= 0 || index >= pts.length - 1) break;
        const prev = pts[index - 1];
        const curr = pts[index];
        const next = pts[index + 1];
        const inLen = dist(prev, curr) || 1;
        const outLen = dist(curr, next) || 1;
        const inUx = (curr.x - prev.x) / inLen;
        const inUy = (curr.y - prev.y) / inLen;
        const outUx = (next.x - curr.x) / outLen;
        const outUy = (next.y - curr.y) / outLen;
        let vx = inUx - outUx;
        let vy = inUy - outUy;
        const vlen = Math.hypot(vx, vy) || 1;
        vx /= vlen;
        vy /= vlen;
        const step = Math.min(worst + 4, 48);
        const ny = curr.y + vy * step;
        pts[index] = {
          x: curr.x + vx * step,
          y: ny < curr.y ? curr.y : ny,
        };
        let floor = -Infinity;
        pts = pts.map((point) => {
          floor = Math.max(floor, point.y);
          return { x: point.x, y: floor };
        });
        pts = dropColinear(dedupe(pts));
      }
      return pts;
    };

    const fillet = (points, radius) => {
      const pts = makeRoom(points, radius);
      if (pts.length < 2) return "";
      const fmt = (value) => value.toFixed(1);
      let d = `M ${fmt(pts[0].x)} ${fmt(pts[0].y)}`;
      let cursor = pts[0];
      for (let i = 1; i < pts.length - 1; i += 1) {
        const prev = pts[i - 1];
        const curr = pts[i];
        const next = pts[i + 1];
        const inLen = dist(prev, curr) || 1;
        const outLen = dist(curr, next) || 1;
        const inUx = (curr.x - prev.x) / inLen;
        const inUy = (curr.y - prev.y) / inLen;
        const outUx = (next.x - curr.x) / outLen;
        const outUy = (next.y - curr.y) / outLen;
        const theta = Math.abs(turnBetween(prev, curr, next));
        if (theta < 0.09) {
          d += ` L ${fmt(curr.x)} ${fmt(curr.y)}`;
          cursor = curr;
          continue;
        }
        const used = Math.min(theta, 2.4);
        const previous =
          i > 1 ? cornerSetback(pts[i - 2], pts[i - 1], curr, radius) : 0;
        const following =
          i + 2 < pts.length ? cornerSetback(curr, next, pts[i + 2], radius) : 0;
        const setback = Math.min(
          radius * Math.tan(used / 2),
          Math.max(8, inLen - previous),
          Math.max(8, outLen - following),
        );
        const arcRadius = setback / Math.tan(used / 2);
        const handle = (4 / 3) * Math.tan(used / 4) * arcRadius;
        const a = { x: curr.x - inUx * setback, y: curr.y - inUy * setback };
        const b = { x: curr.x + outUx * setback, y: curr.y + outUy * setback };
        const c1 = { x: a.x + inUx * handle, y: a.y + inUy * handle };
        const c2 = { x: b.x - outUx * handle, y: b.y - outUy * handle };
        if (dist(cursor, a) > 0.4) d += ` L ${fmt(a.x)} ${fmt(a.y)}`;
        d += ` C ${fmt(c1.x)} ${fmt(c1.y)}, ${fmt(c2.x)} ${fmt(c2.y)}, ${fmt(b.x)} ${fmt(b.y)}`;
        cursor = b;
      }
      const last = pts[pts.length - 1];
      d += ` L ${fmt(last.x)} ${fmt(last.y)}`;
      return d;
    };

    const monotonic = (points) => {
      let y = -Infinity;
      return points
        .filter((point) => point && Number.isFinite(point.x) && Number.isFinite(point.y))
        .map((point) => {
          y = Math.max(y, point.y);
          return { x: point.x, y };
        });
    };

    const alignDoor = () => {
      const word = document.querySelector(".hero-build");
      const img = document.querySelector(".hero-sketch");
      if (!(word instanceof HTMLElement) || !(img instanceof HTMLElement)) return;
      if (window.innerWidth < 1081) {
        img.style.transform = "";
        return;
      }
      img.style.transform = "translate(-50px, 100px)";
      const box = img.getBoundingClientRect();
      const doorRight = box.left + box.width * (412 / 520);
      const nudge = word.getBoundingClientRect().right - doorRight;
      img.style.transform = `translate(${(-50 + nudge).toFixed(1)}px, 100px)`;
    };

    const build = () => {
      const width = main.clientWidth;
      const phone = width <= 700;
      const founderStroke = phone ? 8 : 100;
      const companyStroke = phone ? 0 : 50;
      const turnRadius = width >= 1081 ? 120 : Math.max(36, (120 * width) / 1440);
      const hero = box(document.querySelector("#hero"));
      const headline = box(document.querySelector(".hero h1"));
      const clients = box(document.querySelector("#clients"));
      const exit = box(document.querySelector("#exit-card"));
      const caseCard = box(document.querySelector("#case-j article")) || box(document.querySelector("#case-j"));
      const next = box(document.querySelector("#next"));
      if (!hero || !headline || !clients || !exit || !next) return;

      const footer = document.querySelector("#footer") || document.querySelector("footer");
      const mainRect = main.getBoundingClientRect();
      const waveEl = footer?.querySelector(".connect-wave") || footer?.querySelector("svg");
      const waveRect = (waveEl || footer)?.getBoundingClientRect();
      const end = waveRect ? waveRect.bottom - mainRect.top : main.clientHeight - 6;
      const bandTop = clients.bottom + 70;
      const bandBottom = Math.max(bandTop + 40, exit.y - 36);
      const entryY = Math.min(bandBottom, Math.max(bandTop, (clients.bottom + exit.y) / 2));
      const copyLeft = (document.querySelector(".hero-copy") || headline).getBoundingClientRect().left - main.getBoundingClientRect().left;

      const swellDark = document.querySelector("#swell-dark");
      const swellLight = document.querySelector("#swell-light");
      const paintFunnel = () => {
        if (!(swellDark instanceof SVGStopElement) || !(swellLight instanceof SVGStopElement)) return;
        const funnel = document.querySelector("#next .swell-bg");
        if (!(funnel instanceof Element)) return;
        let level = 1;
        if (!reduce.matches) {
          const rect = funnel.getBoundingClientRect();
          const target = window.innerHeight * 0.5;
          if (rect.height <= 1 || target <= rect.top) level = 0;
          else if (target >= rect.bottom) level = 1;
          else level = (target - rect.top) / rect.height;
        }
        const offset = level.toFixed(4);
        swellDark.setAttribute("offset", offset);
        swellLight.setAttribute("offset", offset);
      };

      const hideOnPhone = phone && copyLeft < 36;
      root.style.display = hideOnPhone ? "none" : "";
      if (hideOnPhone) {
        paintFunnel();
        triggers.forEach((trigger) => trigger.kill());
        triggers = [];
        if (!reduce.matches) {
          triggers.push(
            ScrollTrigger.create({
              start: 0,
              end: "max",
              scrub: 0.15,
              onUpdate: paintFunnel,
            }),
          );
        }
        return;
      }

      root.style.display = "";
      const rightOf = (card) => (card ? Math.min(width - 70, card.right + 78) : width - 80);
      const enterX = Math.min(exit.cx, exit.right - 90);
      const splitY = exit.y + 130;
      const beside = rightOf(exit);

      const clearLane = () => {
        const half = founderStroke / 2;
        const gap = 14;
        const y0 = box(document.querySelector("#exit"))?.bottom ?? exit.bottom;
        const y1 = next.y;
        const reviews = document.querySelector("#reviews");
        const blockers = [];
        const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT);
        while (walker.nextNode()) {
          const node = walker.currentNode;
          if (!node.textContent || !node.textContent.trim()) continue;
          if (reviews?.contains(node.parentElement)) continue;
          const range = document.createRange();
          range.selectNodeContents(node);
          for (const rect of range.getClientRects()) {
            const top = rect.top - mainRect.top;
            const bot = rect.bottom - mainRect.top;
            if (bot < y0 || top > y1 || rect.width < 2) continue;
            if (rect.right < mainRect.left || rect.left > mainRect.right) continue;
            blockers.push({ l: rect.left - mainRect.left, r: rect.right - mainRect.left });
          }
        }
        document.querySelectorAll("a, button, article, .card, img").forEach((el) => {
          if (el.closest("#reviews, .guarantee-scale, .next-icons, .exit-machine")) return;
          const pink = /234,\s*21,\s*87/.test(getComputedStyle(el).backgroundColor);
          if (!pink && el.tagName !== "IMG" && !el.classList.contains("card")) return;
          const rect = el.getBoundingClientRect();
          const top = rect.top - mainRect.top;
          const bot = rect.bottom - mainRect.top;
          if (bot < y0 || top > y1 || rect.width < 8) return;
          blockers.push({ l: rect.left - mainRect.left, r: rect.right - mainRect.left });
        });
        for (let x = 12; x <= width - half; x += 4) {
          const left = x - half - gap;
          const right = x + half + gap;
          if (!blockers.some((item) => item.r > left && item.l < right)) return x;
        }
        return half;
      };

      founder.setAttribute("stroke-width", String(founderStroke));
      company.setAttribute("stroke-width", String(companyStroke));
      companyMask.setAttribute("stroke-width", String(companyStroke + 16));
      if (companyStroke > 0) {
        company.setAttribute(
          "stroke-dasharray",
          `${Math.round(companyStroke * 1.4)} ${Math.round(companyStroke * 1.88)}`,
        );
      }

      const dropX = clearLane();
      const exitSection = box(document.querySelector("#exit"));
      const machine = box(document.querySelector(".exit-machine"));
      const caseTop = caseCard ? caseCard.y : (exitSection?.bottom ?? exit.bottom) + 160;
      const belowArt = Math.max(exit.bottom, machine?.bottom || 0) + founderStroke / 2 + 20;
      const aboveCopy = caseTop - founderStroke / 2 - 12;
      const crossY = aboveCopy > belowArt ? (belowArt + aboveCopy) / 2 : aboveCopy;
      const swell = box(document.querySelector("#next .swell-bg")) || next;
      const mouthX = swell.x + swell.w * (720 / 1440);
      const mouthY = swell.y + Math.min(32, swell.h * 0.05);
      const scale = box(document.querySelector(".guarantee-scale"));
      const founderPts = monotonic([
        { x: -20, y: entryY },
        { x: enterX, y: entryY },
        { x: enterX, y: splitY },
        { x: beside, y: splitY },
        { x: beside, y: crossY },
        { x: dropX, y: crossY },
        ...(scale && scale.w > 80
          ? [
              { x: dropX, y: Math.max(crossY + 40, scale.y - turnRadius) },
              { x: scale.x + scale.w * 0.33, y: scale.y + scale.h * 0.28 },
              { x: scale.x + scale.w * 0.33, y: scale.y + scale.h * 0.48 },
              { x: dropX, y: scale.bottom + turnRadius },
            ]
          : []),
        { x: dropX, y: mouthY },
        { x: mouthX, y: mouthY },
      ]);

      const companyY = Math.min(exit.y - 30, entryY + 64);
      const companyBottom = companyY + turnRadius * 2;
      const bendX = Math.min(width - turnRadius * 2 - 24, exit.right + turnRadius);
      const companyPts = phone
        ? []
        : monotonic([
            { x: -20, y: companyY },
            { x: bendX, y: companyY },
            { x: bendX, y: companyBottom },
            { x: width + 40, y: companyBottom },
          ]);

      const height = Math.max(200, end);
      root.style.top = "0px";
      root.style.height = `${height}px`;
      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
      svg.setAttribute("width", String(width));
      svg.setAttribute("height", String(height));

      founder.setAttribute("d", fillet(founderPts, turnRadius));
      company.setAttribute("d", fillet(companyPts, turnRadius));
      companyMask.setAttribute("d", fillet(companyPts, turnRadius));
      alignDoor();

      triggers.forEach((trigger) => trigger.kill());
      triggers = [];

      const reveal = () => {
        const mid = window.innerHeight * 0.5;
        document.querySelectorAll("[data-line-reveal]").forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const rect = el.getBoundingClientRect();
          const reached = reduce.matches || rect.top <= mid + 80;
          el.classList.toggle("is-drawn", reached);
        });
      };

      const paint = (path, length) => {
        if (reduce.matches) {
          path.style.strokeDasharray = `${length}`;
          path.style.strokeDashoffset = "0";
          return;
        }
        const svgTop = svg.getBoundingClientRect().top;
        const target = window.innerHeight * 0.5;
        let lo = 0;
        let hi = length;
        const startY = svgTop + path.getPointAtLength(0).y;
        const endY = svgTop + path.getPointAtLength(length).y;
        if (target <= startY) hi = 0;
        else if (target >= endY) hi = length;
        else {
          for (let step = 0; step < 22; step += 1) {
            const midLength = (lo + hi) / 2;
            const y = svgTop + path.getPointAtLength(midLength).y;
            if (y < target) lo = midLength;
            else hi = midLength;
          }
        }
        path.style.strokeDasharray = `${length}`;
        path.style.strokeDashoffset = String(length - hi);
      };

      const draw = () => {
        paint(founder, founder.getTotalLength());
        paint(companyMask, companyMask.getTotalLength());
        paintFunnel();
        reveal();
      };

      draw();

      if (!reduce.matches) {
        triggers.push(
          ScrollTrigger.create({
            start: 0,
            end: "max",
            scrub: 0.15,
            onUpdate: draw,
          }),
        );
      }
    };

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(build);
    };

    schedule();
    window.addEventListener("load", schedule);
    window.addEventListener("resize", schedule);
    reduce.addEventListener("change", schedule);
    document.fonts?.ready.then(schedule);
  }
</script>
