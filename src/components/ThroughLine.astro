<div class="through-line" id="through-line" aria-hidden="true">
  <svg fill="none">
    <defs>
      <mask id="company-reveal" maskUnits="userSpaceOnUse">
        <path id="company-mask" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" />
        <rect id="company-cover" x="0" y="0" width="0" height="0" fill="#000" />
      </mask>
    </defs>
    <path id="founder-join" fill="#28DBB0" stroke="none" />
    <path id="founder-line" stroke="#28DBB0" stroke-linecap="round" stroke-linejoin="round" />
    <path id="founder-wide" fill="#28DBB0" stroke="none" />
    <path
      id="company-line"
      stroke="#2A0B4F"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-dasharray="70 94"
      mask="url(#company-reveal)"
    />
  </svg>
</div>
<div class="route-figures" id="route-figures">
  <div class="route-figure" data-line-figure="1" style="--pw: 80; --ox: 78.9; --oy: -24.9; --bw: 134; --bh: 104; --origin: 6.8% 54%;">
    <picture class="route-person">
      <source type="image/webp" srcset="/sketches/route/person-1-man@1x.webp 1x, /sketches/route/person-1-man@2x.webp 2x, /sketches/route/person-1-man@3x.webp 3x" />
      <img src="/sketches/route/person-1-man@1x.png" srcset="/sketches/route/person-1-man@1x.png 1x, /sketches/route/person-1-man@2x.png 2x, /sketches/route/person-1-man@3x.png 3x" width="80" height="150" alt="A napkin-sketch man, facing right, waving toward the departing company line." />
    </picture>
    <img class="route-bubble" src="/sketches/route/bubble-1-goodbye-company.svg" width="134" height="104" alt="Goodbye company" />
  </div>
  <div class="route-figure" data-line-figure="2" style="--pw: 62; --ox: -133.2; --oy: -22.6; --bw: 142; --bh: 104; --origin: 92% 55.7%;">
    <picture class="route-person">
      <source type="image/webp" srcset="/sketches/route/person-2-woman@1x.webp 1x, /sketches/route/person-2-woman@2x.webp 2x, /sketches/route/person-2-woman@3x.webp 3x" />
      <img src="/sketches/route/person-2-woman@1x.png" srcset="/sketches/route/person-2-woman@1x.png 1x, /sketches/route/person-2-woman@2x.png 2x, /sketches/route/person-2-woman@3x.png 3x" width="62" height="150" alt="A napkin-sketch woman standing calmly, a pink strap over her shoulder." />
    </picture>
    <img class="route-bubble" src="/sketches/route/bubble-2-i-feel-supported.svg" width="142" height="104" alt="I feel supported" />
  </div>
  <div class="route-figure" data-line-figure="3" style="--pw: 62; --ox: 53; --oy: -23.5; --bw: 146; --bh: 104; --origin: 7.5% 54.6%;">
    <picture class="route-person">
      <source type="image/webp" srcset="/sketches/route/person-3-man@1x.webp 1x, /sketches/route/person-3-man@2x.webp 2x, /sketches/route/person-3-man@3x.webp 3x" />
      <img src="/sketches/route/person-3-man@1x.png" srcset="/sketches/route/person-3-man@1x.png 1x, /sketches/route/person-3-man@2x.png 2x, /sketches/route/person-3-man@3x.png 3x" width="62" height="150" alt="A napkin-sketch man standing with quiet clarity, looking slightly down and ahead." />
    </picture>
    <img class="route-bubble" src="/sketches/route/bubble-3-i-know-now-what-to-do.svg" width="146" height="104" alt="I know now what to do" />
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector("#through-line");
  const svg = root?.querySelector("svg");
  const founder = document.querySelector("#founder-line");
  const company = document.querySelector("#company-line");
  const companyMask = document.querySelector("#company-mask");
  const main = document.querySelector("main");

  if (root instanceof HTMLElement && svg && founder && company && companyMask && main) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let triggers = [];

    const box = (el) => {
      const r = el.getBoundingClientRect();
      const m = main.getBoundingClientRect();
      const x = r.left - m.left;
      const y = r.top - m.top;
      return {
        x,
        y,
        left: x,
        w: r.width,
        h: r.height,
        right: x + r.width,
        bottom: y + r.height,
        cx: x + r.width / 2,
        cy: y + r.height / 2,
      };
    };

    const smooth = (points) => {
      const usable = points.filter((point) => Number.isFinite(point.x) && Number.isFinite(point.y));
      if (usable.length < 2) return "";
      const d = [`M ${usable[0].x.toFixed(1)} ${usable[0].y.toFixed(1)}`];
      const shorten = (cx, cy, ax, ay, max) => {
        const dx = cx - ax;
        const dy = cy - ay;
        const len = Math.hypot(dx, dy) || 1;
        if (len <= max) return [cx, cy];
        return [ax + (dx / len) * max, ay + (dy / len) * max];
      };
      for (let i = 0; i < usable.length - 1; i++) {
        const p0 = usable[i - 1] || usable[i];
        const p1 = usable[i];
        const p2 = usable[i + 1];
        const p3 = usable[i + 2] || p2;
        const span = Math.hypot(p2.x - p1.x, p2.y - p1.y) || 1;
        const max = Math.min(span * 0.28, 90);
        let c1x = p1.x + (p2.x - p0.x) / 6;
        let c1y = p1.y + (p2.y - p0.y) / 6;
        let c2x = p2.x - (p3.x - p1.x) / 6;
        let c2y = p2.y - (p3.y - p1.y) / 6;
        [c1x, c1y] = shorten(c1x, c1y, p1.x, p1.y, max);
        [c2x, c2y] = shorten(c2x, c2y, p2.x, p2.y, max);
        d.push(
          `C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`,
        );
      }
      return d.join(" ");
    };

    const dist = (a, b) => Math.hypot(b.x - a.x, b.y - a.y);

    const heading = (a, b) => Math.atan2(b.y - a.y, b.x - a.x);

    const turnBetween = (a, b, c) => {
      let delta = heading(b, c) - heading(a, b);
      while (delta > Math.PI) delta -= Math.PI * 2;
      while (delta < -Math.PI) delta += Math.PI * 2;
      return delta;
    };

    const dedupe = (points) => {
      const out = [];
      points.forEach((point) => {
        if (!point || !Number.isFinite(point.x) || !Number.isFinite(point.y)) return;
        const prev = out[out.length - 1];
        if (!prev || dist(prev, point) > 0.5) out.push({ x: point.x, y: point.y });
      });
      return out;
    };

    const dropColinear = (points) =>
      points.filter((point, index, arr) => {
        if (index === 0 || index === arr.length - 1) return true;
        return Math.abs(turnBetween(arr[index - 1], point, arr[index + 1])) > 0.09;
      });

    // Setback each corner needs for a circular arc of `radius`. Near U-turns are capped
    // so the tangent length stays finite.
    const cornerSetback = (prev, curr, next, radius) => {
      const theta = Math.abs(turnBetween(prev, curr, next));
      if (theta < 0.09) return 0;
      return radius * Math.tan(Math.min(theta, 2.4) / 2);
    };

    // Give every remaining corner enough leg for `radius`. Tiny jogs are removed.
    // Longer corners that still cannot fit are opened by moving only that corner
    // outward, so the rest of the route stays put and the path keeps travelling down.
    const makeRoom = (points, radius) => {
      let pts = dropColinear(dedupe(points));
      for (let guard = 0; guard < 48 && pts.length > 2; guard += 1) {
        let packed = -1;
        let worst = 0;
        for (let i = 0; i < pts.length - 1; i += 1) {
          const need =
            (i > 0 ? cornerSetback(pts[i - 1], pts[i], pts[i + 1], radius) : 0) +
            (i + 2 < pts.length ? cornerSetback(pts[i], pts[i + 1], pts[i + 2], radius) : 0);
          const len = dist(pts[i], pts[i + 1]);
          const deficit = need - len;
          if (deficit > worst) {
            worst = deficit;
            packed = i;
          }
        }
        if (packed < 0 || worst <= 1) break;
        const len = dist(pts[packed], pts[packed + 1]);
        if (len < radius) {
          const left = packed > 0 ? cornerSetback(pts[packed - 1], pts[packed], pts[packed + 1], radius) : 0;
          const right =
            packed + 2 < pts.length
              ? cornerSetback(pts[packed], pts[packed + 1], pts[packed + 2], radius)
              : 0;
          const remove = right > left ? packed + 1 : packed;
          if (remove > 0 && remove < pts.length - 1) {
            pts.splice(remove, 1);
            pts = dropColinear(dedupe(pts));
            continue;
          }
        }
        const left = packed > 0 ? cornerSetback(pts[packed - 1], pts[packed], pts[packed + 1], radius) : 0;
        const right =
          packed + 2 < pts.length
            ? cornerSetback(pts[packed], pts[packed + 1], pts[packed + 2], radius)
            : 0;
        const index = right > left && packed + 1 < pts.length - 1 ? packed + 1 : packed;
        if (index <= 0 || index >= pts.length - 1) break;
        const prev = pts[index - 1];
        const curr = pts[index];
        const next = pts[index + 1];
        const inLen = dist(prev, curr) || 1;
        const outLen = dist(curr, next) || 1;
        const inUx = (curr.x - prev.x) / inLen;
        const inUy = (curr.y - prev.y) / inLen;
        const outUx = (next.x - curr.x) / outLen;
        const outUy = (next.y - curr.y) / outLen;
        let vx = inUx - outUx;
        let vy = inUy - outUy;
        const vlen = Math.hypot(vx, vy) || 1;
        vx /= vlen;
        vy /= vlen;
        const step = Math.min(worst + 4, 48);
        const ny = curr.y + vy * step;
        pts[index] = {
          x: curr.x + vx * step,
          y: ny < curr.y ? curr.y : ny,
        };
        let floor = -Infinity;
        pts = pts.map((point) => {
          floor = Math.max(floor, point.y);
          return { x: point.x, y: floor };
        });
        pts = dropColinear(dedupe(pts));
      }
      return pts;
    };

    const fillet = (points, radius) => {
      const pts = makeRoom(points, radius);
      if (pts.length < 2) return "";
      const fmt = (value) => value.toFixed(1);
      let d = `M ${fmt(pts[0].x)} ${fmt(pts[0].y)}`;
      let cursor = pts[0];
      for (let i = 1; i < pts.length - 1; i += 1) {
        const prev = pts[i - 1];
        const curr = pts[i];
        const next = pts[i + 1];
        const inLen = dist(prev, curr) || 1;
        const outLen = dist(curr, next) || 1;
        const inUx = (curr.x - prev.x) / inLen;
        const inUy = (curr.y - prev.y) / inLen;
        const outUx = (next.x - curr.x) / outLen;
        const outUy = (next.y - curr.y) / outLen;
        const theta = Math.abs(turnBetween(prev, curr, next));
        if (theta < 0.09) {
          d += ` L ${fmt(curr.x)} ${fmt(curr.y)}`;
          cursor = curr;
          continue;
        }
        const used = Math.min(theta, 2.4);
        const previous =
          i > 1 ? cornerSetback(pts[i - 2], pts[i - 1], curr, radius) : 0;
        const following =
          i + 2 < pts.length ? cornerSetback(curr, next, pts[i + 2], radius) : 0;
        const setback = Math.min(
          radius * Math.tan(used / 2),
          Math.max(8, inLen - previous),
          Math.max(8, outLen - following),
        );
        const arcRadius = setback / Math.tan(used / 2);
        const handle = (4 / 3) * Math.tan(used / 4) * arcRadius;
        const a = { x: curr.x - inUx * setback, y: curr.y - inUy * setback };
        const b = { x: curr.x + outUx * setback, y: curr.y + outUy * setback };
        const c1 = { x: a.x + inUx * handle, y: a.y + inUy * handle };
        const c2 = { x: b.x - outUx * handle, y: b.y - outUy * handle };
        if (dist(cursor, a) > 0.4) d += ` L ${fmt(a.x)} ${fmt(a.y)}`;
        d += ` C ${fmt(c1.x)} ${fmt(c1.y)}, ${fmt(c2.x)} ${fmt(c2.y)}, ${fmt(b.x)} ${fmt(b.y)}`;
        cursor = b;
      }
      const last = pts[pts.length - 1];
      d += ` L ${fmt(last.x)} ${fmt(last.y)}`;
      return d;
    };

    const toSmoothPath = (points, minRadius) => {
      const pts = dedupe(points);
      if (pts.length < 2) return "";
      const fmt = (value) => value.toFixed(1);
      if (pts.length === 2) {
        return `M ${fmt(pts[0].x)} ${fmt(pts[0].y)} L ${fmt(pts[1].x)} ${fmt(pts[1].y)}`;
      }
      let d = `M ${fmt(pts[0].x)} ${fmt(pts[0].y)}`;
      for (let i = 0; i < pts.length - 1; i += 1) {
        const p0 = pts[Math.max(0, i - 1)];
        const p1 = pts[i];
        const p2 = pts[i + 1];
        const p3 = pts[Math.min(pts.length - 1, i + 2)];
        const span = dist(p1, p2) || 1;
        const turn = i > 0 ? Math.abs(turnBetween(p0, p1, p2)) : 0;
        const maxHandle = Math.min(span * 0.42, Math.max(span * 0.2, minRadius * (turn > 0.6 ? 0.9 : 0.45)));
        const clamp = (ax, ay, bx, by) => {
          const dx = bx - ax;
          const dy = by - ay;
          const len = Math.hypot(dx, dy) || 1;
          if (len <= maxHandle) return [bx, by];
          return [ax + (dx / len) * maxHandle, ay + (dy / len) * maxHandle];
        };
        let [c1x, c1y] = clamp(p1.x, p1.y, p1.x + (p2.x - p0.x) / 6, p1.y + (p2.y - p0.y) / 6);
        let [c2x, c2y] = clamp(p2.x, p2.y, p2.x - (p3.x - p1.x) / 6, p2.y - (p3.y - p1.y) / 6);
        d += ` C ${fmt(c1x)} ${fmt(c1y)}, ${fmt(c2x)} ${fmt(c2y)}, ${fmt(p2.x)} ${fmt(p2.y)}`;
      }
      return d;
    };

    const monotonic = (points) => {
      let y = -Infinity;
      return points
        .filter((point) => point && Number.isFinite(point.x) && Number.isFinite(point.y))
        .map((point) => {
          y = Math.max(y, point.y);
          return { x: point.x, y };
        });
    };

    const alignDoor = () => {
      const img = document.querySelector(".hero-sketch");
      if (img instanceof HTMLElement) img.style.transform = "";
    };

    const build = () => {
      const width = main.clientWidth;
      const phone = width <= 768;
      const founderStroke = phone ? 24 : Math.max(24, Math.round((140 * width) / 1710));
      const companyStroke = phone ? 12 : 50;
      const turnRadius = width >= 1081 ? 120 : Math.max(36, (120 * width) / 1440);
      const hero = box(document.querySelector("#hero"));
      const headline = box(document.querySelector(".hero h1"));
      const clients = box(document.querySelector("#clients"));
      const exit = box(document.querySelector("#exit-card"));
      const caseCard = box(document.querySelector("#case-j article")) || box(document.querySelector("#case-j"));
      const next = box(document.querySelector("#next"));
      if (!hero || !headline || !clients || !exit || !next) return;

      const footer = document.querySelector("#footer") || document.querySelector("footer");
      const mainRect = main.getBoundingClientRect();
      const waveEl = footer?.querySelector(".connect-wave") || footer?.querySelector("svg");
      const waveRect = (waveEl || footer)?.getBoundingClientRect();
      const end = waveRect ? waveRect.bottom - mainRect.top : main.clientHeight - 6;
      const bandTop = clients.bottom + 70;
      const bandBottom = Math.max(bandTop + 40, exit.y - 36);
      const entryY = Math.min(bandBottom, Math.max(bandTop, (clients.bottom + exit.y) / 2));

      const swellDark = document.querySelector("#swell-dark");
      const swellLight = document.querySelector("#swell-light");
      const paintFunnel = () => {
        if (!(swellDark instanceof SVGStopElement) || !(swellLight instanceof SVGStopElement)) return;
        const funnel = document.querySelector("#next .swell-bg");
        if (!(funnel instanceof Element)) return;
        const strip = document.querySelector(".footer-wave");
        const funnelRect = funnel.getBoundingClientRect();
        const stripRect = strip instanceof HTMLElement ? strip.getBoundingClientRect() : funnelRect;
        const edge = window.innerHeight * 0.5;
        const atEnd =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        const fillY = reduce.matches || atEnd ? stripRect.bottom + 2 : edge;
        const fractionIn = (rect) => {
          if (rect.height <= 1 || fillY <= rect.top) return 0;
          if (fillY >= rect.bottom) return 1;
          return (fillY - rect.top) / rect.height;
        };
        const paintStops = (amount) => {
          if (amount <= 0) {
            swellDark.setAttribute("stop-color", "#D4F4EB");
            swellLight.setAttribute("stop-color", "#D4F4EB");
            swellDark.setAttribute("offset", "0");
            swellLight.setAttribute("offset", "1");
            return;
          }
          if (amount >= 1) {
            swellDark.setAttribute("stop-color", "#28DBB0");
            swellLight.setAttribute("stop-color", "#28DBB0");
            swellDark.setAttribute("offset", "0");
            swellLight.setAttribute("offset", "1");
            return;
          }
          const cut = amount.toFixed(4);
          swellDark.setAttribute("stop-color", "#28DBB0");
          swellLight.setAttribute("stop-color", "#D4F4EB");
          swellDark.setAttribute("offset", cut);
          swellLight.setAttribute("offset", cut);
        };
        paintStops(fractionIn(funnelRect));
        if (strip instanceof HTMLElement) {
          const amount = fractionIn(stripRect);
          if (amount >= 1) strip.style.background = "#28DBB0";
          else if (amount <= 0) strip.style.background = "#D4F4EB";
          else {
            const pct = (amount * 100).toFixed(2);
            strip.style.background = `linear-gradient(to bottom, #28DBB0 ${pct}%, #D4F4EB ${pct}%)`;
          }
        }
      };

      const revealArt = () => {
        const mid = window.innerHeight * 0.5;
        document.querySelectorAll("[data-line-reveal]").forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const rect = el.getBoundingClientRect();
          const reached = reduce.matches || rect.top <= mid + 80;
          el.classList.toggle("is-drawn", reached);
        });
      };

      root.style.display = "";
      const rightOf = (card) => (card ? Math.min(width - 70, card.right + 78) : width - 80);
      const enterX = Math.min(exit.cx, exit.right - 90);
      const splitY = exit.y + 130;
      const beside = rightOf(exit);

      const clearLane = () => {
        const half = founderStroke / 2;
        const gap = 14;
        const y0 = box(document.querySelector("#exit"))?.bottom ?? exit.bottom;
        const y1 = next.y;
        const reviews = document.querySelector("#reviews");
        const blockers = [];
        const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT);
        while (walker.nextNode()) {
          const node = walker.currentNode;
          if (!node.textContent || !node.textContent.trim()) continue;
          if (reviews?.contains(node.parentElement)) continue;
          const range = document.createRange();
          range.selectNodeContents(node);
          for (const rect of range.getClientRects()) {
            const top = rect.top - mainRect.top;
            const bot = rect.bottom - mainRect.top;
            if (bot < y0 || top > y1 || rect.width < 2) continue;
            if (rect.right < mainRect.left || rect.left > mainRect.right) continue;
            blockers.push({ l: rect.left - mainRect.left, r: rect.right - mainRect.left });
          }
        }
        document.querySelectorAll("a, button, article, .card, img").forEach((el) => {
          if (el.closest("#reviews, .guarantee-scale, .next-icons, .exit-machine")) return;
          const pink = /234,\s*21,\s*87/.test(getComputedStyle(el).backgroundColor);
          if (!pink && el.tagName !== "IMG" && !el.classList.contains("card")) return;
          const rect = el.getBoundingClientRect();
          const top = rect.top - mainRect.top;
          const bot = rect.bottom - mainRect.top;
          if (bot < y0 || top > y1 || rect.width < 8) return;
          blockers.push({ l: rect.left - mainRect.left, r: rect.right - mainRect.left });
        });
        for (let x = 12; x <= width - half; x += 4) {
          const left = x - half - gap;
          const right = x + half + gap;
          if (!blockers.some((item) => item.r > left && item.l < right)) return x;
        }
        return half;
      };

      founder.setAttribute("stroke-width", String(founderStroke));
      company.setAttribute("stroke-width", String(companyStroke));
      companyMask.setAttribute("stroke-width", String(companyStroke + 16));
      if (companyStroke > 0) {
        company.setAttribute(
          "stroke-dasharray",
          `${Math.round(companyStroke * 1.4)} ${Math.round(companyStroke * 1.88)}`,
        );
      }

      const at = (sel) => box(document.querySelector(sel));
      const pinJ = at("#case-j .portrait");
      const stones = at("#first-draw");
      const firstCard = at("#first-card");
      const apply1 = at("#apply-first .btn-apply");
      const forYou = at("#for-you .card.ink");
      const notYou = at("#for-you .card.rose");
      const flyer = at(".why-sketch");
      const leaders = at("#reviews");
      const pinV = at("#case-v .portrait");
      const seen = at("#asseen .asseen-frame");
      const apply2 = at("#apply-v .btn-apply");
      const message = at("#message-card");
      const finders = at("#wayfinders");
      const track = at(".track-card");
      const guarantee = at(".guarantee-card");
      const swell = at("#next .swell-bg") || next;
      const mouthX = swell.x + swell.w * (720 / 1440);
      const intoMouth = swell.y + Math.min(72, Math.max(40, swell.h * 0.08));
      const founderPts = [];
      const add = (list, x, y) => {
        const prev = list[list.length - 1];
        const point = {
          x: Math.max(-40, Math.min(width + 60, x)),
          y: prev ? Math.max(prev.y + 28, y) : y,
        };
        if (!prev || dist(prev, point) > 24) list.push(point);
      };
      const put = (x, y) => {
        const prev = founderPts[founderPts.length - 1];
        const point = {
          x: Math.max(-80, Math.min(width + 80, x)),
          y: prev ? Math.max(prev.y + 8, y) : y,
        };
        if (!prev || dist(prev, point) > 10) founderPts.push(point);
      };
      let tipX = width * 0.5;
      let tipY = entryY;
      const jointW = founderStroke;
      const machine = box(document.querySelector(".exit-machine"));
      const whyCard = box(document.querySelector("#why .why-copy"));
      if (phone) {
        const down = (el, from = 0.2, to = 0.8) => {
          if (!el) return;
          put(el.cx, el.y + el.h * from);
          put(el.cx, el.y + el.h * to);
        };
        if (machine) {
          put(machine.left + machine.w * 0.68, machine.y + machine.h * 0.5);
          put(machine.left + machine.w * 0.92, machine.y + machine.h * 0.64);
          put(machine.right - 6, machine.bottom - 4);
        }
        down(pinJ, 0.2, 1);
        down(stones, 0.45, 1);
        down(firstCard, 0.2, 0.85);
        if (apply1) put(apply1.cx, apply1.cy);
        down(forYou, 0.15, 0.9);
        down(notYou, 0.15, 0.85);
        down(whyCard, 0.2, 0.85);
        down(flyer, 0.3, 0.75);
        down(leaders, 0.25, 0.8);
        down(pinV, 0.2, 0.9);
        down(seen, 0.3, 0.75);
        if (apply2) put(apply2.cx, apply2.cy);
        down(message, 0.15, 0.9);
        down(finders, 0.15, 0.55);
        if (track) {
          put(track.cx, track.bottom + 6);
          put(track.cx, track.bottom + 28);
        }
        down(guarantee, 0.2, 0.92);
      } else if (machine) {
        // Hidden cap inside the body. The stroke slides out of the right
        // wall at the lever base, bends down, and drops straight onto the pin.
        const lane = pinJ ? pinJ.cx : machine.right - founderStroke * 0.5;
        const leverY = machine.y + machine.h * 0.49;
        const radius = Math.max(100, founderStroke * 0.8);
        const bendX = lane - radius;
        const startX = bendX - founderStroke * 0.85;
        founderPts.push({ x: startX, y: leverY });
        founderPts.push({ x: bendX, y: leverY });
        const steps = 12;
        for (let i = 1; i <= steps; i += 1) {
          const t = (-Math.PI / 2) * (1 - i / steps);
          founderPts.push({
            x: bendX + radius * Math.cos(t),
            y: leverY + radius * (1 + Math.sin(t)),
          });
        }
        founderPts.push({ x: lane, y: leverY + radius + 36 });
        if (pinJ) founderPts.push({ x: lane, y: pinJ.y - 12 });
        tipX = startX;
        tipY = leverY;
      }
      if (!phone) {
      const lane = apply1 ? apply1.cx : stones ? stones.cx + stones.w * 0.22 : width * 0.72;
      if (pinJ && stones) {
        // Image pixel positions in spot1-v3@2x (1048×1062). The line drops
        // from the pin, turns at ankle height, and stays under the fill
        // until it leaves the right side of the last stone.
        const ix = (px) => stones.left + stones.w * (px / 1048);
        const iy = (py) => stones.y + stones.h * (py / 1062);
        const ankleX = ix(360);
        const ankleY = iy(730);
        const span = ankleX - pinJ.cx;
        const room = ankleY - (pinJ.bottom + 40);
        const turn = Math.min(span, room);
        // Centre sits down-right of the vertical run, so the arc arrives
        // from above on a vertical tangent and leaves toward the ankle.
        const arcX = pinJ.cx + turn;
        const arcY = ankleY - turn;
        founderPts.push({ x: pinJ.cx, y: pinJ.y + pinJ.h * 0.45 });
        founderPts.push({ x: pinJ.cx, y: pinJ.bottom - 8 });
        founderPts.push({ x: pinJ.cx, y: arcY });
        const pinSteps = 12;
        for (let i = 1; i <= pinSteps; i += 1) {
          const theta = Math.PI - (i / pinSteps) * (Math.PI / 2);
          founderPts.push({
            x: arcX + turn * Math.cos(theta),
            y: arcY + turn * Math.sin(theta),
          });
        }
        if (ankleX > arcX + 12) founderPts.push({ x: ankleX, y: ankleY });
        const stoneY = iy(830);
        const exitLane = Math.min(lane, ix(958) + founderStroke * 0.32);
        const bendR = 92;
        const bendX = exitLane - bendR;
        const approachX = Math.min(ix(900), bendX);
        founderPts.push({ x: approachX, y: stoneY });
        if (bendX > approachX + 8) founderPts.push({ x: bendX, y: stoneY });
        const stoneSteps = 12;
        for (let i = 1; i <= stoneSteps; i += 1) {
          const t = (-Math.PI / 2) * (1 - i / stoneSteps);
          founderPts.push({
            x: bendX + bendR * Math.cos(t),
            y: stoneY + bendR * (1 + Math.sin(t)),
          });
        }
        if (apply1) {
          // exitLane only while approaching the button. Back on the original
          // lane before the centre, still covered by the button.
          founderPts.push({ x: exitLane, y: apply1.y - 16 });
          founderPts.push({ x: exitLane, y: apply1.y + 8 });
          founderPts.push({ x: lane, y: apply1.y + 16 });
          founderPts.push({ x: lane, y: apply1.cy });
          founderPts.push({ x: lane, y: apply1.bottom + founderStroke });
        }
      } else if (apply1) {
        founderPts.push({ x: lane, y: apply1.y - 16 });
        founderPts.push({ x: lane, y: apply1.cy });
        founderPts.push({ x: lane, y: apply1.bottom + founderStroke });
      }
      if (forYou) {
        put(lane, forYou.y + founderStroke);
        put(lane, forYou.bottom + 36);
      }
      if (flyer) {
        const centre = flyer.left + flyer.w * 0.5;
        const wave = box(document.querySelector(".section-wave"));
        const intoWave = wave ? wave.y + wave.h * 0.7 : flyer.bottom + founderStroke;
        put(centre, flyer.bottom - flyer.h * 0.04);
        put(centre, intoWave);
        put(centre, (wave ? wave.bottom : flyer.bottom) + founderStroke * 0.55);
      }
      if (pinV) {
        put(pinV.cx, pinV.y - founderStroke * 0.8);
        put(pinV.cx, pinV.cy);
        put(pinV.cx, pinV.bottom + 16);
      }
      const lane2 = pinV ? pinV.cx : apply2 ? apply2.cx : width * 0.32;
      if (seen) {
        put(lane2, seen.y + seen.h * 0.45);
        put(lane2, seen.bottom + 24);
      }
      if (apply2) put(lane2, apply2.cy);
      if (message) {
        put(lane2, message.y - 12);
        put(message.left + message.w * 0.31, message.bottom + 6);
        put(message.left + message.w * 0.45, message.bottom + 90);
        put(message.left + message.w * 0.55, message.bottom + 180);
      }
      const photo = box(document.querySelector("#wayfinders .wf-group"));
      if (photo) {
        put(photo.cx, photo.y + photo.h * 0.25);
        put(photo.cx, photo.bottom - 8);
      }
      if (track) {
        put(track.cx, track.bottom + 12);
        put(track.cx, track.bottom + Math.max(40, founderStroke));
      }
      if (guarantee) {
        put(guarantee.cx, guarantee.y + guarantee.h * 0.45);
        put(guarantee.cx, guarantee.bottom - 6);
      }
      }
      put(mouthX, intoMouth);
      const dropIn = null;

      const companyY = entryY - Math.max(36, companyStroke + 16);
      const companyExitY = exit.y + exit.h * 0.66;
      const companyPts = [];
      const cover = document.querySelector("#company-cover");
      const companyLane = Math.min(width - founderStroke * 0.35, exit.right + founderStroke * 0.35);
      add(companyPts, -30, companyY);
      add(companyPts, companyLane + founderStroke * 0.55, companyY);
      add(companyPts, companyLane + founderStroke * 0.7, exit.y + exit.h * 0.4);
      add(companyPts, width + 40, companyExitY);
      if (cover instanceof SVGRectElement) {
        cover.setAttribute("width", "0");
        cover.setAttribute("height", "0");
      }

      const height = Math.max(200, end);
      root.style.top = "0px";
      root.style.height = `${height}px`;
      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
      svg.setAttribute("width", String(width));
      svg.setAttribute("height", String(height));

      const routeRadius = Math.max(founderStroke, phone ? Math.max(36, turnRadius * 0.7) : founderStroke);
      const companyRadius = phone ? Math.max(28, turnRadius * 0.85) : 72;
      let founderD = toSmoothPath(founderPts, founderStroke);
      if (dropIn && dropIn.radius > 8 && intoMouth > bendY) {
        const radius = dropIn.radius;
        const handle = radius * 0.5522847498;
        const arcStart = mouthX - radius;
        founderD += ` C ${(arcStart + handle).toFixed(1)} ${bendY.toFixed(1)}, ${mouthX.toFixed(1)} ${(bendY + radius - handle).toFixed(1)}, ${mouthX.toFixed(1)} ${(bendY + radius).toFixed(1)}`;
        if (intoMouth > bendY + radius + 1) {
          founderD += ` L ${mouthX.toFixed(1)} ${intoMouth.toFixed(1)}`;
        }
      }
      founder.setAttribute("d", founderD);
      let paintWide = () => {};
      const widePath = document.querySelector("#founder-wide");
      if (widePath instanceof SVGPathElement) widePath.setAttribute("d", "");
      const join = document.querySelector("#founder-join");
      const fullLength = founder.getTotalLength();
      const taperLen = Math.min(phone ? 90 : 220, Math.max(48, fullLength * 0.05));
      // The stroke itself starts at the hero wave, so it can draw through the
      // hidden stretch. No separate taper.
      if (false && join instanceof SVGPathElement && fullLength > taperLen + founderStroke) {
        const startW = jointW;
        const cap = founderStroke / 2;
        const samples = [];
        const step = 6;
        const covered = taperLen + cap;
        for (let length = 0; length <= covered; length += step) {
          const point = founder.getPointAtLength(length);
          const next = founder.getPointAtLength(Math.min(fullLength - 1, length + step));
          const dx = next.x - point.x;
          const dy = next.y - point.y;
          const hyp = Math.hypot(dx, dy) || 1;
          const t = Math.min(1, length / taperLen);
          const ease = t * t * (3 - 2 * t);
          const half = (startW + (founderStroke - startW) * ease) / 2;
          samples.push({ x: point.x, y: point.y, nx: -dy / hyp, ny: dx / hyp, half });
        }
        const edge = (side) =>
          samples.map((sample) => {
            const x = sample.x + sample.nx * sample.half * side;
            const y = sample.y + sample.ny * sample.half * side;
            return `${x.toFixed(1)} ${y.toFixed(1)}`;
          });
        const left = edge(1);
        const right = edge(-1).reverse();
        join.setAttribute("d", `M ${left[0]} L ${left.slice(1).join(" L ")} L ${right.join(" L ")} Z`);
        const from = covered - 4;
        const trail = [];
        for (let length = from; length < fullLength; length += 14) trail.push(founder.getPointAtLength(length));
        trail.push(founder.getPointAtLength(fullLength));
        founder.setAttribute(
          "d",
          trail.map((point, index) => `${index ? "L" : "M"} ${point.x.toFixed(1)} ${point.y.toFixed(1)}`).join(" "),
        );
      } else if (join instanceof SVGPathElement) {
        join.setAttribute("d", "");
      }
      company.setAttribute("d", fillet(companyPts, companyRadius));
      companyMask.setAttribute("d", fillet(companyPts, companyRadius));
      alignDoor();

      const figures = document.querySelector("#route-figures");
      const scale = phone ? 110 / 134 : 1;
      if (figures instanceof HTMLElement) {
        figures.style.setProperty("--route-scale", String(scale));
        const mainRectNow = main.getBoundingClientRect();
        const blockers = [];
        const addRect = (rect) => {
          if (rect.width < 2 || rect.height < 2) return;
          blockers.push({
            l: rect.left - mainRectNow.left,
            r: rect.right - mainRectNow.left,
            t: rect.top - mainRectNow.top,
            b: rect.bottom - mainRectNow.top,
          });
        };
        main.querySelectorAll("h1, h2, h3, p, li, a, button, img").forEach((el) => {
          if (!(el instanceof Element)) return;
          if (el.closest(".route-figures, .through-line, .exit-machine")) return;
          if (el.classList.contains("portrait")) {
            const rect = el.getBoundingClientRect();
            addRect({
              left: rect.left,
              right: rect.right,
              top: rect.top + rect.height * 0.08,
              bottom: rect.bottom,
              width: rect.width,
              height: rect.height * 0.92,
            });
            return;
          }
          for (const rect of el.getClientRects()) addRect(rect);
        });
        const machineBlock = document.querySelector(".exit-machine");
        if (machineBlock) addRect(machineBlock.getBoundingClientRect());
        const dashes = [];
        const companyLength = company.getTotalLength();
        for (let length = 0; length <= companyLength; length += 18) {
          const point = company.getPointAtLength(length);
          const pad = companyStroke / 2 + 2;
          dashes.push({
            l: point.x - pad,
            r: point.x + pad,
            t: point.y - pad,
            b: point.y + pad,
          });
        }
        const ink = [];
        const founderLengthForInk = founder.getTotalLength();
        for (let length = 0; length <= founderLengthForInk; length += 24) {
          const point = founder.getPointAtLength(length);
          const pad = founderStroke / 2 + 8;
          ink.push({ l: point.x - pad, r: point.x + pad, t: point.y - pad, b: point.y + pad });
        }
        const hits = (rect, items) =>
          items.some((item) => item.r > rect.l && item.l < rect.r && item.b > rect.t && item.t < rect.b);
        const specOf = (fig) => {
          const bw = Number(fig.style.getPropertyValue("--bw"));
          const figScale = phone && fig.dataset.lineFigure === "3" ? 110 / 146 : scale;
          return {
            ox: Number(fig.style.getPropertyValue("--ox")),
            oy: Number(fig.style.getPropertyValue("--oy")),
            bw,
            bh: Number(fig.style.getPropertyValue("--bh")),
            pw: fig.dataset.lineFigure === "1" ? 80 : 62,
            scale: figScale,
          };
        };
        const bubbleBox = (x, y, spec) => ({
          l: x + spec.ox * spec.scale,
          r: x + (spec.ox + spec.bw) * spec.scale,
          t: y + spec.oy * spec.scale,
          b: y + (spec.oy + spec.bh) * spec.scale,
        });
        const groupBox = (x, y, spec) => {
          const bubble = bubbleBox(x, y, spec);
          const right = x + spec.pw * spec.scale;
          const bottom = y + 150 * spec.scale;
          return {
            l: Math.min(x, bubble.l),
            r: Math.max(right, bubble.r),
            t: Math.min(y, bubble.t),
            b: Math.max(bottom, bubble.b),
          };
        };
        const clear = (x, y, spec) => {
          const group = groupBox(x, y, spec);
          if (group.l < 4 || group.r > width - 4 || group.t < 0) return false;
          if (hits(group, blockers) || hits(group, ink)) return false;
          if (hits(bubbleBox(x, y, spec), dashes)) return false;
          return true;
        };
        const settle = (x, y, spec) => {
          if (clear(x, y, spec)) return { x, y };
          for (let step = 8; step <= 280; step += 8) {
            for (const dx of [0, -20, 20, -40, 40, -70, 70, -110, 110]) {
              if (clear(x + dx, y + step, spec)) return { x: x + dx, y: y + step };
              if (clear(x + dx, y - step, spec)) return { x: x + dx, y: y - step };
            }
          }
          return { x, y };
        };
        const founderLength = founder.getTotalLength();
        const triggerAt = (y) => {
          const start = founder.getPointAtLength(0).y;
          const finish = founder.getPointAtLength(founderLength).y;
          if (y <= start) return 0;
          if (y >= finish) return founderLength;
          let lo = 0;
          let hi = founderLength;
          for (let step = 0; step < 24; step += 1) {
            const mid = (lo + hi) / 2;
            if (founder.getPointAtLength(mid).y < y) lo = mid;
            else hi = mid;
          }
          return hi;
        };
        const lineX = (y) => {
          const length = triggerAt(y);
          return founder.getPointAtLength(Math.min(founderLength, Math.max(0, length))).x;
        };
        const lineEdge = (y0, y1, side) => {
          let edge = side === "left" ? Infinity : -Infinity;
          const step = Math.max(12, (y1 - y0) / 8);
          for (let y = y0; y <= y1; y += step) {
            const x = lineX(y);
            edge = side === "left" ? Math.min(edge, x) : Math.max(edge, x);
          }
          return edge + (side === "left" ? -founderStroke / 2 : founderStroke / 2);
        };
        const messageCard = box(document.querySelector("#message-card"));
        const wayTitle = box(document.querySelector("#wayfinders h2"));
        const guaranteeCard = box(document.querySelector(".guarantee-card"));
        const place = (name, x, y) => {
          const fig = figures.querySelector(`[data-line-figure="${name}"]`);
          if (!(fig instanceof HTMLElement)) return;
          const spec = specOf(fig);
          const spot = settle(x, y, spec);
          fig.style.setProperty("--route-scale", String(spec.scale));
          fig.style.left = `${spot.x}px`;
          fig.style.top = `${spot.y}px`;
          fig.dataset.trigger = String(triggerAt(spot.y + 75 * spec.scale));
          fig.classList.add("is-placed");
        };
        if (wayTitle) {
          const p2Top = (messageCard ? messageCard.bottom + 10 : wayTitle.y - 180) - (-22.6) * scale;
          const beside = lineEdge(p2Top, p2Top + 150 * scale, "left") - 16;
          const p2Left = beside - 62 * scale;
          place("2", p2Left, p2Top);
        }
        if (phone) {
          const note = box(document.querySelector("#next .next-note"));
          const footer = box(document.querySelector("footer"));
          const fig = figures.querySelector('[data-line-figure="3"]');
          const spec = fig instanceof HTMLElement ? specOf(fig) : null;
          if (spec && footer) {
            const lowest = footer.y - 4 - 150 * spec.scale;
            const underNote = (note ? note.bottom + 6 : lowest) - spec.oy * spec.scale;
            const p3Top = Math.min(underNote, lowest);
            const p3Left = width - 12 - (spec.ox + spec.bw) * spec.scale;
            place("3", p3Left, p3Top);
          }
        } else if (guaranteeCard) {
          const p3Top = guaranteeCard.bottom + 12 - (-23.5) * scale;
          const beside = lineEdge(p3Top, p3Top + 150 * scale, "right") + 18;
          place("3", beside, p3Top);
        }
      }

      triggers.forEach((trigger) => trigger.kill());
      triggers = [];

      const reveal = revealArt;

      const paint = (path, length) => {
        if (reduce.matches) {
          path.style.strokeDasharray = `${length}`;
          path.style.strokeDashoffset = "0";
          return length;
        }
        const svgTop = svg.getBoundingClientRect().top;
        const target = window.innerHeight * 0.5;
        let lo = 0;
        let hi = length;
        const startY = svgTop + path.getPointAtLength(0).y;
        const endY = svgTop + path.getPointAtLength(length).y;
        if (target <= startY) hi = 0;
        else if (target >= endY) hi = length;
        else {
          for (let step = 0; step < 22; step += 1) {
            const midLength = (lo + hi) / 2;
            const y = svgTop + path.getPointAtLength(midLength).y;
            if (y < target) lo = midLength;
            else hi = midLength;
          }
        }
        path.style.strokeDasharray = `${length}`;
        path.style.strokeDashoffset = String(length - hi);
        return hi;
      };

      const draw = () => {
        const drawn = paint(founder, founder.getTotalLength());
        paintWide(drawn);
        paint(companyMask, companyMask.getTotalLength());
        const meet = document.querySelector("#founder-join");
        if (meet instanceof SVGPathElement) {
          const reached = reduce.matches || svg.getBoundingClientRect().top + tipY <= window.innerHeight * 0.5;
          meet.style.opacity = reached ? "1" : "0";
        }
        paintFunnel();
        reveal();
        document.querySelectorAll("[data-line-figure]").forEach((fig) => {
          if (!(fig instanceof HTMLElement) || fig.classList.contains("is-shown")) return;
          const trigger = Number(fig.dataset.trigger);
          if (reduce.matches || (Number.isFinite(trigger) && drawn >= trigger)) fig.classList.add("is-shown");
        });
      };

      draw();

      if (!reduce.matches) {
        triggers.push(
          ScrollTrigger.create({
            start: 0,
            end: "max",
            scrub: 0.15,
            onUpdate: draw,
          }),
        );
      }
    };

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(build);
    };

    schedule();
    window.addEventListener("load", schedule);
    window.addEventListener("resize", schedule);
    reduce.addEventListener("change", schedule);
    document.fonts?.ready.then(schedule);
  }
</script>
