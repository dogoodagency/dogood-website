---
import "../styles/booking.css";
import Base from "../layouts/Base.astro";

interface Props {
  /** The visible H1. */
  title: string;
  /** Smaller text on the same line as the H1, e.g. "– 45 min". */
  titleSuffix?: string;
  /** TidyCal path, e.g. "dogoodagency/internal". */
  tidycal: string;
  /** Browser title (SEO). */
  seoTitle: string;
  description: string;
  /** Absolute canonical URL. */
  canonical: string;
  robots?: string;
  hideOptin?: boolean;
}

const { title, titleSuffix, tidycal, seoTitle, description, canonical, robots, hideOptin } = Astro.props;
const hasAfter = Astro.slots.has("after");
const fallbackHref = `https://tidycal.com/${tidycal}`;
---

<Base title={seoTitle} description={description} canonical={canonical} robots={robots} hideOptin={hideOptin}>
  <article class="bk-page">
    <div class="bk-grid">
      <div class="bk-copy">
        <div class="bk-copy-inner">
          <h1>
            {title}
            {titleSuffix && <span class="bk-h1-suffix">{titleSuffix}</span>}
          </h1>
          <slot />
        </div>
      </div>
      <div class="bk-panel">
        <div class="tidycal-embed" data-path={tidycal}></div>
        <script src="https://asset-tidycal.b-cdn.net/js/embed.js" async is:inline></script>
        <noscript>
          <p class="bk-noscript"><a href={fallbackHref}>Open the booking calendar</a></p>
        </noscript>
      </div>
    </div>
    {
      hasAfter && (
        <div class="bk-after">
          <slot name="after" />
        </div>
      )
    }
  </article>
</Base>
