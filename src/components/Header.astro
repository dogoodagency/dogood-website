---
import { Image } from "astro:assets";
import logo from "../assets/photos/logo-nav.png";
import { urls } from "../data/homepage";

const links = [
  { href: "/how-it-works", label: "How it works" },
  { href: "/stories", label: "Stories" },
  { href: "/wayfinders", label: "Wayfinders" },
  { href: "/for-advisors", label: "For Advisors", menu: "nav-advisors" },
];

const advisorResources = { href: "/for-advisors/resources", label: "Resources" };
---

<header class="nav">
  <div class="nav-bar">
    <a class="nav-logo" href="/">
      <Image
        src={logo}
        alt="DoGood Agency"
        widths={[240, 480, 720]}
        sizes="148px"
        loading="eager"
        fetchpriority="high"
      />
    </a>
    <ul class="nav-links" aria-label="Primary">
      {
        links.map((link) => (
          <li class:list={["nav-item", link.menu && "has-menu"]}>
            <a
              href={link.href}
              aria-expanded={link.menu ? "false" : undefined}
              aria-haspopup={link.menu ? "true" : undefined}
              aria-controls={link.menu}
            >
              {link.label}
            </a>
            {link.menu && (
              <div class="nav-drop" id={link.menu}>
                <a href={advisorResources.href}>{advisorResources.label}</a>
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <button class="nav-burger" type="button" aria-expanded="false" aria-controls="nav-panel">
      <span class="sr-only">Menu</span>
      <span class="nav-burger-icon" aria-hidden="true"></span>
    </button>
  </div>
  <a class="nav-apply" href={urls.apply}>
    Apply for Stage 1
    <picture class="nav-apply-icon">
      <source type="image/webp" srcset="/nav/apply-pill-icon-open-door-32.webp 1x, /nav/apply-pill-icon-open-door-64.webp 2x" />
      <img src="/nav/apply-pill-icon-open-door-32.png" srcset="/nav/apply-pill-icon-open-door-32.png 1x, /nav/apply-pill-icon-open-door-64.png 2x" width="32" height="32" alt="" />
    </picture>
  </a>
  <nav id="nav-panel" class="nav-panel" hidden aria-label="Primary">
    {
      links.map((link) => (
        <>
          <a href={link.href}>{link.label}</a>
          {link.menu && (
            <a class="nav-sub" href={advisorResources.href}>
              {advisorResources.label}
            </a>
          )}
        </>
      ))
    }
  </nav>
</header>

<script>
  const header = document.querySelector("header.nav");
  const burger = header?.querySelector(".nav-burger");
  const panel = header?.querySelector("#nav-panel");

  if (header instanceof HTMLElement && burger instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const items = () => [...panel.querySelectorAll("a")];

    const setOpen = (open) => {
      burger.setAttribute("aria-expanded", open ? "true" : "false");
      panel.hidden = !open;
    };

    burger.addEventListener("click", () => {
      const open = burger.getAttribute("aria-expanded") !== "true";
      setOpen(open);
      if (open) items()[0]?.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || burger.getAttribute("aria-expanded") !== "true") return;
      setOpen(false);
      burger.focus();
    });

    panel.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || panel.hidden) return;
      const list = items();
      const first = list[0];
      const last = list[list.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        burger.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        burger.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node) || header.contains(event.target)) return;
      if (burger.getAttribute("aria-expanded") === "true") setOpen(false);
    });
  }

  const advisor = header?.querySelector(".nav-item.has-menu");
  const advisorLink = advisor?.querySelector("a[aria-controls]");
  const advisorMenu = advisor?.querySelector(".nav-drop");
  if (
    advisor instanceof HTMLElement &&
    advisorLink instanceof HTMLAnchorElement &&
    advisorMenu instanceof HTMLElement
  ) {
    let closing = false;
    const menuOpen = () => advisorLink.getAttribute("aria-expanded") === "true";
    const setMenu = (open) => {
      advisor.classList.toggle("is-open", open);
      advisorLink.setAttribute("aria-expanded", open ? "true" : "false");
    };
    const desktopMenu = () => {
      const list = advisor.closest(".nav-links");
      return list instanceof HTMLElement && getComputedStyle(list).display !== "none";
    };

    advisor.addEventListener("pointerenter", () => {
      if (desktopMenu()) setMenu(true);
    });
    advisor.addEventListener("pointerleave", () => {
      if (!advisor.contains(document.activeElement)) setMenu(false);
    });
    advisor.addEventListener("focusin", () => {
      if (closing || !desktopMenu()) return;
      setMenu(true);
    });
    advisor.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !advisor.contains(event.relatedTarget)) setMenu(false);
    });
    advisorLink.addEventListener("click", (event) => {
      if (!desktopMenu() || menuOpen()) return;
      event.preventDefault();
      setMenu(true);
      advisorMenu.querySelector("a")?.focus();
    });
    advisorLink.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" || !desktopMenu()) return;
      event.preventDefault();
      setMenu(true);
      advisorMenu.querySelector("a")?.focus();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menuOpen() || !desktopMenu()) return;
      closing = true;
      setMenu(false);
      advisorLink.focus();
      closing = false;
    });
  }
</script>
