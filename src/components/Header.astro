---
import { Image } from "astro:assets";
import logo from "../assets/photos/logo-nav.png";
import { urls } from "../data/homepage";

const links = [
  { href: "#first-step", label: "How it works" },
  { href: "#reviews", label: "Stories" },
  { href: "#wayfinders", label: "Wayfinders" },
  { href: "#", label: "For Advisors" },
];
---

<header class="nav">
  <a class="nav-logo" href="/">
    <Image
      src={logo}
      alt="DoGood Agency"
      widths={[240, 480, 720]}
      sizes="160px"
      loading="eager"
      fetchpriority="high"
    />
  </a>
  <ul class="nav-links" aria-label="Primary">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
    <li>
      <a class="btn-apply nav-cta" href={urls.apply}>Apply for Stage 1</a>
    </li>
  </ul>
  <details class="nav-menu">
    <summary>Menu</summary>
    <nav aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
      <a class="btn-apply nav-cta" href={urls.apply}>Apply for Stage 1</a>
    </nav>
  </details>
</header>
