---
/**
 * Advisor Center hub (Seb, 20 Nov 2026): three large cards that make it obvious this is a hub with three
 * parts, and that you can move between them. Sits right under the hero on all three Advisor Center pages.
 * The current part is filled DREAM and marked "You are here". Same names and lines as the nav menu
 * (src/data/site-links.ts, advisorLinks).
 * Usage: <AdvisorNav current="refer" />   (or "tools" / "insights")
 */
import { advisorLinks } from "../data/site-links";

interface Props {
  current: "refer" | "tools" | "insights";
}
const { current } = Astro.props;

const [overview] = advisorLinks.work;
const [tools, insights] = advisorLinks.resources;
const links = [
  { key: "refer", n: "01", icon: "handshake", ...overview },
  { key: "tools", n: "02", icon: "toolbox", ...tools },
  { key: "insights", n: "03", icon: "notes", ...insights },
] as const;

const icons: Record<string, string> = {
  handshake: '<path d="M3 11.5 7 8l4 2 3-2 7 3.5"/><path d="m7 8-4 4 6 6 2-1.5 2 1.5 6-6"/><path d="m10 13 2 2m1-4 3 3"/>',
  toolbox: '<rect x="3" y="8" width="18" height="11" rx="2"/><path d="M9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18"/>',
  notes: '<rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>',
};
---

<nav class="ahub" aria-labelledby="ahub-label">
  <p class="ahub-label" id="ahub-label"><span class="ahub-label-dot" aria-hidden="true"></span>Advisor Center · three parts</p>
  <ul class="ahub-list">
    {
      links.map((l) => (
        <li>
          <a class="ahub-card" href={l.href} aria-current={l.key === current ? "page" : undefined}>
            <span class="ahub-top">
              <span class="ahub-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons[l.icon]} /></span>
              <span class="ahub-n" aria-hidden="true">{l.n}</span>
            </span>
            <span class="ahub-title">{l.label}</span>
            <span class="ahub-detail">{l.detail}</span>
            <span class="ahub-go">{l.key === current ? "You are here" : "Go to this part →"}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .ahub { margin: 0 0 44px; }
  .ahub-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    color: #2a0b4f;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ahub-label-dot { width: 10px; height: 10px; border-radius: 50%; background: #28dbb0; }
  .ahub-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ahub-list li { margin: 0; }
  a.ahub-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 20px 22px 18px;
    border: 1.5px solid #c2b7dd;
    border-radius: 22px;
    background: #fff;
    color: #2a0b4f;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(42, 11, 79, 0.08);
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.ahub-card:hover,
  a.ahub-card:focus-visible {
    border-color: #2a0b4f;
    background: #f5f2ff;
    transform: translateY(-3px);
    box-shadow: 0 16px 30px rgba(42, 11, 79, 0.14);
  }
  a.ahub-card:focus-visible { outline: 2px solid #28dbb0; outline-offset: 3px; }
  .ahub-top { display: flex; align-items: center; justify-content: space-between; }
  .ahub-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #e7fcf4;
    color: #05745b;
  }
  .ahub-icon svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ahub-n { font-family: Georgia, "Times New Roman", serif; font-size: 22px; color: #8b7dae; }
  .ahub-title { font-size: 19px; font-weight: 800; line-height: 1.25; }
  .ahub-detail { flex: 1; color: #58447f; font-size: 15px; line-height: 1.45; }
  .ahub-go {
    align-self: flex-start;
    margin-top: 4px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #2a0b4f;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
  }
  a.ahub-card[aria-current="page"] { border-color: #2a0b4f; background: #2a0b4f; color: #fff; cursor: default; transform: none; }
  a.ahub-card[aria-current="page"] .ahub-detail { color: #d9d0ee; }
  a.ahub-card[aria-current="page"] .ahub-n { color: #c2b7dd; }
  a.ahub-card[aria-current="page"] .ahub-icon { background: #28dbb0; color: #2a0b4f; }
  a.ahub-card[aria-current="page"] .ahub-go { background: #28dbb0; color: #2a0b4f; }
  @media (max-width: 860px) {
    .ahub-list { grid-template-columns: 1fr; }
  }
</style>
