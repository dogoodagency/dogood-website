---
import { Image } from "astro:assets";
import logo from "../assets/photos/logo-nav.png";
import { urls } from "../data/homepage";
import { explore, offers, products, tools, advisorLinks, tm } from "../data/site-links";
import "../styles/footer.css";
import Wave from "./Wave.astro";

const action =
  "https://assets.mailerlite.com/jsonp/2046479/forms/180157154312849349/subscribe";

// The one master footer (Seb, 18 Nov 2026): every page renders this same component through Base.astro,
// so a change here changes the footer on every page. The opt-in is always shown; pages can only pass the
// colour of the wave above the footer (edge) and the homepage's filled wave (meetFunnel).
interface Props {
  meetFunnel?: boolean;
  edge?: string;
}

const { meetFunnel = false, edge } = Astro.props;
const copyrightYear = new Date().getFullYear();

// Link names and order follow Seb's footer mock-up (19 Nov 2026). All links come from src/data/site-links.ts,
// the same source the top nav reads, so a change there shows in the nav and this footer on every page.
const advisors = [...advisorLinks.work, ...advisorLinks.resources];
const columns = [
  { cls: "ft-explore", groups: [{ title: "Explore", links: explore }] },
  {
    cls: "ft-services",
    groups: [
      { title: "Services", links: [...offers, ...products] },
      { title: "Products", links: tools },
    ],
  },
  { cls: "ft-advisors", groups: [{ title: "Advisor Center", links: advisors }] },
];

const connectLinks = [
  { href: "/contact", label: "Contact", icon: "contact" },
  { href: urls.linkedin, label: "LinkedIn", external: true, icon: "linkedin" },
];

const legal = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/terms", label: "Terms" },
  { href: "/cookies", label: "Cookies" },
];
---

<div class:list={["footer-wave", meetFunnel && "is-filled"]} aria-hidden="true">
  <Wave fill="#2A0B4F" edge={edge} />
</div>
<footer class="footer" id="footer">
  <div class="ft-grid">
    <div class="ft-brand">
      <p class="ft-tagline">Supporting life in FOUNDERland, before and after the exit.</p>
      <a class="footer-logo" href="/">
        <Image src={logo} alt="DoGood Agency" widths={[176, 352]} sizes="117px" loading="lazy" />
      </a>
    </div>

    {
      columns.map((col) => (
        <nav class:list={["ft-col", col.cls]} aria-label={col.groups[0].title}>
          {col.groups.map((g) => (
            <>
              <h2 class="ft-title">{g.title}</h2>
              <ul class="ft-links">
                {g.links.map((link) => (
                  <li>
                    <a href={link.href} set:html={tm(link.label)} />
                  </li>
                ))}
              </ul>
            </>
          ))}
        </nav>
      ))
    }

    <div class="footer-lets ft-lets">
      <!-- Not a link any more (Seb, 18 Nov 2026); Contact sits right below. -->
      <p class="connect-mark">
        <span class="visually-hidden">Let’s Connect</span>
        <span class="connect-lets" aria-hidden="true">Let’s</span>
        <span class="connect-word" aria-hidden="true"><span class="cn-co">Co</span><span class="cn-n cn-n1">n</span><span class="cn-n cn-n2">n</span><span class="cn-ect">ect</span></span>
      </p>
      <ul class="connect-row">
        {
          connectLinks.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? "noopener noreferrer" : undefined}>
                <picture class="connect-slot" aria-hidden="true">
                  <source type="image/svg+xml" srcset={`/icons/icon-${link.icon}.svg`} />
                  <img
                    src={`/icons/icon-${link.icon}@1x.png`}
                    srcset={`/icons/icon-${link.icon}@1x.png 1x, /icons/icon-${link.icon}@2x.png 2x, /icons/icon-${link.icon}@3x.png 3x`}
                    width="20"
                    height="20"
                    alt=""
                    aria-hidden="true"
                  />
                </picture>
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Opt-in in its own frame (Seb, 19 Nov 2026: make it more obvious). -->
    <div class="ft-optin">
      <h2 class="ft-optin-title">Not ready to apply? That’s okay.</h2>
      <p class="ft-optin-copy">Get honest notes on what comes after the exit.</p>
      <form class="footer-form js-subscribe ft-form" action={action} method="post">
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <label class="visually-hidden" for="news-email">Email</label>
        <span class="email-field">
          <picture class="stay-envelope" aria-hidden="true">
            <source
              type="image/webp"
              srcset="/sketches/subscribe-email-envelope-20.webp 1x, /sketches/subscribe-email-envelope-20@2x.webp 2x"
            />
            <img
              src="/sketches/subscribe-email-envelope-20.png"
              srcset="/sketches/subscribe-email-envelope-20.png 1x, /sketches/subscribe-email-envelope-20@2x.png 2x"
              width="20"
              height="20"
              alt=""
            />
          </picture>
          <input
            id="news-email"
            type="email"
            name="fields[email]"
            placeholder="Your email"
            autocomplete="email"
            aria-label="Email"
            required
          />
        </span>
        <button class="btn-subscribe" type="submit">Subscribe</button>
        <p data-status hidden></p>
      </form>
    </div>

    <div class="ft-about">
      <h2 class="ft-title">About DoGood</h2>
      <p>Proud member of IODA, a global network of OD professionals spanning 50+ countries.</p>
      <h2 class="ft-title ft-title-gap">DoGood Agency LLC</h2>
      <p class="ft-address">
        30 N Gould St Ste N,<br />
        Sheridan WY 82801,<br />
        United States
      </p>
      <p class="ft-note">Services are provided by DoGood OÜ, our EU-based operating company.</p>
    </div>
  </div>
  <div class="legal">
    <div>
      {
        legal.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </div>
    <p>© <span id="copyright-year">{copyrightYear}</span> DoGood Agency LLC</p>
  </div>
</footer>
<script is:inline>document.getElementById("copyright-year").textContent=String(new Date().getFullYear());</script>
<script>
  const word = document.querySelector(".connect-word");
  const n1 = word?.querySelector(".cn-n1");
  if (word instanceof HTMLElement && n1 instanceof HTMLElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const setShift = () => {
      const size = parseFloat(getComputedStyle(n1).fontSize) || 1;
      const em = (n1.getBoundingClientRect().width * 0.15) / size;
      word.style.setProperty("--cn-shift", `${em}em`);
    };
    const arm = () => {
      setShift();
      if (reduce) return;
      const seen = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        seen.disconnect();
        window.setTimeout(() => word.classList.add("is-met"), 1000);
      }, { threshold: 0.6 });
      seen.observe(word);
    };
    if (document.fonts?.ready) document.fonts.ready.then(arm);
    else arm();
  }
</script>
