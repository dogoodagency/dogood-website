---
import { urls } from "../data/homepage";

const action =
  "https://assets.mailerlite.com/jsonp/2046479/forms/180157154312849349/subscribe";

const explore = [
  { href: "#first-step", label: "How it works" },
  { href: "#reviews", label: "Stories" },
  { href: "#wayfinders", label: "Wayfinders" },
  { href: "#", label: "For Advisors" },
  { href: "#", label: "Insights" },
  { href: "#footer", label: "Newsletter" },
  { href: urls.diagnostic, label: "Founder Diagnostic™" },
  { href: "#", label: "FAQ" },
];

const contact = [
  { href: urls.contact, label: "Questions" },
  { href: urls.linkedin, label: "LinkedIn", external: true },
  { href: urls.podcast, label: "Podcast" },
];

const legal = [
  { href: urls.privacy, label: "Privacy Policy" },
  { href: urls.terms, label: "Terms" },
  { href: "#", label: "Cookies" },
];
---

<footer class="footer" id="footer">
  <div class="footer-grid">
    <div>
      <h2>Not ready yet?</h2>
      <p class="fine">
        That’s okay. Fuel up with our insights and keep your engines warm for your mission ahead.
      </p>
      <form class="footer-form js-subscribe" action={action} method="post">
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <label class="visually-hidden" for="news-email">Email</label>
        <input
          id="news-email"
          type="email"
          name="fields[email]"
          placeholder="Email"
          autocomplete="email"
          required
        />
        <button class="btn-soft" type="submit">Subscribe</button>
        <p data-status hidden></p>
      </form>
      <p class="fine">unsubscribe anytime</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {
          explore.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        {
          contact.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? "noopener noreferrer" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="footer-col-legal">
        <h2>Legal</h2>
        <ul>
          {
            legal.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div>
      <h2>About DoGood</h2>
      <p class="fine">
        Proud member of IODA, a global network of OD professionals spanning 50+ countries.
      </p>
      <h2 class="footer-subhead">DoGood Agency LLC</h2>
      <p class="fine">30 N Gould St Ste N, Sheridan WY 82801, United States</p>
      <p class="fine">Services are provided by DoGood OÜ, our operating company in the EU.</p>
    </div>
  </div>
  <div class="legal">
    <div>
      {
        legal.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </div>
    <p>© 2026 DoGood Agency LLC</p>
  </div>
</footer>
