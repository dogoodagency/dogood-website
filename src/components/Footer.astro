---
import { urls } from "../data/homepage";
import Wave from "./Wave.astro";

const action =
  "https://assets.mailerlite.com/jsonp/2046479/forms/180157154312849349/subscribe";

interface Props {
  hideOptin?: boolean;
  meetFunnel?: boolean;
}

const { hideOptin = false, meetFunnel = false } = Astro.props;
const copyrightYear = new Date().getFullYear();

const explore = [
  { href: "/about", label: "About us" },
  { href: "/insights", label: "Insights" },
  { href: "/newsletter", label: "Newsletter" },
  { href: urls.podcast, label: "Podcast" },
  { href: "/faqs", label: "FAQ" },
];

const advisors = [
  { href: "/for-advisors", label: "Partner with us" },
  { href: "/for-advisors/client-tools", label: "Client tools" },
  { href: "/for-advisors/insights", label: "Insights for advisors" },
];

const connectLinks = [
  { href: "/contact", label: "Contact", icon: "contact" },
  { href: urls.linkedin, label: "LinkedIn", external: true, icon: "linkedin" },
];

const legal = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/terms", label: "Terms" },
  { href: "/cookies", label: "Cookie Preferences" },
];
---

<div class:list={["footer-wave", meetFunnel && "is-filled"]} aria-hidden="true">
  <Wave fill="#2A0B4F" />
</div>
<footer class="footer" id="footer">
  <div class="footer-grid">
    <div class="footer-subscribe">
      {
        !hideOptin && (
          <>
      <h2>Not ready to apply? That’s okay.</h2>
      <div class="optin-fit">
      <p class="fine optin-copy">Get honest notes on what comes after the exit.</p>
      <form class="footer-form js-subscribe" action={action} method="post">
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <label class="visually-hidden" for="news-email">Email</label>
        <span class="email-field">
          <picture class="stay-envelope" aria-hidden="true">
            <source
              type="image/webp"
              srcset="/sketches/subscribe-email-envelope-20.webp 1x, /sketches/subscribe-email-envelope-20@2x.webp 2x"
            />
            <img
              src="/sketches/subscribe-email-envelope-20.png"
              srcset="/sketches/subscribe-email-envelope-20.png 1x, /sketches/subscribe-email-envelope-20@2x.png 2x"
              width="20"
              height="20"
              alt=""
            />
          </picture>
          <input
            id="news-email"
            type="email"
            name="fields[email]"
            placeholder=""
            autocomplete="email"
            aria-label="Email"
            required
          />
        </span>
        <button class="btn-subscribe" type="submit">Subscribe</button>
        <p data-status hidden></p>
      </form>
      </div>
          </>
        )
      }
    </div>
    <div class="footer-explore">
      <h2 class="col-title">Explore</h2>
      <ul>
        {
          explore.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="footer-advisors">
      <h2 class="col-title">For Advisors</h2>
      <ul>
        {
          advisors.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="footer-about">
      <h2 class="col-title">About DoGood</h2>
      <p class="fine">
        Proud member of IODA, a global network of OD professionals spanning 50+ countries.
      </p>
      <h2 class="footer-subhead agency-name">DoGood Agency LLC</h2>
      <p class="address">
        30 N Gould St Ste N,<br />
        Sheridan WY 82801,<br />
        United States
      </p>
      <p class="fine services-note">
        Services are provided by DoGood OÜ, our EU-based operating company.
      </p>
    </div>
  </div>
  <div class="footer-lets">
    <a class="connect-mark" href="/contact">
      <span class="connect-lets">Let’s</span>
      <span class="connect-word">Connect</span>
    </a>
    <ul class="connect-row">
      {
        connectLinks.map((link) => (
          <li>
            <a href={link.href} rel={link.external ? "noopener noreferrer" : undefined}>
              <picture class="connect-slot" aria-hidden="true">
                <source type="image/svg+xml" srcset={`/icons/icon-${link.icon}.svg`} />
                <img
                  src={`/icons/icon-${link.icon}@1x.png`}
                  srcset={`/icons/icon-${link.icon}@1x.png 1x, /icons/icon-${link.icon}@2x.png 2x, /icons/icon-${link.icon}@3x.png 3x`}
                  width="20"
                  height="20"
                  alt=""
                  aria-hidden="true"
                />
              </picture>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="legal">
    <div>
      {
        legal.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </div>
    <p>© <span id="copyright-year">{copyrightYear}</span> DoGood Agency LLC</p>
  </div>
</footer>
<script is:inline>document.getElementById("copyright-year").textContent=String(new Date().getFullYear());</script>
