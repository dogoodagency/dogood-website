---
import { urls } from "../data/homepage";
import Wave from "./Wave.astro";

const action =
  "https://assets.mailerlite.com/jsonp/2046479/forms/180157154312849349/subscribe";

interface Props {
  hideOptin?: boolean;
}

const { hideOptin = false } = Astro.props;

const explore = [
  { href: "/about", label: "About us" },
  { href: "/insights", label: "Insights" },
  { href: "/newsletter", label: "Newsletter" },
  { href: "/diagnostics", label: "Founder Diagnostic™" },
  { href: "/faqs", label: "FAQ" },
];

const contact = [
  { href: "/contact", label: "Contact" },
  { href: urls.linkedin, label: "LinkedIn", external: true },
  { href: urls.podcast, label: "Podcast" },
];

const legal = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/terms", label: "Terms" },
  { href: "/cookies", label: "Cookie settings" },
];
---

<div class="footer-wave" aria-hidden="true">
  <Wave fill="#2A0B4F" />
</div>
<footer class="footer" id="footer">
  <div class="footer-grid">
    <div class="footer-subscribe">
      {
        !hideOptin && (
          <>
      <h2>Not ready to apply? That’s okay.</h2>
      <p class="fine optin-copy">Get honest notes on what comes after the exit.</p>
      <form class="footer-form js-subscribe" action={action} method="post">
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <label class="visually-hidden" for="news-email">Email</label>
        <span class="email-field">
          <img src="/sketches/footer-stay-close-envelope@1x.png" alt="" width="22" height="16" />
          <input
            id="news-email"
            type="email"
            name="fields[email]"
            placeholder=""
            autocomplete="email"
            required
          />
        </span>
        <button class="btn-subscribe" type="submit">Subscribe</button>
        <p data-status hidden></p>
      </form>
          </>
        )
      }
      <a class="connect-mark" href="/contact">
        <span class="connect-lets">Let’s</span>
        <span class="connect-word">
          Connect
          <svg class="connect-wave" viewBox="0 0 640 48" aria-hidden="true">
            <path
              id="connect-wave-path"
              d="M6 30 C 28 16, 46 38, 78 26 C 112 12, 132 36, 168 24 C 206 10, 228 40, 272 22 C 314 6, 340 38, 386 22 C 430 8, 456 36, 502 20 C 544 6, 572 32, 612 18 C 626 14, 634 20, 634 20"
              fill="none"
              stroke="#28DBB0"
              stroke-width="14"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </a>
    </div>
    <div class="footer-explore">
      <h2 class="col-title">Explore</h2>
      <ul>
        {
          explore.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="footer-connect">
      <h2 class="col-title">Connect</h2>
      <ul>
        {
          contact.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? "noopener noreferrer" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="footer-about">
      <h2 class="col-title">About DoGood</h2>
      <p class="fine">
        Proud member of IODA, a global network of OD professionals spanning 50+ countries.
      </p>
      <h2 class="footer-subhead agency-name">DoGood Agency LLC</h2>
      <p class="address">
        30 N Gould St Ste N,<br />
        Sheridan WY 82801,<br />
        United States
      </p>
      <p class="fine services-note">
        Services are provided by DoGood OÜ, our EU-based operating company.
      </p>
    </div>
  </div>
  <div class="legal">
    <div>
      {
        legal.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </div>
    <p>© 2026 DoGood Agency LLC</p>
  </div>
</footer>
<script>
  const wave = document.querySelector("#connect-wave-path");
  if (wave instanceof SVGPathElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const paint = (progress) => {
      const length = wave.getTotalLength();
      wave.style.strokeDasharray = `${length}`;
      wave.style.strokeDashoffset = String(length * (1 - progress));
    };
    const update = () => {
      if (reduce.matches) {
        paint(1);
        return;
      }
      const rect = wave.getBoundingClientRect();
      const start = window.innerHeight * 0.95;
      const finish = window.innerHeight * 0.55;
      const progress = Math.min(1, Math.max(0, (start - rect.top) / Math.max(1, start - finish)));
      paint(progress);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    reduce.addEventListener("change", update);
  }
</script>
