---
import { Image } from "astro:assets";
import SubscribeCard from "./SubscribeCard.astro";
import ioda from "../assets/photos/ioda.jpg";
import upwork from "../assets/photos/upwork.jpg";
---

<footer class="bg-ink px-4 py-16 text-center text-white">
  <div class="mx-auto max-w-5xl">
    <p class="text-lg">Not ready yet?</p>
    <button
      type="button"
      data-open-optin
      class="mt-4 inline-flex min-h-12 items-center rounded-full bg-pink-deep px-6 text-[19px] font-bold text-white transition hover:bg-white hover:text-ink"
    >
      That's okay. Fuel up, stay ready →
    </button>
    <p class="mt-3 text-xs text-cloud">Founder community · Transformation insight</p>

    <div class="mt-14 grid gap-10 md:grid-cols-3 md:items-start md:text-left">
      <a
        href="https://www.iodanet.org/iodas-history/"
        class="block"
        rel="noopener noreferrer"
      >
        <p class="text-xs text-cloud">
          Proud member of IODA, a global network of OD professionals spanning 50+ countries
        </p>
        <Image
          src={ioda}
          alt=""
          widths={[240, 360]}
          sizes="180px"
          class="mx-auto mt-4 h-auto w-40 md:mx-0"
        />
      </a>

      <div>
        <h2 class="text-base font-extrabold text-pink-soft">About DoGood</h2>
        <a class="mt-3 block font-semibold" href="https://www.dogoodagency.co/dogood-insider">
          RawStories Podcast
        </a>
        <a class="mt-2 block font-semibold" href="https://www.dogoodagency.co/contact">Contact</a>
      </div>

      <a
        href="http://www.upwork.com/agencies/dogoodagency"
        class="block"
        rel="noopener noreferrer"
      >
        <p class="text-xs text-cloud">
          Ranked as a Premium 1% Performer, and endorsed as Expert-Vetted on Upwork
        </p>
        <Image
          src={upwork}
          alt=""
          widths={[240, 400]}
          sizes="200px"
          class="mx-auto mt-4 h-auto w-44 md:mx-0"
        />
      </a>
    </div>

    <div class="mt-14">
      <p class="text-xl font-extrabold text-pink">DoGood Agency LLC</p>
      <p class="mt-2 text-sm">30 N Gould St Ste N, Sheridan</p>
      <p class="text-sm">WY 82801, United States</p>
      <p class="mt-4 text-xs text-cloud">
        Services are provided by DoGood OÜ, our operating company in the EU
      </p>
      <a
        href="https://www.linkedin.com/in/sebwichmann/"
        aria-label="LinkedIn"
        class="mt-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white text-ink"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
          <path
            fill="currentColor"
            d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V24h-4V8.5zM8.5 8.5h3.8v2.1h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.8 2.6 4.8 6V24h-4v-7.7c0-1.8 0-4.1-2.5-4.1s-2.9 2-2.9 4V24h-4V8.5z"
          ></path>
        </svg>
      </a>
    </div>

    <p class="mt-10 text-sm text-cloud">
      © 2026 DoGood Agency LLC
      <a class="ml-2 text-white underline" href="https://www.dogoodagency.co/terms">Terms</a>
      <span aria-hidden="true"> | </span>
      <a class="text-white underline" href="https://www.dogoodagency.co/privacy">Privacy Policy</a>
    </p>
  </div>

  <dialog
    id="optin"
    class="w-[min(720px,calc(100%-2rem))] rounded-[20px] bg-transparent p-0 backdrop:bg-ink/80"
    aria-labelledby="optin-title"
  >
    <div class="relative">
      <button
        type="button"
        data-close-optin
        class="absolute right-3 top-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white text-2xl leading-none text-ink"
        aria-label="Close"
      >
        ×
      </button>
      <div id="optin-title" class="sr-only">
        Trusted by founders at 6M+ revenue · 15+ yrs Fortune 500s
      </div>
      <SubscribeCard id="optin-form" />
    </div>
  </dialog>
</footer>
