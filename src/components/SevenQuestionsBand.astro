---
import { sevenQuestions, sevenQuestionsPdf } from "../data/seven-questions";

interface Props {
  variant: "home" | "reset" | "advisor" | "tools" | "newsletter" | "exit";
  /** Reuse the round-4 artwork layout without changing the page's copy variant. */
  layout?: "preview" | "compact";
}
const { variant, layout = variant === "home" ? "preview" : "compact" } = Astro.props;
const home = variant === "home";
const standardButtons = ["home", "newsletter", "reset", "advisor"].includes(variant);
const preview = layout === "preview";
const titleId = `seven-questions-${variant}-title`;
---

<section class:list={["sq-band", `sq-band--${variant}`, preview && "sq-band--preview"]} aria-labelledby={titleId}>
  <div class="sq-inner">
    <img class="sq-cover" src="/media/r10/seven-questions@1x.webp" srcset="/media/r10/seven-questions@1x.webp 600w, /media/r10/seven-questions@2x.webp 1200w" sizes={preview ? "(max-width: 600px) calc(100vw - 44px), (max-width: 1365px) 36vw, 360px" : "(max-width: 600px) 300px, 300px"} width="600" height="401" alt="The 7 Questions guide: Seven questions for the first 90 days, an open booklet and its cover" loading="lazy" decoding="async" />
    <div class="sq-copy">
      {Astro.slots.has("intro") ? <slot name="intro" /> : <>
      <p class="sq-eyebrow">Free guide</p>
      <h2 id={titleId}>{preview ? <><span class="sq-title-main">The 7 questions</span><span class="sq-title-sub">for the first 90 days after the sale</span></> : "The 7 questions for the first 90 days after the sale"}</h2>
      <p class="sq-intro">{home ? "Worth reading before you sell, too." : "For founders who have already sold."}</p>
      {!home && variant !== "reset" && <ol class="sq-questions">
        {sevenQuestions.map((question) => <li>{question}</li>)}
      </ol>}
      </>}
    </div>
    <div class="sq-preview">
      <div class="sq-actions">
        <!-- Newsletter already prints the questions above this band and keeps only the download. -->
        {!Astro.slots.has("actions") && variant !== "newsletter" &&
        <a class={standardButtons ? "btn-teal btn-dream sq-standard" : "sq-control sq-read"} href="/seven-questions">
          <span>{home ? "Read the 7 questions" : "Sit with the 7 questions"}</span>
          {!standardButtons && <span class="sq-disc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>}
        </a>
        }
        {Astro.slots.has("actions") && <slot name="actions" />}
        <a class={standardButtons ? "btn-teal btn-dream sq-standard" : "sq-control sq-download"} href={sevenQuestionsPdf} target="_blank" rel="noopener">
          <span>Download the PDF</span>
          {!standardButtons && <span class="sq-disc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>}
        </a>
      </div>
    </div>
  </div>
</section>
