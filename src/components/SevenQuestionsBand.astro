---
import { sevenQuestions, sevenQuestionsPdf } from "../data/seven-questions";

interface Props {
  variant: "home" | "reset";
}
const { variant } = Astro.props;
const home = variant === "home";
const titleId = `seven-questions-${variant}-title`;
---

<section class:list={["sq-band", `sq-band--${variant}`]} aria-labelledby={titleId}>
  <div class="sq-inner">
    <img class="sq-cover" src="/media/seven-questions/seven-questions-cover@1x.webp" srcset="/media/seven-questions/seven-questions-cover@1x.webp 600w, /media/seven-questions/seven-questions-cover@2x.webp 1200w" sizes="(max-width: 600px) 150px, 180px" width="600" height="849" alt="The 7 Questions guide cover" loading="lazy" decoding="async" />
    <div class="sq-copy">
      <p class="sq-eyebrow">Free guide</p>
      <h2 id={titleId}>The 7 questions for the first 90 days after the sale</h2>
      <p class="sq-intro">{home ? "Worth reading before you sell, too." : "For founders who have already sold."}</p>
      <ol class="sq-questions">
        {(home ? sevenQuestions.slice(0, 3) : sevenQuestions).map((question) => <li>{question}</li>)}
      </ol>
      {home && <p class="sq-more">and four more</p>}
      <div class="sq-actions">
        <a class="btn-teal" href="/seven-questions">{home ? "Read the 7 questions" : "Sit with the 7 questions"}</a>
        <a class="r3-inline-link" href={sevenQuestionsPdf} target="_blank" rel="noopener">Download the PDF</a>
      </div>
    </div>
  </div>
</section>
