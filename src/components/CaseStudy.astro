---
import "../styles/casestudy.css";
import Base from "../layouts/Base.astro";
import Wave from "./Wave.astro";
import { edgeAbove } from "../data/edge-line";

interface Img {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  /** Browser title, meta description and canonical URL. */
  title: string;
  description: string;
  canonical: string;
  /** Founder initial, used in the "What V wanted" style headings. */
  name: string;
  headline: string;
  headlineAccent: string;
  intro: string;
  quote: string[];
  attribution: string;
  portrait: Img;
  snapshot: string[];
  facts: { label: string; value: string }[];
  diagnosticLabel: string;
  problem: string;
  symptoms: string[];
  wanted: string;
  tried: string;
  hardest: string;
  approachIntro: string;
  did: string[];
  didImages: Img[];
  actions: string[];
  actionImages: Img[];
  outcomesIntro: string;
  businessOutcomes: string[];
  personalOutcomes: string[];
  howChange: string[];
  netEffect: string[];
  closing: string;
}

const {
  title,
  description,
  canonical,
  name,
  headline,
  headlineAccent,
  intro,
  quote,
  attribution,
  portrait,
  snapshot,
  facts,
  diagnosticLabel,
  problem,
  symptoms,
  wanted,
  tried,
  hardest,
  approachIntro,
  did,
  didImages,
  actions,
  actionImages,
  outcomesIntro,
  businessOutcomes,
  personalOutcomes,
  howChange,
  netEffect,
  closing,
} = Astro.props;

const tint = "#F5F2FF";
const heroEdge = edgeAbove("#2A0B4F");
const bandEdge = edgeAbove(tint);
const footerEdge = edgeAbove(tint);
const caption = "Founder-focused · Not therapy, not medical advice, not psychological services";
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  footerStrip={tint}
  footerEdge={footerEdge}
>
  <article class="cs-page">
    <header class="cs-hero">
      <div class="cs-hero-inner">
        <p class="cs-anon"><strong>We protect our founders’ identities.</strong> Most founders we work with lead visible companies and public lives –– we don't ask them to tell the private parts of their story publicly. Anonymity lets founders be candid about their intimate work — without risking reputations, partnerships, or market fallout.</p>
        <h1>{headline} <span class="cs-accent">{headlineAccent}</span></h1>
        <p class="cs-intro">{intro}</p>
      </div>
      <Wave fill={tint} edge={heroEdge} />
    </header>

    <section class="cs-band cs-band-tint">
      <div class="cs-well">
        <div class="cs-quote-row">
          <figure class="cs-quote">
            <blockquote>
              {quote.map((paragraph) => <p>{paragraph}</p>)}
            </blockquote>
            <figcaption><strong>{attribution}</strong></figcaption>
          </figure>
          <figure class="cs-portrait-wrap">
            <img
              class="cs-portrait"
              src={portrait.src}
              width={portrait.width}
              height={portrait.height}
              alt={portrait.alt}
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>

        <div class="cs-card cs-snapshot">
          <h2>Founder Snapshot</h2>
          <div class="cs-snapshot-grid">
            <div>
              {snapshot.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <dl class="cs-facts">
              {
                facts.map((fact) => (
                  <>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </>
                ))
              }
            </dl>
          </div>
        </div>

        <div class="cs-cta">
          <p class="cs-cta-lead">Start with a short diagnostic — see where you sit</p>
          <a class="btn-teal" href="/diagnostics">{diagnosticLabel}</a>
          <p class="cs-caption">{caption}</p>
        </div>
      </div>
    </section>

    <div class="cs-divider" aria-hidden="true">
      <svg style={`--wave-edge:${bandEdge}`} viewBox="0 0 1440 80" preserveAspectRatio="none">
        <path fill="#ffffff" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16v48H0Z"></path>
        <path class="wave-edge" d="M0 48c180 32 320-40 520-24s300 56 480 24 280-56 440-16"></path>
      </svg>
    </div>

    <section class="cs-band">
      <div class="cs-well">
        <h2>The Problem</h2>
        <p class="cs-lead">{problem}</p>
        <div class="cs-grid-2" style="margin-top: 36px;">
          <div class="cs-card">
            <h3>Top symptoms</h3>
            <ul class="cs-list">
              {symptoms.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="cs-stack">
            <div class="cs-card">
              <h3>What {name} wanted</h3>
              <p>{wanted}</p>
            </div>
            <div class="cs-card">
              <h3>What {name} tried before</h3>
              <p>{tried}</p>
            </div>
            <div class="cs-card">
              <h3>The hardest change for {name}</h3>
              <p>{hardest}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-band cs-band-tint">
      <div class="cs-well">
        <h2>Our Engagement Approach</h2>
        <p class="cs-lead">{approachIntro}</p>
        <div class="cs-stack" style="margin-top: 36px;">
          <div class="cs-card">
            <h3>What we actually did</h3>
            <ul class="cs-list">
              {did.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class:list={["cs-images", didImages.length === 1 && "cs-images-single"]}>
            {
              didImages.map((img) => (
                <img class="cs-shot" src={img.src} width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async" />
              ))
            }
          </div>
          <div class="cs-card">
            <h3>Client actions –– What {name} did</h3>
            <ul class="cs-list cs-list-check">
              {actions.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class:list={["cs-images", actionImages.length === 1 && "cs-images-single"]}>
            {
              actionImages.map((img) => (
                <img class="cs-shot" src={img.src} width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async" />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="cs-band">
      <div class="cs-well">
        <h2>The Outcomes</h2>
        <p class="cs-lead">{outcomesIntro}</p>
        <div class="cs-grid-2" style="margin-top: 36px;">
          <div class="cs-card">
            <h3>Business outcomes</h3>
            <ol class="cs-numbered">
              {businessOutcomes.map((item) => <li>{item}</li>)}
            </ol>
          </div>
          <div class="cs-card">
            <h3>Personal outcomes</h3>
            <ol class="cs-numbered">
              {personalOutcomes.map((item) => <li>{item}</li>)}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-band cs-band-tint">
      <div class="cs-well">
        <div class="cs-grid-2">
          <div class="cs-card">
            <h2>How the business change happened</h2>
            {howChange.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="cs-card">
            <h2>Net effect</h2>
            {netEffect.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <div class="cs-cta cs-cta-end">
          <p class="cs-cta-lead">{closing}</p>
          <a class="btn-teal" href="/diagnostics">{diagnosticLabel}</a>
          <p class="cs-caption">{caption}</p>
        </div>
      </div>
    </section>
  </article>
</Base>
