---
import infinity from "../../public/media/r5/r5-infinity.svg?raw";
const responsibilities = [
  { quarter: "tl", text: "We get the founder ready." },
  { quarter: "bl", text: "You get the business and the money ready." },
  { quarter: "tr", text: "We provide a private place for the part that is not financial or legal." },
  { quarter: "br", text: "You stay the trusted advisor." },
];
---

<figure class="inf" data-arta="R5-INF">
  <figcaption class="inf-caption">Advisors and DoGood are one team.</figcaption>
  <div class="inf-drawing" set:html={infinity} />
  <ol class="inf-labels" role="list">
    {responsibilities.map(({ quarter, text }) => <li class="inf-label" data-q={quarter}>{text}</li>)}
  </ol>
  <button class="inf-toggle" type="button" aria-label="Pause animation" aria-pressed="false" hidden>
    <svg class="inf-pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
    <svg class="inf-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 10 7-10 7Z" /></svg>
  </button>
</figure>

<script>
  import { initInfinity } from "../scripts/r5-infinity-gsap.js";
  document.querySelectorAll<HTMLElement>(".inf").forEach(initInfinity);
</script>
