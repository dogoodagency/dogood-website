---
interface Props {
  /** founder = person, advisor = briefcase, both / all = two people. */
  audience: "founder" | "advisor" | "both";
  size?: number;
}

const { audience, size = 14 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    audience === "founder" && (
      <>
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
      </>
    )
  }
  {
    audience === "advisor" && (
      <>
        <rect x="3" y="7" width="18" height="13" rx="2" />
        <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18" />
      </>
    )
  }
  {
    audience === "both" && (
      <>
        <circle cx="9" cy="8" r="3.5" />
        <circle cx="17" cy="9" r="2.5" />
        <path d="M2 20c0-3.6 3.1-6 7-6s7 2.4 7 6M16 14.5c3 .2 6 1.8 6 5.5" />
      </>
    )
  }
</svg>
