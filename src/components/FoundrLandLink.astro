---
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const isAdvisorPage = /^\/advisor-center(?:\/|$)/.test(Astro.url.pathname);
---

{!isAdvisorPage && (
  <a class:list={["fl-advisor-btn", !home && "fl-advisor-btn--dream"]} href="/advisor-center">
    Advisor Center
    <span class="fl-advisor-disc" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
    </span>
  </a>
)}
