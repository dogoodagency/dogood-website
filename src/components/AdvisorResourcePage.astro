---
/**
 * Detail page for an Advisor Center resource (Seb, 19 Nov 2026): the three tools and the three advisor
 * insights pieces. Content comes from the Advisor Toolkit Plan v0.4 and is a first draft; Seb will rewrite.
 * Resource status and download links reflect what is available on each page.
 */
import "../styles/advisors.css";
import "../styles/advisors-resources.css";
import Base from "../layouts/Base.astro";
import FoundrLandLink from "./FoundrLandLink.astro";
import Wave from "./Wave.astro";
import AdvisorNav from "./AdvisorNav.astro";
import AdvisorToolVisual from "./AdvisorToolVisual.astro";
import { edgeAbove } from "../data/edge-line";

interface Block {
  heading: string;
  foundrlandLink?: boolean;
  paras?: string[];
  list?: string[];
  steps?: { title: string; text: string }[];
}

interface Props {
  title: string;
  description: string;
  robots?: string;
  path: string;
  section: "tools" | "insights";
  name: string;
  soon?: string;
  download?: { href: string; label: string };
  lede: string;
  tone: "sky" | "grass" | "heart";
  blocks: Block[];
  note?: string;
}

const { title, description, robots, path, section, name, soon, lede, tone, blocks, note, download } = Astro.props;
// Page colour follows the card colour on the tools / insights index (Seb, 19 Nov 2026 18:52).
const tint = path.endsWith("/advisor-voices") ? "#F5F2FF" : tone === "heart" ? "#FFF9FA" : tone === "grass" ? "#F3FFFB" : "#F5F2FF";
const closingTint = Astro.slots.has("after-content") ? "#fff" : tint;
const heroEdge = edgeAbove("#2A0B4F");
const siblings = section === "tools" ? [
  { slug: "readiness-check", label: "Readiness Check" },
  { slug: "signals-guide", label: "Signals Guide" },
  { slug: "life-after-the-sale-planner", label: "Planner" },
] : [
  { slug: "what-founders-struggle-with", label: "Where founders get stuck" },
  { slug: "advisor-voices", label: "Advisor voices" },
];
const sectionPath = section === "tools" ? "client-tools" : "insights";
const toolVisual = path.endsWith("/signals-guide") ? "signals" : path.endsWith("/life-after-the-sale-planner") ? "planner" : undefined;
const back = section === "tools"
  ? { href: "/advisor-center/client-tools", label: "All client tools", crumb: "Client tools" }
  : { href: "/advisor-center/insights", label: "All advisor insights", crumb: "Advisor insights" };
---

<Base
  title={title}
  description={description}
  robots={robots}
  canonical={`https://www.dogoodagency.co${path}`}
  ogTitle={title}
  footerStrip={closingTint}
  footerEdge={edgeAbove(closingTint)}
>
  <article class:list={["adv-page", "advr-page", "advd-page", section === "tools" ? "advd-tools-page" : "advd-insights-page", `advd--${tone}`, toolVisual === "signals" && "advd-signals-page"]} style={`--advr-tint:${tint}`}>
    <header class="advr-hero">
      <div class="advr-hero-inner">
        <p class="advr-eyebrow">Advisor Center · {back.crumb}</p>
        <h1>{name}</h1>
        {soon && section === "tools" && <p class="advd-soon">{soon}</p>}
        <p class="advr-lede">{lede}</p>
        {soon && section === "insights" && <p class="advd-soon">{soon}</p>}
      </div>
      <Wave fill="#fff" edge={heroEdge} />
    </header>

    <section class="advr-band advr-band-white advr-hub-band" aria-label="Advisor Center">
      <div class="advr-well">
        <div class="advr-nav"><AdvisorNav current={section} /></div>
        <nav class="advd-breadcrumb" aria-label="Breadcrumb">
          <a href="/advisor-center">Advisor Center</a><span aria-hidden="true">›</span>
          <a href={back.href}>{back.crumb}</a><span aria-hidden="true">›</span>
          <span aria-current="page">{name}</span>
        </nav>
        <nav class="advd-siblings" aria-label={section === "tools" ? "Client tools" : "Advisor insights"}>
          {siblings.map((item) => (
            <a href={`/advisor-center/${sectionPath}/${item.slug}`} aria-current={path.endsWith(`/${item.slug}`) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </section>

    <section class="advr-band advr-band-tint" aria-label={name}>
      <div class="advr-well advd-well">
        {section === "tools" && toolVisual && <AdvisorToolVisual tool={toolVisual} detail />}
        {download && <p class="advd-download"><a class="btn-teal btn-dream" href={download.href} target="_blank" rel="noopener">{download.label}</a></p>}
        <slot name="before-blocks" />
        {
          blocks.map((b) => (
            <section class="advd-block">
              <h2>{b.heading}</h2>
              {b.paras?.map((p) => <p set:html={p} />)}
              {b.foundrlandLink && <FoundrLandLink />}
              {b.list && <ul class="advd-list">{b.list.map((t) => <li>{t}</li>)}</ul>}
              {b.steps && (
                <ol class="advd-steps">
                  {b.steps.map((st) => (
                    <li>
                      <h3>{st.title}</h3>
                      <p>{st.text}</p>
                    </li>
                  ))}
                </ol>
              )}
            </section>
          ))
        }
        <slot />
        {note && <p class="advd-note">{note}</p>}
      </div>
    </section>

    <slot name="after-content" />
  </article>
</Base>
