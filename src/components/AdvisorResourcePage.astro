---
/**
 * Detail page for an Advisor Center resource (Seb, 19 Nov 2026): the three free tools and the three advisor
 * insights pieces. Content comes from the Advisor Toolkit Plan v0.4 and is a first draft; Seb will rewrite.
 * Every resource is still in the making, so each page shows a clear "Coming soon" status.
 */
import "../styles/advisors.css";
import "../styles/advisors-resources.css";
import Base from "../layouts/Base.astro";
import Wave from "./Wave.astro";
import AdvisorNav from "./AdvisorNav.astro";
import { edgeAbove } from "../data/edge-line";

interface Block {
  heading: string;
  paras?: string[];
  list?: string[];
  steps?: { title: string; text: string }[];
}

interface Props {
  title: string;
  description: string;
  path: string;
  section: "tools" | "insights";
  name: string;
  soon: string;
  lede: string;
  tone: "sky" | "grass" | "heart";
  blocks: Block[];
  note?: string;
}

const { title, description, path, section, name, soon, lede, tone, blocks, note } = Astro.props;
// Page colour follows the card colour on the tools / insights index (Seb, 19 Nov 2026 18:52).
const tint = tone === "heart" ? "#FFF9FA" : tone === "grass" ? "#F3FFFB" : "#F5F2FF";
const heroEdge = edgeAbove("#2A0B4F");
const back = section === "tools"
  ? { href: "/advisor-center/client-tools", label: "All free tools", crumb: "Free tools for your clients" }
  : { href: "/advisor-center/insights", label: "All advisor insights", crumb: "Advisor insights" };
---

<Base
  title={title}
  description={description}
  canonical={`https://www.dogoodagency.co${path}`}
  ogTitle={title}
  footerStrip={tint}
  footerEdge={edgeAbove(tint)}
>
  <article class:list={["adv-page", "advr-page", "advd-page", `advd--${tone}`]} style={`--advr-tint:${tint}`}>
    <header class="advr-hero">
      <div class="advr-hero-inner">
        <p class="advr-eyebrow">Advisor Center · {back.crumb}</p>
        <h1>{name}</h1>
        <p class="advd-soon">{soon}</p>
        <p class="advr-lede">{lede}</p>
      </div>
      <Wave fill={tint} edge={heroEdge} />
    </header>

    <section class="advr-band advr-band-tint" aria-label={name}>
      <div class="advr-well advd-well">
        <div class="advr-nav">
          <AdvisorNav current={section} />
        </div>
        {
          blocks.map((b) => (
            <section class="advd-block">
              <h2>{b.heading}</h2>
              {b.paras?.map((p) => <p set:html={p} />)}
              {b.list && <ul class="advd-list">{b.list.map((t) => <li>{t}</li>)}</ul>}
              {b.steps && (
                <ol class="advd-steps">
                  {b.steps.map((st) => (
                    <li>
                      <h3>{st.title}</h3>
                      <p>{st.text}</p>
                    </li>
                  ))}
                </ol>
              )}
            </section>
          ))
        }
        {note && <p class="advd-note">{note}</p>}
      </div>
    </section>

  </article>
</Base>
