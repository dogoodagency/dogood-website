---
interface Props {
  links: { apple?: string; spotify?: string; amazon?: string; youtube?: string };
  light?: boolean;
}

const { links, light = false } = Astro.props;
const items = [
  { key: "apple", label: "Apple Podcasts" },
  { key: "spotify", label: "Spotify" },
  { key: "amazon", label: "Amazon Music" },
  { key: "youtube", label: "YouTube" },
] as const;
const present = items.filter((item) => links[item.key]);
---

<ul class:list={["pod-pills", light && "pod-pills-light"]}>
  {
    present.map((item) => (
      <li>
        <a class="pod-pill" href={links[item.key]} target="_blank" rel="noopener">
          {item.key === "apple" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2a10 10 0 0 0-3.2 19.5c-.2-.9-.3-1.600-.3-2.600a6 6 0 1 1 7 0c0 1-.1 1.700-.3 2.600A10 10 0 0 0 12 2Zm0 6a2.500 2.500 0 1 0 0 5 2.500 2.500 0 0 0 0-5Zm0 6.500c-1.100 0-1.800.7-1.800 1.700l.4 4.300c.1.800.6 1.300 1.400 1.300s1.300-.5 1.400-1.300l.4-4.300c0-1-.7-1.700-1.800-1.700Z" />
            </svg>
          )}
          {item.key === "spotify" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.600 14.400a.7.7 0 0 1-1 .2c-2.600-1.600-5.800-1.900-9.600-1a.7.7 0 1 1-.3-1.400c4.100-.9 7.700-.6 10.600 1.200.3.200.4.700.3 1Zm1.200-2.700a.9.9 0 0 1-1.200.3c-3-1.800-7.500-2.400-11-1.300a.9.9 0 1 1-.5-1.700c4-1.200 9-.6 12.400 1.500.4.200.5.800.3 1.200Zm.1-2.800C14.300 8.800 8.500 8.600 5.100 9.600a1 1 0 1 1-.6-1.900c3.900-1.200 10.300-1 14.300 1.400a1 1 0 0 1-1 1.800Z" />
            </svg>
          )}
          {item.key === "amazon" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 3v11.300A3.500 3.500 0 1 0 11 17.500V8h6V3H9Zm-2.500 17.500a1.500 1.500 0 1 1 0-3 1.500 1.500 0 0 1 0 3Z" />
            </svg>
          )}
          {item.key === "youtube" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21.600 7.200a2.500 2.500 0 0 0-1.800-1.800C18.200 5 12 5 12 5s-6.200 0-7.800.4A2.500 2.500 0 0 0 2.400 7.200C2 8.800 2 12 2 12s0 3.200.4 4.800a2.500 2.500 0 0 0 1.800 1.800C5.800 19 12 19 12 19s6.200 0 7.800-.4a2.500 2.500 0 0 0 1.800-1.800c.4-1.600.4-4.800.4-4.800s0-3.200-.4-4.800ZM10 15V9l5.200 3L10 15Z" />
            </svg>
          )}
          <span>{item.label}</span>
        </a>
      </li>
    ))
  }
</ul>
