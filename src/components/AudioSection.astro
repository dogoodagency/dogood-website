---
/**
 * Custom State-Shift Audio (Seb, 19 Nov 2026): animated waveforms (left tone, right tone, the beat the brain
 * hears) and the four modes with their brainwave bands. The science is stated with its real evidence level:
 * binaural beats have mixed, modest research support; subliminal audio has little. No "quantum" claims.
 * Used on /state-shift-audio (full) and /the-build (compact). Stage 2 inclusion only (Seb, 19 Nov 2026).
 * "A science-based approach" block added 19 Nov 2026 as a draft for Seb (no quantum claims).
 */
interface Props {
  variant?: "full" | "compact";
  heading?: string;
}
const { variant = "compact", heading = "Custom State-Shift Audio" } = Astro.props;

function wave(freq: number, amp = 18, w = 600, h = 50, phase = 0) {
  const pts: string[] = [];
  for (let x = 0; x <= w * 2; x += 4) {
    const y = h / 2 + amp * Math.sin((x / w) * Math.PI * 2 * freq + phase);
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return pts.join(" ");
}
function beat(w = 600, h = 50) {
  const pts: string[] = [];
  for (let x = 0; x <= w * 2; x += 3) {
    const env = Math.cos((x / w) * Math.PI * 2 * 2);
    const y = h / 2 + 20 * env * Math.sin((x / w) * Math.PI * 2 * 24);
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return pts.join(" ");
}
const modes = [
  { name: "Focus", band: "Beta and low gamma", hz: "14–40 Hz", use: "Before deep work, a board meeting or a hard decision.", tone: "sky", level: 0.85 },
  { name: "Decompression", band: "Alpha", hz: "8–12 Hz", use: "After a long day, between meetings, to come down.", tone: "grass", level: 0.55 },
  { name: "Reset", band: "Theta", hz: "4–8 Hz", use: "To step out of a loop of thoughts and start again.", tone: "dream", level: 0.35 },
  { name: "High-stakes days", band: "Alpha into beta", hz: "10–18 Hz", use: "Calm first, then alert: before conflict, pitches or fatigue.", tone: "heart", level: 0.7 },
];
---

<section class:list={["au", `au--${variant}`]} data-au aria-labelledby="au-title">
  <div class="au-head">
    <p class="au-eyebrow">Shift state on demand</p>
    <h2 id="au-title">{heading}</h2>
    <p class="au-lede">Mood-specific tracks designed for focus, decompression, reset, and high-stakes days, made for you and used when it counts.</p>
  </div>

  <div class="au-scope" role="img" aria-label="Illustration: a slightly lower tone in the left ear and a slightly higher tone in the right ear combine into a slow beat the brain perceives">
    <div class="au-row">
      <span class="au-label">Left ear · 200 Hz</span>
      <svg viewBox="0 0 600 50" preserveAspectRatio="none" class="au-svg"><polyline class="au-w au-w--l" points={wave(10)} /></svg>
    </div>
    <div class="au-row">
      <span class="au-label">Right ear · 210 Hz</span>
      <svg viewBox="0 0 600 50" preserveAspectRatio="none" class="au-svg"><polyline class="au-w au-w--r" points={wave(11)} /></svg>
    </div>
    <div class="au-row au-row--beat">
      <span class="au-label">What the brain hears · a 10 Hz beat</span>
      <svg viewBox="0 0 600 50" preserveAspectRatio="none" class="au-svg"><polyline class="au-w au-w--b" points={beat()} /></svg>
    </div>
  </div>

  <ul class="au-modes">
    {modes.map((m, i) => (
      <li class:list={["au-mode", `au-mode--${m.tone}`]}>
        <p class="au-mode-name">{m.name}</p>
        <p class="au-mode-band">{m.band} · {m.hz}</p>
        <span class="au-meter" aria-hidden="true">
          {Array.from({ length: 12 }).map((_, k) => (
            <span style={`--k:${k};--lvl:${(m.level * (0.55 + 0.45 * Math.abs(Math.sin(k * 1.7 + i)))).toFixed(2)}`}></span>
          ))}
        </span>
        <p class="au-mode-use">{m.use}</p>
      </li>
    ))}
  </ul>

  {
    variant === "full" && (
      <div class="au-approach">
        <p class="au-approach-eyebrow">Research, not promises</p>
        <h3>A science-based approach</h3>
        <p class="au-approach-lede">Every track is built on what research shows about sound, breath and the nervous system, and we keep checking it against your own data.</p>
        <ol class="au-approach-cards">
          <li class="au-ac au-ac--grass">
            <span class="au-ac-n">1</span>
            <p class="au-ac-tag">Brain rhythm</p>
            <p class="au-ac-key">Binaural beats had a medium, consistent effect on memory, attention, anxiety and pain.</p>
            <p class="au-ac-more">A 2019 meta-analysis of 22 studies. Listening before a task worked better than only during it, and longer listening helped more.</p>
          </li>
          <li class="au-ac au-ac--heart">
            <span class="au-ac-n">2</span>
            <p class="au-ac-tag">Breath pacing</p>
            <p class="au-ac-key">Music paced gently below your breathing slows the breath and calms the body.</p>
            <p class="au-ac-more">Lower heart rate and skin response, with the strongest effect when the pacing is personalized (MIT Media Lab, 2019).</p>
          </li>
          <li class="au-ac au-ac--dream">
            <span class="au-ac-n">3</span>
            <p class="au-ac-tag">Your body's data</p>
            <p class="au-ac-key">We check whether a track actually moves your recovery, sleep and HRV.</p>
            <p class="au-ac-more">With WHOOP, we see the effect on your own body, and adjust the track when it does not help.</p>
          </li>
        </ol>
        <p class="au-cite">Sources: Garcia-Argibay, Santed &amp; Reales, <em>Psychological Research</em> 2019; Leslie, Ghandeharioun, Zhou &amp; Picard, IEEE ACII 2019.</p>
      </div>

      <div class="au-sci">
        <div class="au-sci-col">
          <p class="au-approach-eyebrow">The science, plainly</p>
          <h3>How a binaural beat works</h3>
          <div class="au-beat" aria-hidden="true">
            <div class="au-beat-ear au-beat-ear--l"><span>Left ear</span><strong>200 Hz</strong></div>
            <span class="au-beat-plus">+</span>
            <div class="au-beat-ear au-beat-ear--r"><span>Right ear</span><strong>210 Hz</strong></div>
            <span class="au-beat-plus">=</span>
            <div class="au-beat-ear au-beat-ear--b"><span>Your brain hears</span><strong>10 Hz</strong></div>
          </div>
          <p>When each ear hears a slightly different tone through headphones, the brain perceives a third, slow beat. That beat sits in the range of one of the brain's own rhythms:</p>
          <ul class="au-bands">
            <li class="au-band au-band--d"><strong>Delta</strong><span>deep sleep</span></li>
            <li class="au-band au-band--t"><strong>Theta</strong><span>drowsy, reflective</span></li>
            <li class="au-band au-band--a"><strong>Alpha</strong><span>calm alertness</span></li>
            <li class="au-band au-band--b"><strong>Beta</strong><span>active focus</span></li>
          </ul>
          <p>The idea, called entrainment, is that listening nudges attention and arousal toward that state. Research is promising but mixed: reviews find small to moderate effects on anxiety, attention and memory, and results vary between studies and people.</p>
        </div>
        <div class="au-sci-col">
          <p class="au-approach-eyebrow">How we build tracks</p>
          <h3>Three layers</h3>
          <ol class="au-layers">
            <li>
              <strong>Modulation curves</strong>
              <span>Each track moves gently from your current state toward the one you need, for example from beta down into alpha to decompress.</span>
            </li>
            <li>
              <strong>Your words</strong>
              <span>Tracks can carry quiet spoken lines from your own work with your Wayfinder (subliminal audio). The evidence that messages below hearing change behavior is weak, so we use them as a light anchor, not a promise.</span>
            </li>
            <li>
              <strong>Practical use</strong>
              <span>A few minutes with headphones before the moment that matters.</span>
            </li>
          </ol>
        </div>
        <p class="au-fine au-sci-fine">Not a medical treatment. Do not listen while driving or operating machinery. If you live with epilepsy or a seizure condition, ask your doctor first.</p>
      </div>
    )
  }

  {variant === "compact" && <p class="au-more"><a class="btn-teal" href="/state-shift-audio">See how the audio works</a></p>}
</section>

<style>
