---
/**
 * Custom State-Shift Audio (Seb, 19 Nov 2026): animated waveforms (left tone, right tone, the beat the brain
 * hears) and the four modes with their brainwave bands. The science is stated with its real evidence level:
 * binaural beats have mixed, modest research support; subliminal audio has little. No "quantum" claims.
 * Used on /state-shift-audio (full) and /the-build (compact). Stage 2 inclusion only (Seb, 19 Nov 2026).
 * "A science-based approach" block added 19 Nov 2026 as a draft for Seb (no quantum claims).
 */
interface Props {
  variant?: "full" | "compact";
  heading?: string;
}
const { variant = "compact", heading = "Custom State-Shift Audio" } = Astro.props;

function wave(freq: number, amp = 18, w = 600, h = 50, phase = 0) {
  const pts: string[] = [];
  for (let x = 0; x <= w * 2; x += 4) {
    const y = h / 2 + amp * Math.sin((x / w) * Math.PI * 2 * freq + phase);
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return pts.join(" ");
}
function beat(w = 600, h = 50) {
  const pts: string[] = [];
  for (let x = 0; x <= w * 2; x += 3) {
    const env = Math.cos((x / w) * Math.PI * 2 * 2);
    const y = h / 2 + 20 * env * Math.sin((x / w) * Math.PI * 2 * 24);
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return pts.join(" ");
}
const modes = [
  { name: "Focus", band: "Beta and low gamma", hz: "14–40 Hz", use: "Before deep work, a board meeting or a hard decision.", tone: "sky", level: 0.85 },
  { name: "Decompression", band: "Alpha", hz: "8–12 Hz", use: "After a long day, between meetings, to come down.", tone: "grass", level: 0.55 },
  { name: "Reset", band: "Theta", hz: "4–8 Hz", use: "To step out of a loop of thoughts and start again.", tone: "dream", level: 0.35 },
  { name: "High-stakes days", band: "Alpha into beta", hz: "10–18 Hz", use: "Calm first, then alert: before conflict, pitches or fatigue.", tone: "heart", level: 0.7 },
];
---

<section class:list={["au", `au--${variant}`]} data-au aria-labelledby="au-title">
  <div class="au-head">
    <p class="au-eyebrow">Shift state on demand</p>
    <h2 id="au-title">{heading}</h2>
    <p class="au-lede">Mood-specific tracks designed for focus, decompression, reset, and high-stakes days, made for you and used when it counts.</p>
  </div>

  <div class="au-scope" role="img" aria-label="Illustration: a slightly lower tone in the left ear and a slightly higher tone in the right ear combine into a slow beat the brain perceives">
    <div class="au-row">
      <span class="au-label">Left ear · 200 Hz</span>
      <svg viewBox="0 0 600 50" preserveAspectRatio="none" class="au-svg"><polyline class="au-w au-w--l" points={wave(10)} /></svg>
    </div>
    <div class="au-row">
      <span class="au-label">Right ear · 210 Hz</span>
      <svg viewBox="0 0 600 50" preserveAspectRatio="none" class="au-svg"><polyline class="au-w au-w--r" points={wave(11)} /></svg>
    </div>
    <div class="au-row au-row--beat">
      <span class="au-label">What the brain hears · a 10 Hz beat</span>
      <svg viewBox="0 0 600 50" preserveAspectRatio="none" class="au-svg"><polyline class="au-w au-w--b" points={beat()} /></svg>
    </div>
  </div>
  <p class="au-sample">Illustration. Frequencies slowed down so the shape is visible.</p>

  <ul class="au-modes">
    {modes.map((m, i) => (
      <li class:list={["au-mode", `au-mode--${m.tone}`]}>
        <p class="au-mode-name">{m.name}</p>
        <p class="au-mode-band">{m.band} · {m.hz}</p>
        <span class="au-meter" aria-hidden="true">
          {Array.from({ length: 12 }).map((_, k) => (
            <span style={`--k:${k};--lvl:${(m.level * (0.55 + 0.45 * Math.abs(Math.sin(k * 1.7 + i)))).toFixed(2)}`}></span>
          ))}
        </span>
        <p class="au-mode-use">{m.use}</p>
      </li>
    ))}
  </ul>

  {
    variant === "full" && (
      <div class="au-approach">
        <h3>A science-based approach</h3>
        <p>Every track is built on what research shows about sound, breath and the nervous system, and we keep checking it against your own data.</p>
        <ul>
          <li><strong>Brain rhythm.</strong> A 2019 meta-analysis of 22 studies found a medium, consistent effect of binaural beats on memory, attention, anxiety and pain. Listening before a task worked better than only during it, and longer listening helped more.</li>
          <li><strong>Breath pacing.</strong> Music whose rhythm slows gently below your own breathing rate slows breathing and lowers arousal (heart rate, skin response), with the strongest effect when it is personalised (MIT Media Lab, 2019).</li>
          <li><strong>Your body's data.</strong> With WHOOP, we can see whether a track actually moves your recovery, sleep and heart rate variability, and adjust it.</li>
        </ul>
        <p class="au-cite">Sources: Garcia-Argibay, Santed &amp; Reales, <em>Psychological Research</em> 2019; Leslie, Ghandeharioun, Zhou &amp; Picard, IEEE ACII 2019.</p>
      </div>

      <div class="au-science">
        <div>
          <h3>The science, plainly</h3>
          <p><strong>Binaural beats.</strong> When each ear hears a slightly different tone through headphones, say 200 Hz on the left and 210 Hz on the right, the brain perceives a third, slow beat of 10 Hz. That beat sits in the range of one of the brain's own rhythms: delta in deep sleep, theta in drowsy and reflective states, alpha in calm alertness, beta in active focus.</p>
          <p>The idea, called entrainment, is that listening nudges attention and arousal toward that state. Research is promising but mixed: reviews find small to moderate effects on anxiety, attention and memory, and results vary between studies and people.</p>
        </div>
        <div>
          <h3>How we build your tracks</h3>
          <ul>
            <li><strong>Modulation curves</strong>: each track moves gently from your current state toward the one you need, for example from beta down into alpha to decompress.</li>
            <li><strong>Your words</strong>: tracks can carry quiet spoken lines from your own work with your Wayfinder (subliminal audio). The evidence that messages below hearing change behaviour is weak, so we use them as a light anchor, not a promise.</li>
            <li><strong>Practical use</strong>: a few minutes with headphones before the moment that matters.</li>
          </ul>
          <p class="au-fine">Not a medical treatment. Do not listen while driving or operating machinery. If you live with epilepsy or a seizure condition, ask your doctor first.</p>
        </div>
      </div>
    )
  }

  {variant === "compact" && <p class="au-more"><a href="/state-shift-audio">How the audio works →</a></p>}
</section>

<style>
  .au {
    padding: 40px 36px;
    border: 1px solid #2a0b4f;
    border-radius: 24px;
    background: #2a0b4f;
    color: #fff;
  }

  .au-eyebrow {
    margin: 0 0 6px;
    color: #28dbb0;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .au h2 {
    margin: 0 0 10px;
    color: #fff;
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 900;
    line-height: 1.15;
  }

  .au-lede {
    max-width: 760px;
    margin: 0 0 24px;
    color: #f5f2ff;
    font-size: 18px;
    line-height: 1.6;
  }

  .au-scope {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid #58447f;
    border-radius: 18px;
    background: #1d033c;
  }

  .au-row {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
  }

  .au-label {
    color: #c2b7dd;
    font-size: 13px;
    font-weight: 700;
  }

  .au-row--beat .au-label { color: #28dbb0; }

  .au-svg {
    width: 100%;
    height: 50px;
    overflow: hidden;
  }

  .au-w {
    fill: none;
    stroke-width: 2.5;
    stroke-linejoin: round;
    animation: au-scroll 6s linear infinite;
    animation-play-state: paused;
  }

  .au-w--l { stroke: #c2b7dd; } /* no SKY on DREAM (Seb, 19 Nov 2026 14:55) */
  .au-w--r { stroke: #fd6b82; animation-duration: 5.7s; }
  .au-w--b { stroke: #28dbb0; stroke-width: 2; animation-duration: 8s; }

  .au.is-in .au-w { animation-play-state: running; }

  @keyframes au-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-600px); }
  }

  .au-sample {
    margin: 10px 0 22px;
    color: #c2b7dd;
    font-size: 13px;
    font-style: italic;
  }

  .au-modes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .au-mode {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border: 1px solid;
    border-radius: 18px;
    background: #fff;
    color: #2a0b4f;
  }

  .au-mode--sky { border-color: #477dfe; background: #f2f7ff; --au-c: #1d53ef; }
  .au-mode--grass { border-color: #01a684; background: #f3fffb; --au-c: #01a684; }
  .au-mode--dream { border-color: #8b7dae; background: #faf9ff; --au-c: #58447f; }
  .au-mode--heart { border-color: #fd6b82; background: #fff9fa; --au-c: #c10e46; }

  .au-mode-name { margin: 0; font-size: 19px; font-weight: 900; }
  .au-mode-band { margin: 0; color: var(--au-c); font-size: 14px; font-weight: 800; }
  .au-mode-use { margin: 0; font-size: 15px; line-height: 1.5; }

  .au-meter {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 34px;
    margin: 4px 0;
  }

  .au-meter span {
    flex: 1;
    height: calc(var(--lvl) * 100%);
    border-radius: 3px;
    background: var(--au-c);
    transform-origin: bottom;
    animation: au-eq 1.6s ease-in-out calc(var(--k) * -0.13s) infinite alternate;
    animation-play-state: paused;
  }

  .au.is-in .au-meter span { animation-play-state: running; }

  @keyframes au-eq {
    from { transform: scaleY(0.35); }
    to { transform: scaleY(1); }
  }

  .au-science {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 28px;
  }

  .au-science h3 { margin: 0 0 8px; color: #28dbb0; font-size: 20px; font-weight: 900; }
  .au-science p, .au-science li { color: #f5f2ff; font-size: 17px; line-height: 1.6; }
  .au-science ul { margin: 0; padding-left: 20px; }
  .au-science li { margin-bottom: 6px; }
  .au-fine { color: #c2b7dd !important; font-size: 14px !important; }

  .au-approach {
    margin-top: 28px;
    padding: 24px 26px;
    border: 1px solid #28dbb0;
    border-radius: 18px;
    background: #1d033c;
  }

  .au-approach h3 { margin: 0 0 8px; color: #28dbb0; font-size: 22px; font-weight: 900; }
  .au-approach p, .au-approach li { color: #f5f2ff; font-size: 17px; line-height: 1.6; }
  .au-approach ul { margin: 8px 0; padding-left: 20px; list-style: disc; }
  .au-approach li { display: list-item; margin-bottom: 6px; }
  .au-approach .au-cite { margin: 10px 0 0; color: #c2b7dd; font-size: 13px; }

  .au-more { margin: 18px 0 0; font-size: 17px; font-weight: 800; }
  .au-more a { color: #28dbb0; }

  @media (max-width: 1023px) {
    .au-modes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .au { padding: 26px 18px; }
    .au-row { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .au-modes, .au-science { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .au-w, .au-meter span { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-au]").forEach((el) => {
    if (!("IntersectionObserver" in window)) return el.classList.add("is-in");
    const io = new IntersectionObserver((entries) => {
      el.classList.toggle("is-in", entries.some((e) => e.isIntersecting));
    }, { threshold: 0.1 });
    io.observe(el);
  });
</script>
