    border: 1px solid #2a0b4f;
    border-radius: 24px;
    background: #2a0b4f;
    color: #fff;
  }

  .au-eyebrow {
    margin: 0 0 6px;
    color: #28dbb0;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .au h2 {
    margin: 0 0 10px;
    color: #fff;
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 900;
