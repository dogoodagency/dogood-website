    margin: 0 0 24px;
    color: #f5f2ff;
    font-size: 18px;
    line-height: 1.6;
  }

  .au-scope {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid #58447f;
    border-radius: 18px;
    background: #1d033c;
  }

  .au-row {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
  }

  .au-label {
    color: #c2b7dd;
    font-size: 13px;
    font-weight: 700;
  }

  .au-row--beat .au-label { color: #28dbb0; }

  .au-svg {
    width: 100%;
    height: 50px;
    overflow: hidden;
  }

  .au-w {
    fill: none;
    stroke-width: 2.5;
    stroke-linejoin: round;
    animation: au-scroll 6s linear infinite;
    animation-play-state: paused;
  }

  .au-w--l { stroke: #c2b7dd; } /* no SKY on DREAM (Seb, 19 Nov 2026 14:55) */
  .au-w--r { stroke: #fd6b82; animation-duration: 5.7s; }
  .au-w--b { stroke: #28dbb0; stroke-width: 2; animation-duration: 8s; }

  .au.is-in .au-w { animation-play-state: running; }

  @keyframes au-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-600px); }
  }

  .au-sample {
    margin: 10px 0 22px;
    color: #c2b7dd;
    font-size: 13px;
    font-style: italic;
  }

  .au-modes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .au-mode {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border: 1px solid;
    border-radius: 18px;
    background: #fff;
    color: #2a0b4f;
  }

  .au-mode--sky { border-color: #477dfe; background: #f2f7ff; --au-c: #1d53ef; }
  .au-mode--grass { border-color: #01a684; background: #f3fffb; --au-c: #01a684; }
  .au-mode--dream { border-color: #8b7dae; background: #faf9ff; --au-c: #58447f; }
  .au-mode--heart { border-color: #fd6b82; background: #fff9fa; --au-c: #c10e46; }

  .au-mode-name { margin: 0; font-size: 19px; font-weight: 900; }
  .au-mode-band { margin: 0; color: var(--au-c); font-size: 14px; font-weight: 800; }
  .au-mode-use { margin: 0; font-size: 15px; line-height: 1.5; }

  .au-meter {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 34px;
    margin: 4px 0;
  }

  .au-meter span {
    flex: 1;
    height: calc(var(--lvl) * 100%);
    border-radius: 3px;
    background: var(--au-c);
    transform-origin: bottom;
    animation: au-eq 1.6s ease-in-out calc(var(--k) * -0.13s) infinite alternate;
    animation-play-state: paused;
  }

  .au.is-in .au-meter span { animation-play-state: running; }

  @keyframes au-eq {
    from { transform: scaleY(0.35); }
    to { transform: scaleY(1); }
  }

  /* The science, plainly + How we build your tracks (redesigned 19 Nov 2026 18:52): one light panel, two
     columns, a small beat diagram, brainwave chips and three numbered layers. */
  .au-sci {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 28px;
    margin-top: 20px;
    padding: 30px 30px 22px;
    border: 1px solid #fff;
    border-radius: 20px;
    background: #fff;
    color: #2a0b4f;
  }

  .au-sci-col {
    padding: 22px 22px 24px;
    border: 1px solid #c2b7dd;
    border-radius: 18px;
    background: #faf9ff;
  }

  .au-sci-col + .au-sci-col {
    border-color: #73e7c4;
    background: #f3fffb;
  }

  .au-sci h3 { margin: 0 0 14px; color: #2a0b4f; font-size: 22px; font-weight: 900; }
  .au-sci p { margin: 0 0 12px; color: #2a0b4f; font-size: 16px; line-height: 1.6; }

  .au-beat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
  }

  .au-beat-ear {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
    border: 1px solid;
    border-radius: 12px;
    background: #fff;
  }

  .au-beat-ear span { font-size: 11px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .au-beat-ear strong { font-size: 18px; font-weight: 900; }
  .au-beat-ear--l { border-color: #8b7dae; color: #58447f; }
  .au-beat-ear--r { border-color: #fd6b82; color: #960434; }
  .au-beat-ear--b { border-color: #01a684; background: #05745b; color: #fff; }
  .au-beat-plus { color: #58447f; font-size: 22px; font-weight: 900; }

  .au-bands {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }

  .au-band {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 10px;
    border-radius: 12px;
    text-align: center;
  }

  .au-band strong { font-size: 15px; font-weight: 900; }
  .au-band span { font-size: 12px; line-height: 1.3; }
  .au-band--d { background: #2a0b4f; color: #fff; }
  .au-band--t { background: #58447f; color: #fff; }
  .au-band--a { background: #c2b7dd; color: #2a0b4f; }
  .au-band--b { background: #e9e3f7; color: #2a0b4f; }

  .au-layers {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: au-layer;
  }

  .au-layers li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px 14px 60px;
    border: 1px solid #73e7c4;
    border-radius: 14px;
    background: #fff;
    counter-increment: au-layer;
  }

  .au-layers li::before {
    content: counter(au-layer);
    position: absolute;
    top: 14px;
    left: 14px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #05745b;
    color: #fff;
    font-weight: 900;
  }

  .au-layers strong { font-size: 17px; font-weight: 900; }
  .au-layers span { font-size: 15px; line-height: 1.55; }

  .au-sci .au-sci-fine { grid-column: 1 / -1; margin: 0; color: #58447f !important; }

  @media (max-width: 860px) {
    .au-sci { grid-template-columns: minmax(0, 1fr); padding: 20px 16px; }
    .au-bands { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .au-fine { color: #c2b7dd !important; font-size: 14px !important; }

  .au-approach {
    margin-top: 28px;
    padding: 30px 30px 24px;
    border: 1px solid #fff;
    border-radius: 20px;
    background: #fff;
    color: #2a0b4f;
  }

  .au-approach-eyebrow {
    margin: 0 0 6px;
    color: #05745b;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .au-approach h3 { margin: 0 0 8px; color: #2a0b4f; font-size: clamp(24px, 2.4vw, 30px); font-weight: 900; }
  .au-approach-lede { max-width: 760px; margin: 0 0 22px; color: #2a0b4f; font-size: 18px; line-height: 1.6; }

  .au-approach-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .au-ac {
    position: relative;
    padding: 22px 22px 24px;
    border: 1px solid;
    border-radius: 18px;
  }

  .au-ac--grass { border-color: #73e7c4; background: #f3fffb; }
  .au-ac--heart { border-color: #feb5bc; background: #fff9fa; }
  .au-ac--dream { border-color: #c2b7dd; background: #faf9ff; }

  .au-ac-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 12px;
    border-radius: 50%;
    color: #fff;
    font-size: 16px;
    font-weight: 900;
  }

  .au-ac--grass .au-ac-n { background: #05745b; }
  .au-ac--heart .au-ac-n { background: #c10e46; }
  .au-ac--dream .au-ac-n { background: #58447f; }

  .au-ac-tag { margin: 0 0 6px; font-size: 13px; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }
  .au-ac--grass .au-ac-tag { color: #05745b; }
  .au-ac--heart .au-ac-tag { color: #960434; }
  .au-ac--dream .au-ac-tag { color: #58447f; }
  .au-ac-key { margin: 0 0 10px; color: #2a0b4f; font-size: 18px; font-weight: 800; line-height: 1.4; }
  .au-ac-more { margin: 0; color: #2a0b4f; font-size: 15px; line-height: 1.55; }
  .au-approach .au-cite { margin: 16px 0 0; color: #58447f; font-size: 13px; font-style: italic; }

  @media (max-width: 860px) {
    .au-approach-cards { grid-template-columns: minmax(0, 1fr); }
    .au-approach { padding: 22px 18px; }
  }

  .au-more { margin: 18px 0 0; font-size: 17px; font-weight: 800; }
  .au-more a { color: #28dbb0; }

  @media (max-width: 1023px) {
    .au-modes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .au { padding: 26px 18px; }
    .au-row { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .au-modes { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .au-w, .au-meter span { animation: none; }
  }

  /* 20 Nov 2026 (Seb): on The Build, the link to the audio page is a clear button; the intro has room before the
     waveform panel; in the narrower card the four modes sit two by two, so no word breaks. */
  .au-lede { margin-bottom: 28px !important; }
  .au--compact .au-more { margin: 28px 0 8px; padding-bottom: 32px; }
  .au--compact .au-more a { color: #2a0b4f; }
  .au--compact .au-modes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 600px) { .au--compact .au-modes { grid-template-columns: minmax(0, 1fr); } }
  /* 20 Nov 2026 23:29 (Seb, phones): the button is as wide as the text frames above it; less space under it. */
  @media (max-width: 599px) {
    /* three nested frames on phones: thinner padding at each level, the same on both sides */
    .au { padding: 24px 14px; }
    .au-sci { padding: 18px 12px; }
    .au-sci-col { padding: 18px 14px 20px; }
    .au-layers li { padding: 14px 16px; }
    .au-layers li::before { content: none; display: none; }
    /* 21 Nov 2026 01:19 (Seb): research cards take their number in the top-left corner (as on the Advisor
       Center referral steps); the 10 Hz box is as wide as the two ear boxes above it. */
    .au-ac { position: relative; overflow: hidden; padding: 54px 20px 22px; }
    .au-ac .au-ac-n { position: absolute; top: 0; left: 0; width: 40px; height: 40px; margin: 0; border-radius: 0 0 16px 0; }
    .au-beat { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto; }
    .au-beat-ear--b { grid-column: 1 / 4; }
    .au-modes { margin-top: 22px; }
    .au--compact .au-more { margin: 22px 0 0; padding-bottom: 0; }
    .au--compact .au-more a.btn-teal { display: flex; width: 100%; box-sizing: border-box; justify-content: center; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-au]").forEach((el) => {
    if (!("IntersectionObserver" in window)) return el.classList.add("is-in");
    const io = new IntersectionObserver((entries) => {
      el.classList.toggle("is-in", entries.some((e) => e.isIntersecting));
    }, { threshold: 0.1 });
    io.observe(el);
  });
</script>
