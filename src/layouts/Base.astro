---
import { lastModifiedFor } from "../lib/lastmod.mjs";
import "../styles/global.css";
import "../styles/site-rules.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { sebPersonId } from "../data/seb-person";
// Preloaded so text is drawn in Montserrat straight away instead of swapping (avoids layout shift).
import montserrat400 from "@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url";
import montserrat800 from "@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url";
import montserrat900 from "@fontsource/montserrat/files/montserrat-latin-900-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  meetFunnel?: boolean;
  footerStrip?: string;
  footerEdge?: string;
  ogTitle?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  /** No canonical link (e.g. the 404 page, which has no address of its own). */
  noCanonical?: boolean;
}

const title =
  Astro.props.title ?? "A 30-Day Engagement for Life After Exit | DoGood Agency";
const description =
  Astro.props.description ??
  "You built the company and got out, but it doesn't feel how you expected. Start with a private 30-day engagement for founders navigating life after exit.";
const canonical = Astro.props.canonical ?? "https://www.dogoodagency.co/";
const meetFunnel = Astro.props.meetFunnel ?? false;
const footerStrip = Astro.props.footerStrip;
const footerEdge = Astro.props.footerEdge;
const bodyStyle = [
  footerStrip ? `--footer-strip:${footerStrip}` : "",
  footerEdge ? `--footer-edge:${footerEdge}` : "",
]
  .filter(Boolean)
  .join(";");
// Link previews (WhatsApp, LinkedIn, Slack) show og:title, so default it to the page title.
const ogTitle = Astro.props.ogTitle ?? title;
const ogDescription = Astro.props.description
  ? description
  : "A private 30-day engagement for founders navigating life after exit. Start with Stage 1 of the Founder Reclamation Partnership. 5 founders a month.";
const twitterDescription = ogDescription;
const ogImage = new URL(Astro.props.ogImage ?? "/og.jpg", canonical).href;
const ogType = Astro.props.ogType ?? "website";
// Pre-launch default. "nofollow" removed on preview 6 so the free Screaming Frog can crawl;
// at launch change this to "index, follow" (see CHANGELOG.md, launch checklist).
const robots = Astro.props.robots ?? "noindex, nofollow";

// The website itself (homepage only), so search engines and AI tools tie the site name to DoGood Agency.
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.dogoodagency.co/#website",
  url: "https://www.dogoodagency.co/",
  name: "DoGood Agency",
  alternateName: "DoGood",
  inLanguage: "en",
  publisher: { "@id": "https://www.dogoodagency.co/#organization" },
};

// "Last updated" for AI search and Google (20 Nov 2026): a WebPage record with dateModified, taken from the
// date the page's source file last changed in git. Articles have their own Article record, so they skip this.
const pageModified = ogType === "article" ? undefined : lastModifiedFor(Astro.url.pathname.replace(/\.html$/, ""));
const webPage = pageModified && !Astro.props.noCanonical
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": "https://www.dogoodagency.co/#website" },
      publisher: { "@id": "https://www.dogoodagency.co/#organization" },
      dateModified: pageModified,
    }
  : undefined;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.dogoodagency.co/#organization",
  name: "DoGood Agency",
  legalName: "DoGood Agency LLC",
  url: "https://www.dogoodagency.co/",
  logo: "https://www.dogoodagency.co/logo.svg",
  description: "1:1 coaching for founders before and after an exit.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "30 N Gould St Ste N",
    addressLocality: "Sheridan",
    addressRegion: "WY",
    postalCode: "82801",
    addressCountry: "US",
  },
  founder: { "@id": sebPersonId },
  // DoGood's own profiles only (Seb, 20 Nov 2026). Seb's personal LinkedIn sits on his Person record
  // (src/data/seb-person.ts); Upwork and the IODA history page were removed. The podcast's Apple, Spotify and
  // Amazon Music links are on the PodcastSeries data on /dogood-insider.
  sameAs: [
    "https://www.linkedin.com/company/dogood-agency",
    "https://www.youtube.com/@RawStoriesOfDoGoodCultures",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={montserrat400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserrat800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserrat900} as="font" type="font/woff2" crossorigin />
    <!--
      Preview only. At launch, delete this robots meta tag and update
      public/robots.txt so the site can be indexed.
    -->
    <meta name="robots" content={robots} />
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/cd7b3fec7b1066719107b4a2189a47ad/script.js"
    ></script>
    <script data-cookieyes="cookieyes-necessary" src="/tawk-loader.js" defer></script>
    <!-- GA4 (20 Nov 2026): runs only after analytics consent (CookieYes) and only on the live domain. -->
    <script type="text/plain" data-cookieyes="cookieyes-analytics" src="/ga.js"></script>
    <!-- Microsoft Clarity (20 Nov 2026): runs only after analytics consent (CookieYes), live domain only. -->
    <script type="text/plain" data-cookieyes="cookieyes-analytics" src="/clarity.js"></script>
    <!-- LinkedIn Insight Tag (20 Nov 2026): runs only after advertisement consent (CookieYes), live domain only. -->
    <script type="text/plain" data-cookieyes="cookieyes-advertisement" src="/li-insight.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!Astro.props.noCanonical && <link rel="canonical" href={canonical} />}
    <!-- DoGood G favicon (Seb, 20 Nov 2026, 03:04): the G fills the whole square on a transparent background.
         20 Nov 03:09 (Seb): one favicon everywhere, the light version (purple G body), as SVG, .ico and a 512px PNG. Apple home-screen icon: purple square (iOS rounds the corners itself). Manifest
         icons: round purple app icon. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2A0B4F" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    {!Astro.props.noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="DoGood Agency" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />}
    {webPage && <script is:inline type="application/ld+json" set:html={JSON.stringify(webPage)} />}
    <slot name="head" />
  </head>
  <body style={bodyStyle || undefined}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-3 focus:text-ink"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer meetFunnel={meetFunnel} edge={footerEdge} />
    <script>
      /* Moving testimonial walls (TestimonialWall and /stories): every column drifts at the same speed,
         38px a second, whatever its length (Seb, 19 Nov 2026). */
      const WALL_SPEED = 38;
      const setWallSpeed = () => {
        document.querySelectorAll<HTMLElement>(".tw-track, .st-track").forEach((track) => {
          const loop = track.scrollHeight / 2;
          // The middle lane runs the other way, so next to its neighbours it reads as faster at the same
          // speed. It moves at 70% so all three lanes look the same (Seb, 19 Nov 2026 14:55).
          const col = track.parentElement;
          const middle = !!col && col.parentElement?.children.length === 3 && col === col.parentElement.children[1];
          const speed = middle ? WALL_SPEED * 0.7 : WALL_SPEED;
          if (loop > 0) track.style.animationDuration = `${(loop / speed).toFixed(1)}s`;
        });
      };
      if (document.readyState === "complete") setWallSpeed();
      else window.addEventListener("load", setWallSpeed);
      window.addEventListener("resize", () => window.requestAnimationFrame(setWallSpeed));
      const thankYou = "Thank you! You have successfully joined our subscriber list.";

      document.querySelectorAll("form.js-subscribe").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const button = form.querySelector("button[type='submit']");
          const status = form.querySelector("[data-status]");
          if (!(button instanceof HTMLButtonElement)) return;
          button.disabled = true;
          button.textContent = "Loading...";
          try {
            const response = await fetch(form.action, {
              method: "POST",
              body: new FormData(form),
            });
            const result = await response.json();
            if (result.success) {
              form.querySelectorAll("input, button").forEach((field) => {
                if (field instanceof HTMLElement && field !== status) field.hidden = true;
              });
              if (status) {
                status.hidden = false;
                status.textContent = thankYou;
              }
              return;
            }
            const message = result?.errors?.fields?.email?.[0];
            if (status && message) {
              status.hidden = false;
              status.textContent = message;
            }
            button.disabled = false;
            button.textContent = "Subscribe";
          } catch {
            form.submit();
          }
        });
      });

      const dialog = document.querySelector("#optin");
      document.querySelectorAll("[data-open-optin]").forEach((button) => {
        button.addEventListener("click", () => {
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });
      document.querySelectorAll("[data-close-optin]").forEach((button) => {
        button.addEventListener("click", () => {
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      const captionText = new Set([
        "We protect our founders' identities",
        "Limited to five new founders a month",
        "5 minutes · Results immediate · Confirms fit before you apply",
        "Private · 5 minutes · Immediate results",
        "Instant · 5 minutes · Confidential · Immediate results",
        "Founder-focused · Not therapy, not medical advice, not psychological services",
        "Stage 1 (30 days) · Stage 2 invite-only",
        "Stage 1 (30 days) · Week 3 decision on Stage 2",
        "You don't pick a Wayfinder · We match for fit first.",
        "Confidential • 2 spots per month",
        "We protect our delivery quality: Ask about Expedited Start if urgent (FRP can begin within 7 days)",
        "We won't send spam. One email every two weeks, and you can unsubscribe at any time.",
        "For founders + select founder-like executives",
        "geo-travel map, fit-first matching process",
      ]);
      const norm = (value) =>
        value.replace(/\s+/g, " ").trim().replace(/[’‘]/g, "'");
      const takeCaptions = (start) => {
        const nodes = [];
        let el = start;
        while (el instanceof HTMLParagraphElement && captionText.has(norm(el.textContent)) && !el.querySelector("a")) {
          nodes.push(el);
          el = el.nextElementSibling;
        }
        return nodes;
      };
      document.querySelectorAll(".page-body").forEach((body) => {
        body.querySelectorAll("p").forEach((p) => {
          if (norm(p.textContent) !== "Case Study" || p.querySelector("a")) return;
          p.classList.add("case-label");
          const head = p.nextElementSibling;
          if (head instanceof HTMLParagraphElement && !head.querySelector("a")) {
            head.classList.add("case-headline");
          }
        });
        body.querySelectorAll("a.btn-apply, a.btn-teal, a.btn-case, button.btn-apply, button.btn-teal, button.btn-case").forEach((btn) => {
          if (btn.closest(".btn-with-caption")) return;
          const parent = btn.parentElement;
          const after = parent instanceof HTMLParagraphElement || parent instanceof HTMLFormElement
            ? parent.nextElementSibling
            : btn.nextElementSibling;
          const captions = takeCaptions(after);
          if (!captions.length) return;
          const wrap = document.createElement("div");
          wrap.className = "btn-with-caption";
          if (parent instanceof HTMLParagraphElement) {
            parent.before(wrap);
            wrap.append(parent, ...captions);
          } else {
            btn.before(wrap);
            wrap.append(btn, ...captions);
          }
          captions.forEach((caption) => caption.classList.add("btn-caption"));
        });
      });
    </script>
  </body>
</html>
