---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  hideOptin?: boolean;
  meetFunnel?: boolean;
  footerStrip?: string;
}

const title =
  Astro.props.title ?? "DoGood Founders | A 30-Day Engagement for Life After Exit";
const description =
  Astro.props.description ??
  "You built the company and got out, but it doesn't feel how you expected. Start with a private 30-day engagement for founders navigating life after exit.";
const canonical = Astro.props.canonical ?? "https://www.dogoodagency.co/";
const hideOptin = Astro.props.hideOptin ?? false;
const meetFunnel = Astro.props.meetFunnel ?? false;
const footerStrip = Astro.props.footerStrip;
const ogTitle = "DoGood Founders";
const ogDescription = Astro.props.description
  ? description
  : "A private 30-day engagement for founders navigating life after exit. Start with Stage 1 of the Founder Reclamation Partnership. 5 founders a month.";
const twitterDescription = ogDescription;
const ogImage = new URL("/og.jpg", canonical).href;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "DoGood Agency LLC",
  url: canonical,
  logo: new URL("/logo.svg", canonical).href,
  description,
  address: {
    "@type": "PostalAddress",
    streetAddress: "30 N Gould St Ste N",
    addressLocality: "Sheridan",
    addressRegion: "WY",
    postalCode: "82801",
    addressCountry: "US",
  },
  sameAs: [
    "https://www.linkedin.com/in/sebwichmann/",
    "http://www.upwork.com/agencies/dogoodagency",
    "https://www.iodanet.org/iodas-history/",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Preview only. At launch, delete this robots meta tag and update
      public/robots.txt so the site can be indexed.
    -->
    <meta name="robots" content="noindex, nofollow" />
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/cd7b3fec7b1066719107b4a2189a47ad/script.js"
    ></script>
    <script src="/tawk-loader.js" defer></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={ogTitle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body style={footerStrip ? `--footer-strip:${footerStrip}` : undefined}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-3 focus:text-ink"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer hideOptin={hideOptin} meetFunnel={meetFunnel} />
    <script>
      const thankYou = "Thank you! You have successfully joined our subscriber list.";

      document.querySelectorAll("form.js-subscribe").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const button = form.querySelector("button[type='submit']");
          const status = form.querySelector("[data-status]");
          if (!(button instanceof HTMLButtonElement)) return;
          button.disabled = true;
          button.textContent = "Loading...";
          try {
            const response = await fetch(form.action, {
              method: "POST",
              body: new FormData(form),
            });
            const result = await response.json();
            if (result.success) {
              form.querySelectorAll("input, button").forEach((field) => {
                if (field instanceof HTMLElement && field !== status) field.hidden = true;
              });
              if (status) {
                status.hidden = false;
                status.textContent = thankYou;
              }
              return;
            }
            const message = result?.errors?.fields?.email?.[0];
            if (status && message) {
              status.hidden = false;
              status.textContent = message;
            }
            button.disabled = false;
            button.textContent = "Subscribe";
          } catch {
            form.submit();
          }
        });
      });

      const dialog = document.querySelector("#optin");
      document.querySelectorAll("[data-open-optin]").forEach((button) => {
        button.addEventListener("click", () => {
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });
      document.querySelectorAll("[data-close-optin]").forEach((button) => {
        button.addEventListener("click", () => {
          if (dialog instanceof HTMLDialogElement) dialog.close();
        });
      });

      const captionText = new Set([
        "We protect our founders' identities",
        "Limited to five new founders a month",
        "5 minutes · Results immediate · Confirms fit before you apply",
        "Private · 5 minutes · Immediate results",
        "Instant · 5 minutes · Confidential · Immediate results",
        "Founder-focused · Not therapy, not medical advice, not psychological services",
        "Stage 1 (30 days) · Stage 2 invite-only",
        "Stage 1 (30 days) · Week 3 decision on Stage 2",
        "You don't pick a Wayfinder · We match for fit first.",
        "Confidential • 2 spots per month",
        "We protect our delivery quality: Ask about Expedited Start if urgent (FRP can begin within 7 days)",
        "We won't send spam. One email every two weeks, and you can unsubscribe at any time.",
        "For founders + select founder-like executives",
        "geo-travel map, fit-first matching process",
      ]);
      const norm = (value) =>
        value.replace(/\s+/g, " ").trim().replace(/[’‘]/g, "'");
      const takeCaptions = (start) => {
        const nodes = [];
        let el = start;
        while (el instanceof HTMLParagraphElement && captionText.has(norm(el.textContent)) && !el.querySelector("a")) {
          nodes.push(el);
          el = el.nextElementSibling;
        }
        return nodes;
      };
      document.querySelectorAll(".page-body").forEach((body) => {
        body.querySelectorAll("p").forEach((p) => {
          if (norm(p.textContent) !== "Case Study" || p.querySelector("a")) return;
          p.classList.add("case-label");
          const head = p.nextElementSibling;
          if (head instanceof HTMLParagraphElement && !head.querySelector("a")) {
            head.classList.add("case-headline");
          }
        });
        body.querySelectorAll("a.btn-apply, a.btn-teal, a.btn-case, button.btn-apply, button.btn-teal, button.btn-case").forEach((btn) => {
          if (btn.closest(".btn-with-caption")) return;
          const parent = btn.parentElement;
          const after = parent instanceof HTMLParagraphElement || parent instanceof HTMLFormElement
            ? parent.nextElementSibling
            : btn.nextElementSibling;
          const captions = takeCaptions(after);
          if (!captions.length) return;
          const wrap = document.createElement("div");
          wrap.className = "btn-with-caption";
          if (parent instanceof HTMLParagraphElement) {
            parent.before(wrap);
            wrap.append(parent, ...captions);
          } else {
            btn.before(wrap);
            wrap.append(btn, ...captions);
          }
          captions.forEach((caption) => caption.classList.add("btn-caption"));
        });
      });
    </script>
  </body>
</html>
